// ===== STATE =====
let selectedTeam = [null, null, null];
let currentModal = null;
let currentGenFilter = 'all';
let battleState = null;
let SERVER = 'http://127.0.0.1:8765';
let serverOnline = false;
let turnNumber = 1;
let bgmMuted = false;
let bgmVolume = 0.5;
let selectedPresetName = null;

// ===== MULTIPLAYER BATTLE STATE =====
const multiState = {
  active: false,        // 멀티플레이 배틀 중인지
  role: null,           // 'player1' or 'player2'
  roomCode: null,
  oppNickname: '상대',
  waitingForOpponent: false,
  seed: 0
};

// ===== GAME SETTINGS (localStorage 저장) =====
const _DEFAULT_SETTINGS = { battleSpeed:1, showAnimations:true, showTypeHints:true, nickname:'트레이너', bgmVolume:0.5, bgmMuted:false };
const gameSettings = Object.assign({}, _DEFAULT_SETTINGS);

function loadSettings() {
  try {
    const saved = localStorage.getItem('pokemonBattleSettings');
    if (saved) {
      const s = JSON.parse(saved);
      Object.assign(gameSettings, s);
      bgmVolume = gameSettings.bgmVolume;
      bgmMuted = gameSettings.bgmMuted;
    }
  } catch(e) { console.warn('[Settings] Load failed:', e); }
}

function saveSettings() {
  try {
    gameSettings.bgmVolume = bgmVolume;
    gameSettings.bgmMuted = bgmMuted;
    localStorage.setItem('pokemonBattleSettings', JSON.stringify(gameSettings));
  } catch(e) { console.warn('[Settings] Save failed:', e); }
}

// 앱 시작 시 설정 불러오기
loadSettings();

// ===== SCREEN NAVIGATION =====
function hideAllScreens() {
  const cts = document.getElementById('clickToStart'); if(cts) cts.style.display='none';
  document.getElementById('titleScreen').style.display = 'none';
  document.getElementById('settingsScreen').classList.remove('active');
  document.getElementById('multiScreen').classList.remove('active');
  document.getElementById('teamSelectScreen').style.display = 'none';
  document.getElementById('battleScreen').classList.remove('active');
}
function goSinglePlay() { hideAllScreens(); document.getElementById('teamSelectScreen').style.display=''; playBgm('main'); checkServer(); }
function goMultiplayer() {
  hideAllScreens();
  document.getElementById('multiScreen').classList.add('active');
  const isLocal = location.hostname === '127.0.0.1' || location.hostname === 'localhost';
  
  if (!isLocal) {
    // 클라우드/외부 접속 → 현재 호스트로 자동 WS 연결
    const wsProto = location.protocol === 'https:' ? 'wss://' : 'ws://';
    connectToWs(wsProto + location.host + '/ws/multi');
    document.getElementById('multiServerAddr').value = location.origin;
  } else {
    // 로컬 → 로컬 WS 자동 연결
    connectToWs('ws://127.0.0.1:8765/ws/multi');
    document.getElementById('multiServerAddr').value = 'http://127.0.0.1:8765';
  }
}
function goSettings() {
  hideAllScreens(); document.getElementById('settingsScreen').classList.add('active');
  document.getElementById('settingsBgmVol').value = bgmVolume;
  document.getElementById('bgmVolText').textContent = Math.round(bgmVolume*100)+'%';
  document.getElementById('settingsMuteToggle').className = 'settings-toggle'+(bgmMuted?'':' on');
  document.getElementById('settingsAnimToggle').className = 'settings-toggle'+(gameSettings.showAnimations?' on':'');
  document.getElementById('settingsHintToggle').className = 'settings-toggle'+(gameSettings.showTypeHints?' on':'');
  document.getElementById('settingsNickname').value = gameSettings.nickname;
  document.getElementById('settingsBattleSpeed').value = gameSettings.battleSpeed;
}
function goTitleFromSettings() { gameSettings.nickname=document.getElementById('settingsNickname').value||'트레이너'; saveSettings(); hideAllScreens(); document.getElementById('titleScreen').style.display='flex'; }
function goTitleFromMulti() { hideAllScreens(); document.getElementById('titleScreen').style.display='flex'; }
function goBackToTitle() {
  hideAllScreens();
  document.getElementById('titleScreen').style.display='flex';
  // Restore start button for single play
  const btn = document.getElementById('startBattleBtn');
  if (btn) { btn.textContent = '▶ 배틀 시작!'; btn.onclick = startBattle; }
}
function goQuit() { document.getElementById('customDialog').classList.add('show'); }
function toggleSettingsMute() { bgmMuted=!bgmMuted; document.getElementById('settingsMuteToggle').className='settings-toggle'+(bgmMuted?'':' on'); ['muteBtn','battleMuteBtn'].forEach(id=>{const e=document.getElementById(id);if(e)e.textContent=bgmMuted?'🔇':'🔊';}); if(bgmMuted)Object.values(bgms).forEach(a=>a.pause()); else playBgm(_currentBgm||'main'); saveSettings(); }
function toggleSettingsAnim() { gameSettings.showAnimations=!gameSettings.showAnimations; document.getElementById('settingsAnimToggle').className='settings-toggle'+(gameSettings.showAnimations?' on':''); saveSettings(); }
function toggleSettingsHint() { gameSettings.showTypeHints=!gameSettings.showTypeHints; document.getElementById('settingsHintToggle').className='settings-toggle'+(gameSettings.showTypeHints?' on':''); saveSettings(); }

// ===== MULTIPLAYER =====
let multiWs = null;
let multiRooms = [];
let _ngrokUrl = null;

async function onCreateRoom() {
  const btn = document.getElementById('createRoomBtn');
  const st = document.getElementById('multiMainStatus');
  btn.disabled = true;
  const isLocal = location.hostname === '127.0.0.1' || location.hostname === 'localhost';

  // 로컬에서 실행 중이면 ngrok 터널 자동 생성
  if (isLocal && !_ngrokUrl) {
    st.innerHTML = '<span style="color:#fbbf24">⏳ 외부 접속 URL 생성 중... (최초 1회, ~10초)</span>';
    try {
      const r = await fetch(SERVER + '/api/ngrok/start', {method:'POST'});
      const d = await r.json();
      if (d.url) {
        _ngrokUrl = d.url;
        document.getElementById('ngrokUrl').value = d.url;
        document.getElementById('ngrokUrlBox').style.display = '';
        st.innerHTML = '<span style="color:#22c55e">✅ URL 생성! 친구에게 공유하세요.</span>';
      } else {
        st.innerHTML = '<span style="color:#ef4444">❌ ' + (d.error||'URL 생성 실패') + '</span>';
        btn.disabled = false; return;
      }
    } catch(e) {
      st.innerHTML = '<span style="color:#ef4444">❌ 서버 통신 실패</span>';
      btn.disabled = false; return;
    }
  }

  // WS 연결 확인/대기
  if (!multiWs || multiWs.readyState !== 1) {
    if (isLocal) connectToWs('ws://127.0.0.1:8765/ws/multi');
    await new Promise(r => setTimeout(r, 1500));
  }
  if (!multiWs || multiWs.readyState !== 1) {
    st.innerHTML = '<span style="color:#ef4444">❌ 서버 연결 실패</span>';
    btn.disabled = false; return;
  }

  multiWs.send(JSON.stringify({
    type:'create_room',
    name: document.getElementById('multiRoomTitle').value || '포켓몬 배틀',
    visibility: document.querySelector('input[name=roomVisibility]:checked').value,
    password: document.getElementById('multiRoomPw').value,
    format: document.querySelector('input[name=battleFormat]:checked').value,
    nickname: gameSettings.nickname
  }));
  btn.disabled = false;
}

function copyNgrokUrl() {
  const el = document.getElementById('ngrokUrl');
  el.select(); document.execCommand('copy');
  const st = document.getElementById('multiMainStatus');
  st.innerHTML = '<span style="color:#22c55e">📋 URL 복사 완료!</span>';
  setTimeout(() => { st.textContent = '친구에게 URL을 공유하세요.'; }, 2000);
}

function guestConnect() {
  let addr = document.getElementById('multiServerAddr').value.trim();
  if (!addr) { document.getElementById('guestConnStatus').innerHTML='<span style="color:#ef4444">주소를 입력하세요</span>'; return; }
  let wsUrl;
  if (addr.startsWith('https://')) wsUrl = addr.replace('https://','wss://') + '/ws/multi';
  else if (addr.startsWith('http://')) wsUrl = addr.replace('http://','ws://') + '/ws/multi';
  else if (addr.startsWith('ws')) wsUrl = addr;
  else wsUrl = 'wss://' + addr + '/ws/multi';
  connectToWs(wsUrl);
}

function connectToWs(wsUrl) {
  const st = document.getElementById('guestConnStatus');
  if (st) st.innerHTML = '<span style="color:#fbbf24">⏳ 접속 중...</span>';
  try {
    if (multiWs) multiWs.close();
    multiWs = new WebSocket(wsUrl);
    multiWs.onopen = () => { if(st) st.innerHTML='<span style="color:#22c55e">✅ 서버 연결됨!</span>'; refreshRooms(); };
    multiWs.onmessage = (e) => { try{handleMultiMsg(JSON.parse(e.data));}catch(err){} };
    multiWs.onclose = () => { if(st) st.innerHTML='<span style="color:#ef4444">❌ 연결 끊김</span>'; multiWs=null; };
    multiWs.onerror = () => { if(st) st.innerHTML='<span style="color:#ef4444">❌ 접속 실패</span>'; };
  } catch(e) { if(st) st.innerHTML='<span style="color:#ef4444">❌ '+e.message+'</span>'; }
}

function handleMultiMsg(d) {
  const st = document.getElementById('multiMainStatus');
  if (d.type==='room_list') { multiRooms=d.rooms||[]; renderRoomList(); }
  else if (d.type==='room_created') {
    if(st) st.innerHTML='<span style="color:#22c55e">🏠 방 생성!</span> 코드: <b>'+d.code+'</b> — 상대 대기 중...';
    multiState.roomCode = d.code;
    refreshRooms();
  }
  else if (d.type==='room_joined') {
    if(st) st.innerHTML='<span style="color:#22c55e">🎮 입장!</span> '+d.room_name;
    multiState.roomCode = d.code;
  }
  else if (d.type==='opponent_joined') {
    if(st) st.innerHTML='<span style="color:#22c55e">⚔️ '+d.nickname+'님 입장!</span>';
  }
  else if (d.type==='team_select') {
    // 양쪽 다 입장 → 팀 선택 화면으로
    if(st) st.innerHTML='<span style="color:#fbbf24">📋 팀을 선택하세요!</span>';
    multiState.active = true;
    setTimeout(() => goMultiTeamSelect(), 500);
  }
  else if (d.type==='opponent_team_ready') {
    if(st) st.innerHTML='<span style="color:#22c55e">✅ '+d.nickname+'님 팀 선택 완료! 기다리는 중...</span>';
  }
  else if (d.type==='battle_start') {
    // 양쪽 팀 준비 완료 → 배틀 시작
    multiState.role = d.you_are;
    multiState.oppNickname = d.opp_nickname;
    multiState.seed = d.seed || 0;
    startMultiBattle(d.your_team, d.opp_team, d.opp_nickname);
  }
  else if (d.type==='action_received') {
    // 내 행동 접수됨, 상대 대기
    multiState.waitingForOpponent = true;
    addLog('⏳ 상대의 행동을 기다리는 중...', 'system');
  }
  else if (d.type==='turn_result') {
    // 양쪽 행동 도착 → 턴 실행
    multiState.waitingForOpponent = false;
    executeMultiTurn(d.actions, d.seed);
  }
  else if (d.type==='battle_ended') {
    if(st) st.innerHTML='<span style="color:#fbbf24">배틀 종료: '+d.message+'</span>';
  }
  else if (d.type==='opponent_left') {
    if(st) st.innerHTML='<span style="color:#ef4444">⚠️ 상대가 나갔습니다.</span>';
    if (multiState.active && battleState) {
      addLog('⚠️ 상대가 연결을 끊었습니다!', 'highlight');
      showResult(true); // 상대 이탈 → 승리
    }
    refreshRooms();
  }
  else if (d.type==='opponent_forced_switch') {
    if (battleState) addLog('상대가 ' + d.pokemon_name + '을(를) 내보냈다!', 'highlight');
  }
  else if (d.type==='error') { if(st) st.innerHTML='<span style="color:#ef4444">⚠️ '+d.message+'</span>'; }
}

function refreshRooms() {
  if (!multiWs||multiWs.readyState!==1) { document.getElementById('multiRoomList').innerHTML='<div class="multi-status">서버 미연결</div>'; return; }
  multiWs.send(JSON.stringify({type:'list_rooms'}));
}
function filterRooms() { renderRoomList(); }
function renderRoomList() {
  const el=document.getElementById('multiRoomList');
  const s=(document.getElementById('multiSearchRoom')?.value||'').toLowerCase();
  const f=multiRooms.filter(r=>!s||r.name.toLowerCase().includes(s)||(r.code||'').includes(s));
  if (!f.length) { el.innerHTML='<div class="multi-status">열린 방이 없습니다</div>'; return; }
  el.innerHTML=f.map(r=>{
    const b=r.players>=r.max_players?'full':r.visibility==='private'?'locked':'open';
    const bt=b==='full'?'만원':b==='locked'?'🔒':'공개';
    return '<div class="multi-room-item" onclick="joinRoom(\''+r.code+'\')"><div><div class="room-name">'+r.name+'</div><div class="room-info">'+(r.format==='double'?'더블':'싱글')+' · '+r.players+'/'+r.max_players+'명 · '+r.host+'</div></div><span class="room-badge '+b+'">'+bt+'</span></div>';
  }).join('');
}
function joinRoom(code) {
  if (!multiWs||multiWs.readyState!==1) return;
  const room = multiRooms.find(r => r.code === code);
  if (room && room.visibility === 'private') {
    const pw = prompt('비밀번호:') || '';
    multiWs.send(JSON.stringify({type:'join_room',code,password:pw,nickname:gameSettings.nickname}));
  } else {
    multiWs.send(JSON.stringify({type:'join_room',code,password:'',nickname:gameSettings.nickname}));
  }
}

// ===== BGM =====
const bgms = {
  main: document.getElementById('bgmMain'),
  battle: document.getElementById('bgmBattle'),
  win: document.getElementById('bgmWin'),
  lose: document.getElementById('bgmLose')
};

// Set src with cache-busting timestamp (BGM 교체 시 즉시 반영)
const _cacheBust = '?t=' + Date.now();
bgms.main.src = 'main_bgm.mp3' + _cacheBust;
bgms.battle.src = 'battle_bgm.mp3' + _cacheBust;
bgms.win.src = 'win_bgm.mp3' + _cacheBust;
bgms.lose.src = 'lose_bgm.mp3' + _cacheBust;

// Log audio status for debugging
Object.entries(bgms).forEach(([key, audio]) => {
  audio.volume = bgmVolume;
  audio.addEventListener('error', (e) => {
    const code = audio.error ? audio.error.code : '?';
    const msg = {1:'ABORTED',2:'NETWORK',3:'DECODE',4:'SRC_NOT_SUPPORTED'}[code] || 'UNKNOWN';
    console.error('[BGM] Error loading ' + key + ': ' + msg + ' (code:' + code + ') src:' + audio.src);
  });
  audio.addEventListener('canplaythrough', () => {
    console.log('[BGM] Ready: ' + key + ' src:' + audio.src);
  });
});

let _currentBgm = 'main';

function playBgm(type) {
  _currentBgm = type;
  Object.values(bgms).forEach(a => { a.pause(); a.currentTime = 0; });
  if (bgmMuted || !bgms[type]) return;
  const audio = bgms[type];
  audio.volume = bgmVolume;
  const p = audio.play();
  if (p) p.catch(e => console.warn('[BGM] play(' + type + ') blocked:', e.message));
}

// Autoplay retry - keeps trying every 500ms until main BGM plays
let _retryId = setInterval(() => {
  const a = bgms[_currentBgm];
  if (!a || bgmMuted) return;
  if (!a.paused && a.currentTime > 0) { clearInterval(_retryId); return; }
  a.volume = bgmVolume;
  a.play().catch(() => {});
}, 500);

// Click-to-Start: 오디오 잠금 해제 + 타이틀 화면 표시
function unlockAudioAndStart() {
  // AudioContext unlock
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    if (ctx.state === 'suspended') ctx.resume();
  } catch(e) {}
  
  // Hide click-to-start overlay
  const overlay = document.getElementById('clickToStart');
  if (overlay) overlay.style.display = 'none';
  
  // Show title screen
  document.getElementById('titleScreen').style.display = 'flex';
  
  // Start BGM
  playBgm('main');
}

function setVolume(v) {
  bgmVolume = parseFloat(v);
  Object.values(bgms).forEach(a => a.volume = bgmVolume);
  saveSettings();
}
function toggleMute() {
  bgmMuted = !bgmMuted;
  const icon = bgmMuted ? '🔇' : '🔊';
  ['muteBtn','battleMuteBtn'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.textContent = icon;
  });
  if (bgmMuted) { Object.values(bgms).forEach(a => a.pause()); }
  else { playBgm(_currentBgm || 'main'); }
  saveSettings();
}

// ===== SERVER CHECK =====
async function checkServer() {
  // Auto-detect server URL based on where HTML was loaded from
  const isLocal = location.hostname === '127.0.0.1' || location.hostname === 'localhost';
  const serverUrl = isLocal ? SERVER : location.origin;
  
  const updateBadges = (cls, text) => {
    ['serverBadge', 'teamServerBadge'].forEach(id => {
      const el = document.getElementById(id);
      if (el) { el.className = 'server-badge ' + cls; el.textContent = text; }
    });
  };
  try {
    const r = await Promise.race([
      fetch(serverUrl + '/api/status'),
      new Promise((_,rej) => setTimeout(() => rej(new Error('timeout')), 2000))
    ]);
    if (!r.ok) throw new Error('bad status');
    const d = await r.json();
    serverOnline = true;
    if (d.model === 'loaded') {
      updateBadges('online', '● PPO AI 연결됨');
    } else {
      updateBadges('online', '● 서버 연결됨 (내장 AI)');
    }
  } catch(e) {
    serverOnline = false;
    updateBadges('online', '● 내장 AI (싱글플레이 가능)');
  }
}
setTimeout(checkServer, 1000);

// ===== GEN / GRID =====
function getGen(id) {
  for (const [g, [lo, hi]] of Object.entries(GEN_RANGES)) {
    if (id >= lo && id <= hi) return parseInt(g);
  }
  return 1;
}

function filterGen(gen, btn) {
  currentGenFilter = gen;
  document.querySelectorAll('.gen-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderGrid();
}

function renderGrid() {
  const search = document.getElementById('searchInput').value.toLowerCase().trim();
  const grid = document.getElementById('pokeGrid');
  grid.innerHTML = '';
  const inParty = selectedTeam.filter(Boolean).map(t => t.id);
  
  let list = POKE_DB;
  if (currentGenFilter !== 'all') {
    const [lo, hi] = GEN_RANGES[currentGenFilter] || [1, 9999];
    list = POKE_DB.filter((p, i) => {
      return p.id >= lo && p.id <= hi;
    });
  }
  if (search) {
    list = list.filter(p => (p.name || String(p.id)).toLowerCase().includes(search));
  }
  
  if (list.length === 0) {
    grid.innerHTML = '<p style="color:var(--muted);grid-column:1/-1;text-align:center;padding:20px">포켓몬이 없습니다. build_html_db.py를 실행하세요.</p>';
    return;
  }
  
  list.forEach(p => {
    const div = document.createElement('div');
    div.className = 'poke-card' + (inParty.includes(p.id) ? ' in-party' : '');
    const name = p.name || String(p.id);
    const types = (p.types || []).map(t => {
      const ko = TYPE_KO[t] || t;
      const col = TYPE_COLORS[t] || '#666';
      return `<span class="type-badge" style="background:${col}22;color:${col};border:1px solid ${col}44">${ko}</span>`;
    }).join('');
    div.innerHTML = `
      <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${p.id || ''}.png" onerror="this.src=''" alt="${name}">
      <div class="poke-name">${name}</div>
      <div class="poke-types">${types}</div>
    `;
    div.onclick = () => openModal(p);
    grid.appendChild(div);
  });
}

// ===== SLOT MANAGEMENT =====
function slotClick(idx) {
  const slot = selectedTeam[idx];
  if (slot) {
    openModal(slot, idx);
  }
}

function removeFromParty(idx) {
  selectedTeam[idx] = null;
  updatePartyUI();
}

function addToParty(pokeData) {
  const emptyIdx = selectedTeam.findIndex(s => !s);
  if (emptyIdx === -1) return false;
  selectedTeam[emptyIdx] = pokeData;
  updatePartyUI();
  return true;
}

function updatePartyUI() {
  for (let i = 0; i < 3; i++) {
    const slot = document.getElementById('slot' + i);
    const p = selectedTeam[i];
    if (p) {
      const name = p.name || String(p.id);
      slot.className = 'slot-card filled';
      slot.innerHTML = `
        <span class="slot-remove" onclick="event.stopPropagation();removeFromParty(${i})">✕</span>
        <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${p.id||''}.png" onerror="this.src=''">
        <span class="slot-name">${name}</span>
      `;
    } else {
      slot.className = 'slot-card';
      slot.innerHTML = `<span>${i+1}번 슬롯</span>`;
    }
  }
  document.getElementById('startBattleBtn').disabled = selectedTeam.filter(Boolean).length < 3;
  renderGrid();
}

// ===== CUSTOM DROPDOWN =====
let openCddId = null;
function toggleCdd(listId) {
  const list = document.getElementById(listId);
  if (!list) return;
  if (list.classList.contains('open')) {
    closeCdd();
  } else {
    closeCdd();
    const btn = list.previousElementSibling;
    const rect = btn.getBoundingClientRect();
    list.style.top = (rect.bottom + 4) + 'px';
    list.style.left = rect.left + 'px';
    list.style.minWidth = rect.width + 'px';
    list.classList.add('open');
    openCddId = listId;
  }
}
function closeCdd() {
  if (openCddId) {
    const l = document.getElementById(openCddId);
    if (l) l.classList.remove('open');
    openCddId = null;
  }
}
document.addEventListener('click', (e) => {
  if (!e.target.closest('.cdd-wrap')) closeCdd();
});

function buildCdd(btnId, listId, options, currentVal, onSelect) {
  const btn = document.getElementById(btnId);
  const list = document.getElementById(listId);
  if (!btn || !list) return;
  list.innerHTML = '';
  options.forEach(opt => {
    const item = document.createElement('div');
    item.className = 'cdd-item' + (opt.value === currentVal ? ' selected' : '') + (opt.disabled ? ' disabled' : '');
    item.textContent = opt.label;
    if (!opt.disabled) {
      item.onclick = (e) => {
        e.stopPropagation();
        btn.textContent = opt.label;
        closeCdd();
        onSelect(opt.value, opt.label);
        list.querySelectorAll('.cdd-item').forEach(i => i.classList.remove('selected'));
        item.classList.add('selected');
      };
    }
    list.appendChild(item);
  });
  btn.textContent = options.find(o=>o.value===currentVal)?.label || (options[0]?.label || '선택');
}

// ===== BUILD MODAL =====
let modalPoke = null, modalSlotIdx = null;

function toKorAbility(en) {
  return ABILITY_EN_KO[en] || en;
}
function toKorMove(en) {
  return MOVE_EN_KO[en] || en;
}

function openModal(pokeData, slotIdx) {
  const inParty = selectedTeam.findIndex(s => s && s.id === pokeData.id);
  if (inParty === -1 && selectedTeam.filter(Boolean).length >= 3) {
    alert('파티가 가득 찼습니다! 기존 포켓몬을 제거 후 추가하세요.');
    return;
  }
  
  modalPoke = typeof slotIdx !== 'undefined' ? JSON.parse(JSON.stringify(selectedTeam[slotIdx] || pokeData)) : JSON.parse(JSON.stringify(pokeData));
  modalSlotIdx = typeof slotIdx !== 'undefined' ? slotIdx : null;
  
  const name = modalPoke.name || String(modalPoke.id);
  document.getElementById('modalTitle').textContent = name + ' 설정';

  // EVs
  const ev = modalPoke.evs || {hp:0,atk:0,def:0,spatk:0,spdef:0,spd:0};
  document.getElementById('evHp').value = ev.hp || 0;
  document.getElementById('evAtk').value = ev.atk || 0;
  document.getElementById('evDef').value = ev.def || 0;
  document.getElementById('evSpAtk').value = ev.spatk || 0;
  document.getElementById('evSpDef').value = ev.spdef || 0;
  document.getElementById('evSpd').value = ev.spd || 0;
  updateEvTotal();

  // Ability dropdown
  const abilities = [];
  if (modalPoke.abilities && modalPoke.abilities.length > 0) {
    modalPoke.abilities.forEach(a => {
      const koName = toKorAbility(a.name || a);
      abilities.push({value: koName, label: koName + (a.hidden ? ' (히든)' : '')});
    });
  } else if (modalPoke.ability) {
    const koName = toKorAbility(modalPoke.ability);
    abilities.push({value: koName, label: koName});
  } else {
    abilities.push({value: '없음', label: '없음'});
  }
  const currentAbility = toKorAbility(modalPoke.selectedAbility || (modalPoke.abilities && modalPoke.abilities[0] ? (toKorAbility(modalPoke.abilities[0].name || modalPoke.abilities[0])) : (toKorAbility(modalPoke.ability || ''))));
  buildCdd('abilityBtn', 'abilityList', abilities, currentAbility, (val) => {
    modalPoke.selectedAbility = val;
    document.getElementById('abilityDesc').textContent = ABILITY_DESC[val] || '설명 없음';
  });
  document.getElementById('abilityDesc').textContent = ABILITY_DESC[currentAbility] || '설명 없음';
  modalPoke.selectedAbility = currentAbility;

  // Nature dropdown
  const natures = Object.keys(NATURES).map(n => ({value: n, label: n}));
  const currentNature = modalPoke.nature || '성실';
  buildCdd('natureBtn', 'natureList', natures, currentNature, (val) => { modalPoke.nature = val; });
  modalPoke.nature = currentNature;

  // Item dropdown
  const usedItems = selectedTeam.filter((s,i) => s && i !== modalSlotIdx).map(s => s.selectedItem || s.item || '');
  const itemOpts = [{value:'없음',label:'없음'}];
  Object.values(ITEMS_DB).forEach(it => {
    const disabled = usedItems.includes(it.name);
    itemOpts.push({value: it.name, label: it.name, disabled});
  });
  const currentItem = modalPoke.selectedItem || modalPoke.item || '없음';
  buildCdd('itemBtn', 'itemList', itemOpts, currentItem, (val) => { modalPoke.selectedItem = val; });
  modalPoke.selectedItem = currentItem;

  // Move pool
  const movePool = document.getElementById('movePool');
  movePool.innerHTML = '';
  const allMoves = modalPoke.allMoves || modalPoke.moves || [];
  const currentMoves = modalPoke.selectedMoves || modalPoke.moves || [];
  modalPoke.selectedMoves = [...currentMoves].slice(0, 4);

  allMoves.forEach(mv => {
    const mvName = typeof mv === 'string' ? mv : (toKorMove(mv.nameEn || mv.name || '') || mv.name || '');
    if (!mvName) return;
    const chip = document.createElement('div');
    chip.className = 'move-chip' + (modalPoke.selectedMoves.includes(mvName) ? ' selected' : '');
    const mvData = mv && typeof mv === 'object' ? mv : {};
    const power = mvData.power || 0;
    const acc = mvData.accuracy ? mvData.accuracy + '%' : '반드시맞음';
    const type = mvData.type || '';
    const typeKo = TYPE_KO[type] || type;
    const typeCol = TYPE_COLORS[type] || '#666';
    const effInfo = MOVE_DB_EFFECTS[mvName];
    let effText = '';
    if (effInfo) {
      if (effInfo.eff === 'burn') effText = `✦ ${effInfo.effChance}% 화상`;
      else if (effInfo.eff === 'para') effText = `✦ ${effInfo.effChance}% 마비`;
      else if (effInfo.eff === 'frz') effText = `✦ ${effInfo.effChance}% 얼음`;
      else if (effInfo.eff === 'psn') effText = `✦ ${effInfo.effChance}% 독`;
      else if (effInfo.eff === 'tox') effText = `✦ ${effInfo.effChance}% 맹독`;
      else if (effInfo.eff === 'slp') effText = `✦ ${effInfo.effChance}% 잠듦`;
      else if (effInfo.eff === 'flinch') effText = `✦ ${effInfo.effChance}% 풀죽음`;
      else if (effInfo.eff === 'conf') effText = `✦ ${effInfo.effChance}% 혼란`;
      else if (effInfo.selfRank) {
        const r = effInfo.selfRank;
        const parts = Object.entries(r).map(([k,v]) => `${k} ${v>0?'+':''}${v}`).join(', ');
        effText = `✦ 자신 ${parts}`;
      }
      else if (effInfo.rank) effText = `✦ 상대 능력치↓`;
      else if (effInfo.pivot) effText = `✦ 공격 후 교체`;
      else if (effInfo.special === 'protect') effText = `✦ 방어`;
      else if (effInfo.special === 'roost') effText = `✦ HP 회복`;
      else if (effInfo.special === 'sleep_heal') effText = `✦ 잠자며 HP 회복`;
      else if (effInfo.special === 'yawn') effText = `✦ 2턴 후 잠듦`;
      else if (effInfo.special === 'outrage') effText = `✦ 2~3턴 후 혼란`;
      else if (effInfo.special === 'taunt') effText = `✦ 변화기 봉인`;
      else if (effInfo.special === 'stealth_rock') effText = `✦ 스텔스록 설치`;
      else if (effInfo.special === 'reflect') effText = `✦ 5턴 물리방어↑`;
      else if (effInfo.special === 'light_screen') effText = `✦ 5턴 특수방어↑`;
      else if (effInfo.recoil) effText = `✦ 반동 ${Math.round(effInfo.recoil*100)}%`;
    }
    chip.innerHTML = `
      <div class="mc-name">${mvName}</div>
      <div class="mc-info">${power>0?'위력:'+power:'변화기'} | ${acc} | <span style="color:${typeCol}">${typeKo}</span></div>
      ${effText ? `<div class="mc-effect">${effText}</div>` : ''}
    `;
    chip.onclick = () => toggleMoveSelect(mvName, chip);
    movePool.appendChild(chip);
  });
  
  renderSelectedMoves();
  updateModalConfirmBtn();
  document.getElementById('modalOverlay').classList.add('open');
}

function toggleMoveSelect(mvName, chip) {
  const idx = modalPoke.selectedMoves.indexOf(mvName);
  if (idx !== -1) {
    modalPoke.selectedMoves.splice(idx, 1);
    chip.classList.remove('selected');
  } else {
    if (modalPoke.selectedMoves.length >= 4) {
      alert('기술은 최대 4개까지 선택 가능합니다.');
      return;
    }
    modalPoke.selectedMoves.push(mvName);
    chip.classList.add('selected');
  }
  renderSelectedMoves();
  updateModalConfirmBtn();
}

function renderSelectedMoves() {
  const el = document.getElementById('selectedMovesDisplay');
  el.innerHTML = '';
  (modalPoke.selectedMoves || []).forEach((mv, i) => {
    const tag = document.createElement('div');
    tag.className = 'sel-move-tag';
    tag.innerHTML = `${mv} <span>✕</span>`;
    tag.onclick = () => {
      modalPoke.selectedMoves.splice(i, 1);
      document.querySelectorAll('#movePool .move-chip').forEach(c => {
        if (c.querySelector('.mc-name').textContent === mv) c.classList.remove('selected');
      });
      renderSelectedMoves();
      updateModalConfirmBtn();
    };
    el.appendChild(tag);
  });
}

function updateModalConfirmBtn() {
  document.getElementById('modalConfirmBtn').disabled = !modalPoke.selectedMoves || modalPoke.selectedMoves.length === 0;
}

function confirmModal() {
  if (!modalPoke) return;
  const evTotal = ['evHp','evAtk','evDef','evSpAtk','evSpDef','evSpd'].reduce((s,id)=>s+(parseInt(document.getElementById(id).value)||0),0);
  if (evTotal > 508) {
    alert('노력치 총합이 508을 초과합니다!');
    return;
  }
  modalPoke.evs = {
    hp: parseInt(document.getElementById('evHp').value)||0,
    atk: parseInt(document.getElementById('evAtk').value)||0,
    def: parseInt(document.getElementById('evDef').value)||0,
    spatk: parseInt(document.getElementById('evSpAtk').value)||0,
    spdef: parseInt(document.getElementById('evSpDef').value)||0,
    spd: parseInt(document.getElementById('evSpd').value)||0
  };
  
  // Save to party
  if (modalSlotIdx !== null) {
    selectedTeam[modalSlotIdx] = modalPoke;
  } else {
    const emptyIdx = selectedTeam.findIndex(s => !s);
    if (emptyIdx === -1) return;
    selectedTeam[emptyIdx] = modalPoke;
  }
  
  document.getElementById('modalOverlay').classList.remove('open');
  updatePartyUI();
  modalPoke = null;
  modalSlotIdx = null;
}

// ===== EV CLAMP =====
function clampEv(input, stat) {
  let val = parseInt(input.value) || 0;
  if (val > 252) val = 252;
  if (val < 0) val = 0;
  input.value = val;
  const total = ['evHp','evAtk','evDef','evSpAtk','evSpDef','evSpd'].reduce((s,id)=>s+(parseInt(document.getElementById(id).value)||0),0);
  if (total > 508) {
    const excess = total - 508;
    const newVal = Math.max(0, val - excess);
    input.value = newVal;
  }
  updateEvTotal();
}

function updateEvTotal() {
  const total = ['evHp','evAtk','evDef','evSpAtk','evSpDef','evSpd'].reduce((s,id)=>s+(parseInt(document.getElementById(id).value)||0),0);
  const el = document.getElementById('evTotal');
  el.textContent = `노력치 총합: ${total} / 508`;
  el.className = 'ev-total ' + (total > 508 ? 'over' : 'ok');
  document.getElementById('modalConfirmBtn').disabled = total > 508 || !modalPoke || !modalPoke.selectedMoves || modalPoke.selectedMoves.length === 0;
}

// ===== PRESETS =====
function getPresets() {
  try { return JSON.parse(localStorage.getItem('pokemon_presets') || '{}'); } catch(e) { return {}; }
}
function savePresets(data) {
  try { localStorage.setItem('pokemon_presets', JSON.stringify(data)); } catch(e) { alert('저장 실패: 용량 초과'); }
}

function serializeTeam() {
  return selectedTeam.map(p => {
    if (!p) return null;
    return {
      id: p.id, dex: p.id,
      name: p.name,
      nature: p.nature || '성실',
      selectedItem: p.selectedItem || p.item || '없음',
      selectedAbility: p.selectedAbility || p.ability || '',
      evs: p.evs || {hp:0,atk:0,def:0,spatk:0,spdef:0,spd:0},
      selectedMoves: p.selectedMoves || p.moves || []
    };
  });
}

function deserializeTeam(data) {
  return data.map(s => {
    if (!s) return null;
    const full = POKE_DB.find(p => p.id === s.id);
    if (!full) return null;
    return Object.assign({}, full, s);
  });
}

function savePreset() {
  const name = document.getElementById('presetNameInput').value.trim();
  if (!name) { alert('프리셋 이름을 입력하세요.'); return; }
  if (selectedTeam.filter(Boolean).length === 0) { alert('파티에 포켓몬이 없습니다.'); return; }
  const presets = getPresets();
  presets[name] = serializeTeam();
  savePresets(presets);
  alert(`'${name}' 프리셋이 저장되었습니다!`);
  updatePresetDropdown();
}

function loadPreset(name) {
  if (!name) return;
  selectedPresetName = name;
  const presets = getPresets();
  const data = presets[name];
  if (!data) { alert('프리셋을 찾을 수 없습니다.'); return; }
  const loaded = deserializeTeam(data);
  if (loaded.filter(Boolean).length === 0 && POKE_DB.length > 0) {
    alert('포켓몬 데이터를 찾을 수 없습니다. POKE_DB가 로드되었는지 확인하세요.');
    return;
  }
  for (let i = 0; i < 3; i++) selectedTeam[i] = loaded[i] || null;
  updatePartyUI();
}

function deletePreset() {
  if (!selectedPresetName) { alert('삭제할 프리셋을 선택하세요.'); return; }
  const presets = getPresets();
  delete presets[selectedPresetName];
  savePresets(presets);
  selectedPresetName = null;
  document.getElementById('presetBtn').textContent = '프리셋 선택';
  updatePresetDropdown();
}

function updatePresetDropdown() {
  const presets = getPresets();
  const keys = Object.keys(presets);
  const opts = keys.length ? keys.map(k => ({value:k,label:k})) : [{value:'',label:'저장된 프리셋 없음',disabled:true}];
  buildCdd('presetBtn', 'presetList', opts, selectedPresetName, (val) => {
    selectedPresetName = val;
    loadPreset(val);
  });
}

// ===== RECOMMENDED ENTRIES =====
let selectedRecoName = null;
function initRecommendedDropdown() {
  const opts = RECOMMENDED_ENTRIES.map(r => ({value: r.name, label: r.name}));
  buildCdd('recoBtn', 'recoList', opts, null, (val) => { selectedRecoName = val; });
}

function applyRecommended() {
  if (!selectedRecoName) { alert('추천 엔트리를 선택하세요.'); return; }
  const entry = RECOMMENDED_ENTRIES.find(r => r.name === selectedRecoName);
  if (!entry) return;
  
  entry.team.forEach((t, i) => {
    const poke = POKE_DB.find(p => p.id === t.id);
    if (poke) {
      selectedTeam[i] = Object.assign({}, poke, {
        nature: t.nature, selectedItem: t.item,
        selectedAbility: t.ability, evs: t.evs, selectedMoves: t.moves
      });
    } else {
      // Create placeholder
      selectedTeam[i] = {
        id: t.id, name: t.id,
        types: [], abilities: [], allMoves: t.moves,
        nature: t.nature, selectedItem: t.item,
        selectedAbility: t.ability, evs: t.evs, selectedMoves: t.moves,
        stats: {hp:80,attack:80,defense:80,special_attack:80,special_defense:80,speed:80}
      };
    }
  });
  updatePartyUI();
}

// ===== BATTLE ENGINE =====
function calcStat(base, ev, nature_mod, stat) {
  const level = 50;
  if (stat === 'hp') {
    return Math.floor((2 * base + 31 + Math.floor(ev/4)) * level / 100 + level + 10);
  }
  const s = Math.floor((2 * base + 31 + Math.floor(ev/4)) * level / 100 + 5);
  return Math.floor(s * (nature_mod || 1));
}

function buildBattlePoke(p) {
  const evs = p.evs || {hp:0,atk:0,def:0,spatk:0,spdef:0,spd:0};
  const nat = NATURE_MODS[p.nature || '성실'] || {};
  const maxHp = calcStat(p.hp||70, evs.hp||0, 1, 'hp');
  const atk = calcStat(p.atk||70, evs.atk||0, nat.atk||1, 'atk');
  const def = calcStat(p.def||70, evs.def||0, nat.def||1, 'def');
  const spatk = calcStat(p.spa||70, evs.spatk||0, nat.spatk||1, 'spatk');
  const spdef = calcStat(p.spd||70, evs.spdef||0, nat.spdef||1, 'spdef');
  const spd = calcStat(p.spe||70, evs.spd||0, nat.spd||1, 'spd');
  
  const moves = (p.selectedMoves || p.moves || []).map(mvName => {
    const mvObj = (p.allMoves||[]).find(m => typeof m === 'object' && (toKorMove(m.nameEn||'') === mvName || m.name === mvName || m.name === mvName));
    return {
      name: mvName, nameEn: mvObj?.nameEn || '',
      power: mvObj?.power || 0, accuracy: mvObj?.acc ?? 100,
      type: mvObj?.type || 'normal', category: mvObj?.cat || 'physical',
      pp: mvObj?.pp || 20, maxPp: mvObj?.maxPp || mvObj?.pp || 20,
      effect: mvObj?.effect || null, effectChance: mvObj?.effectChance ?? 0,
      priority: mvObj?.priority || 0, special: mvObj?.special || null
    };
  });
  
  return {
    id: p.id, name: p.name || String(p.id),
    ability: p.selectedAbility || '', item: p.selectedItem || '없음',
    types: p.types || ['normal'],
    maxHp, currentHp: maxHp, atk, def, spatk, spdef, spd,
    moves, base_atk: atk, base_def: def, base_spatk: spatk, base_spdef: spdef, base_spd: spd,
    rank_atk: 0, rank_def: 0, rank_spatk: 0, rank_spdef: 0, rank_spd: 0, rank_acc: 0,
    status: null, statusTurns: 0, confused: false, confusedTurns: 0,
    flinched: false, taunted: false, tauntTurns: 0,
    yawnCounter: 0, outrageTurns: 0, outrageMove: null,
    stealthRock: false, reflect: 0, lightScreen: 0,
    protecting: false, recharging: false,
    _movesSinceEntry: 0, _lastProtect: false
  };
}

function getRankMult(rank) {
  const tbl = [0.25,0.29,0.33,0.40,0.50,0.67,1.0,1.5,2.0,2.5,3.0,3.5,4.0];
  return tbl[Math.max(0, Math.min(12, rank + 6))];
}

function calcDamage(attacker, defender, move, opts) {
  if (!move || move.power <= 0) return 0;
  opts = opts || {};
  
  // ── 타입 상성 (무효면 즉시 0) ──
  let typeEff = 1;
  (defender.types || ['normal']).forEach(dt => {
    const chart = TYPE_CHART[move.type] || {};
    typeEff *= chart[dt] !== undefined ? chart[dt] : 1;
  });
  if (typeEff === 0) return 0;
  
  const isSpecial = move.category === 'special';
  const atkStatName = isSpecial ? 'spatk' : 'atk';
  const defStatName = isSpecial ? 'spdef' : 'def';
  
  // ── 급소 판정 (Gen6+: 1.5배) ──
  // 급소 시: 공격측의 마이너스 랭크 무시, 방어측의 플러스 랭크 무시
  const isCrit = opts.forceCrit || (Math.random() < (move.highCrit ? 1/8 : 1/24));
  let atkRank = attacker['rank_' + atkStatName] || 0;
  let defRank = defender['rank_' + defStatName] || 0;
  if (isCrit) {
    if (atkRank < 0) atkRank = 0;   // 급소는 공격측 약화 무시
    if (defRank > 0) defRank = 0;   // 급소는 방어측 강화 무시
  }
  const atkStat = (attacker[atkStatName] || 50) * getRankMult(atkRank);
  const defStat = (defender[defStatName] || 50) * getRankMult(defRank);
  
  // ── 기본 데미지 (정식 공식: 중간 단계마다 floor) ──
  const level = 50;
  let dmg = Math.floor(Math.floor(Math.floor((2 * level) / 5 + 2) * move.power * atkStat / defStat) / 50) + 2;
  
  // ── 날씨 보정 ──
  if (battleState && battleState.weather) {
    if (battleState.weather === 'rain') {
      if (move.type === 'water') dmg = Math.floor(dmg * 1.5);
      if (move.type === 'fire') dmg = Math.floor(dmg * 0.5);
    } else if (battleState.weather === 'sun') {
      if (move.type === 'fire') dmg = Math.floor(dmg * 1.5);
      if (move.type === 'water') dmg = Math.floor(dmg * 0.5);
    }
  }
  
  // ── 급소 배율 ──
  if (isCrit) dmg = Math.floor(dmg * 1.5);
  
  // ── 난수 (85~100%) ──
  const rand = (85 + Math.floor(Math.random() * 16)) / 100;
  dmg = Math.floor(dmg * rand);
  
  // ── STAB (자속 보정) ──
  if ((attacker.types || []).includes(move.type)) {
    const stab = (attacker.ability === '적응력' || attacker.ability === 'adaptability') ? 2 : 1.5;
    dmg = Math.floor(dmg * stab);
  }
  
  // ── 타입 상성 배율 ──
  dmg = Math.floor(dmg * typeEff);
  
  // ── 화상: 물리 데미지 반감 ──
  if (attacker.status === 'burn' && !isSpecial &&
      attacker.ability !== '근성' && attacker.ability !== 'guts') {
    dmg = Math.floor(dmg / 2);
  }
  
  // ── 벽 (리플렉터/빛의장막/오로라베일) ──
  if (battleState) {
    const defSide = battleState.player.party.includes(defender) ? 'Player' : 'Ai';
    const f = battleState.field;
    if (!isCrit) { // 급소는 벽 무시
      if (!isSpecial && (f['reflect' + defSide] > 0 || f['auroraVeil' + defSide] > 0)) dmg = Math.floor(dmg / 2);
      if (isSpecial && (f['lightScreen' + defSide] > 0 || f['auroraVeil' + defSide] > 0)) dmg = Math.floor(dmg / 2);
    }
  }
  
  // ── 특성 보정 ──
  const atkAb = ABILITY_EN_KO[attacker.ability] || attacker.ability;
  const defAb = ABILITY_EN_KO[defender.ability] || defender.ability;
  const mn = move.name || '';
  // 기술 분류 (이름 기반 판별)
  const isPunch = /펀치|철권|니펀/.test(mn);
  const isBite = /엄니|물어|깨물|이빨/.test(mn);
  const isSound = /음파|보이스|노래|폭음|울음|굉음|하울링|차밍보이스/.test(mn);
  const isSlicing = /베기|크로스|블레이드|커터|슬래시|에어슬|컷|기로틴/.test(mn);
  const isContact = !isSound && move.power > 0 && move.category === 'physical' && !/사격|샷|빔|파|구슬|폭탄|썬더|버섯|포자/.test(mn);
  
  // 공격측 특성
  if (atkAb === '테크니션' && move.power <= 60) dmg = Math.floor(dmg * 1.5);
  if (atkAb === '근성' && attacker.status && !isSpecial) dmg = Math.floor(dmg * 1.5);
  if (atkAb === '단단한발톱' && isContact) dmg = Math.floor(dmg * 1.3);
  if (atkAb === '철주먹' && isPunch) dmg = Math.floor(dmg * 1.2);
  if (atkAb === '옹골찬턱' && isBite) dmg = Math.floor(dmg * 1.5);
  if (atkAb === '날카로운곡선' && isSlicing) dmg = Math.floor(dmg * 1.5);
  if (atkAb === '펑크록' && isSound) dmg = Math.floor(dmg * 1.3);
  if (atkAb === '강철술사' && move.type === 'steel') dmg = Math.floor(dmg * 1.5);
  if (atkAb === '맹화' && move.type === 'fire' && attacker.currentHp <= attacker.maxHp / 3) dmg = Math.floor(dmg * 1.5);
  if (atkAb === '급류' && move.type === 'water' && attacker.currentHp <= attacker.maxHp / 3) dmg = Math.floor(dmg * 1.5);
  if (atkAb === '심록' && move.type === 'grass' && attacker.currentHp <= attacker.maxHp / 3) dmg = Math.floor(dmg * 1.5);
  if (atkAb === '벌레의알림' && move.type === 'bug' && attacker.currentHp <= attacker.maxHp / 3) dmg = Math.floor(dmg * 1.5);
  if (atkAb === '타오르는불꽃' && attacker._flashFire && move.type === 'fire') dmg = Math.floor(dmg * 1.5);
  
  // 방어측 특성
  if (defAb === '두꺼운지방' && (move.type === 'fire' || move.type === 'ice')) dmg = Math.floor(dmg / 2);
  if (defAb === '멀티스케일' && defender.currentHp === defender.maxHp) dmg = Math.floor(dmg / 2);
  if (defAb === '내열' && move.type === 'fire') dmg = Math.floor(dmg / 2);
  if ((defAb === '하드록' || defAb === '필터' || defAb === '프리즘아머') && typeEff >= 2) dmg = Math.floor(dmg * 0.75);
  if (defAb === '펑크록' && isSound) dmg = Math.floor(dmg / 2);
  if (defAb === '방탄' && /구슬|폭탄|포|볼\b/.test(mn)) { /* 폭탄/구슬 면역 — 간이 */ }
  
  // ── 도구 보정 ──
  // ── 도구 보정 ──
  const atkItem = attacker.item || attacker.selectedItem || '';
  const defItem = defender.item || defender.selectedItem || '';
  // 공격측
  if (atkItem === '생명의구슬') dmg = Math.floor(dmg * 1.3);
  if (atkItem === '구애머리띠' && !isSpecial) dmg = Math.floor(dmg * 1.5);
  if (atkItem === '구애안경' && isSpecial) dmg = Math.floor(dmg * 1.5);
  if (atkItem === '돌격조끼') { /* 특방 1.5 — 방어측에서 처리 */ }
  if (atkItem === '専門가의띠' || atkItem === '전문가의띠') { if (typeEff >= 2) dmg = Math.floor(dmg * 1.2); }
  // 타입 강화 도구 (예: 구부러진스푼=에스퍼)
  const typeBoostItems = {
    '목탄':'fire','신비의물방울':'water','마그넷':'electric','기적의씨앗':'grass',
    '녹지않는얼음':'ice','검은띠':'fighting','독바늘':'poison','부드러운모래':'ground',
    '날카로운부리':'flying','구부러진스푼':'psychic','은빛가루':'bug','부드러운돌':'rock',
    '저주의부적':'ghost','용의이빨':'dragon','검은안경':'dark','금속코트':'steel','실크스카프':'normal'
  };
  if (typeBoostItems[atkItem] === move.type) dmg = Math.floor(dmg * 1.2);
  // 방어측
  if (defItem === '돌격조끼' && isSpecial) dmg = Math.floor(dmg / 1.5);
  if (defItem === '진화의휘석') dmg = Math.floor(dmg / 1.5); // 방어/특방 1.5배 (간이 적용)
  
  // crit 정보를 호출자에게 전달
  if (opts.report) opts.report.crit = isCrit;
  
  return Math.max(1, dmg);
}

function getTypeEffLabel(moveType, defTypes) {
  let eff = 1;
  (defTypes||[]).forEach(dt => {
    const chart = TYPE_CHART[moveType] || {};
    eff *= chart[dt] !== undefined ? chart[dt] : 1;
  });
  if (eff >= 4) return '◎ 효과가 굉장했다!';
  if (eff >= 2) return '◎ 효과가 뛰어나다!';
  if (eff === 0) return '△ 효과가 없다...';
  if (eff <= 0.25) return '▽ 효과가 거의 없다...';
  if (eff < 1) return '▽ 효과가 별로인 듯하다...';
  return '';
}

// ===== BUILD BATTLE STATE =====
function startBattle() {
  const playerPokes = selectedTeam.filter(Boolean).map(buildBattlePoke);
  if (playerPokes.length < 3) { alert('포켓몬을 3마리 선택하세요!'); return; }
  
  // AI team (random from POKE_DB)
  let aiPool = POKE_DB.filter(p => p.allMoves && p.allMoves.length >= 2);
  if (aiPool.length < 3) aiPool = POKE_DB;
  const aiRaw = [];
  while (aiRaw.length < 3 && aiPool.length > 0) {
    const idx = Math.floor(Math.random() * aiPool.length);
    aiRaw.push(aiPool.splice(idx, 1)[0]);
  }
  const aiPokesFull = aiRaw.map(p => {
    const natures = Object.keys(NATURES);
    const nature = natures[Math.floor(Math.random() * natures.length)];
    const mvs = (p.allMoves || p.moves || []).slice(0, 4);
    const mvNames = mvs.map(m => typeof m === 'string' ? m : (toKorMove(m.nameEn || '') || m.name || m.name || ''));
    return Object.assign({}, p, {
      nature, selectedAbility: toKorAbility((p.abilities && p.abilities[0]?.name) || p.ability || ''),
      selectedItem: '없음', selectedMoves: mvNames.filter(Boolean),
      evs: {hp:0,atk:252,def:4,spatk:0,spdef:0,spd:252}
    });
  });
  const aiPokes = aiPokesFull.map(buildBattlePoke);
  
  battleState = {
    player: { party: playerPokes, active: 0, revealed: [true, false, false] },
    ai: { party: aiPokes, active: 0, revealed: [true, false, false] },
    turn: 1, phase: 'action', weather: null, weatherTurns: 0,
    field: {
      // 트랩 (영구 지속, 제거 기술로만 해제)
      stealthRockPlayer: false, stealthRockAi: false,
      spikesPlayer: 0, spikesAi: 0,         // 0~3 레이어
      toxicSpikesPlayer: 0, toxicSpikesAi: 0, // 0~2 레이어
      stickyWebPlayer: false, stickyWebAi: false,
      // 스크린 (턴 기반)
      reflectPlayer: 0, reflectAi: 0,
      lightScreenPlayer: 0, lightScreenAi: 0,
      auroraVeilPlayer: 0, auroraVeilAi: 0,
      // 필드 효과 (턴 기반)
      trickRoom: 0, tailwindPlayer: 0, tailwindAi: 0,
      // 지형 (턴 기반)
      terrain: null, terrainTurns: 0
    },
    _pivotPending: false, _pivotAiMove: null
  };
  
  turnNumber = 1;
  
  document.getElementById('teamSelectScreen').style.display = 'none';
  const bs = document.getElementById('battleScreen');
  bs.classList.add('active');
  window.scrollTo(0,0);
  
  playBgm('battle');
  checkServer();
  
  // Entry ability effects
  setTimeout(() => {
    applyEntryAbility(getActive('ai'), getActive('player'));
    applyEntryAbility(getActive('player'), getActive('ai'));
    renderBattle();
    renderActions();
  }, 200);
}

function getActive(side) {
  return battleState[side].party[battleState[side].active];
}

// ===== MULTIPLAYER BATTLE =====
function goMultiTeamSelect() {
  hideAllScreens();
  document.getElementById('teamSelectScreen').style.display = '';
  // Change start button for multi mode
  const btn = document.getElementById('startBattleBtn');
  btn.textContent = '✅ 팀 선택 완료!';
  btn.onclick = sendMultiTeamReady;
  btn.disabled = selectedTeam.filter(Boolean).length < 3;
}

function sendMultiTeamReady() {
  if (!multiWs || multiWs.readyState !== 1) { alert('서버 연결이 끊겼습니다!'); return; }
  const team = selectedTeam.filter(Boolean);
  if (team.length < 3) { alert('포켓몬을 3마리 선택하세요!'); return; }
  
  // Serialize team data for server
  const teamData = team.map(p => ({
    id: p.id, name: p.name, types: p.types,
    hp: p.hp, atk: p.atk, def: p.def, spa: p.spa, spd: p.spd, spe: p.spe,
    ability: p.selectedAbility || p.ability,
    abilities: p.abilities,
    nature: p.nature,
    selectedItem: p.selectedItem || '없음',
    selectedMoves: p.selectedMoves || [],
    evs: p.evs || {hp:0,atk:0,def:0,spatk:0,spdef:0,spd:0},
    allMoves: p.allMoves || []
  }));
  
  multiWs.send(JSON.stringify({
    type: 'team_ready',
    team: teamData
  }));
  
  document.getElementById('startBattleBtn').disabled = true;
  document.getElementById('startBattleBtn').textContent = '⏳ 상대를 기다리는 중...';
}

function startMultiBattle(myTeamData, oppTeamData, oppNick) {
  // Build battle pokemon from received data
  const myPokes = myTeamData.map(buildBattlePoke);
  const oppPokes = oppTeamData.map(buildBattlePoke);
  
  // Determine which is player/ai based on role
  const amPlayer1 = multiState.role === 'player1';
  
  battleState = {
    player: { party: myPokes, active: 0, revealed: [true, false, false] },
    ai: { party: oppPokes, active: 0, revealed: [true, false, false] },
    turn: 1, phase: 'action', weather: null, weatherTurns: 0,
    field: {
      stealthRockPlayer: false, stealthRockAi: false,
      spikesPlayer: 0, spikesAi: 0,
      toxicSpikesPlayer: 0, toxicSpikesAi: 0,
      stickyWebPlayer: false, stickyWebAi: false,
      reflectPlayer: 0, reflectAi: 0,
      lightScreenPlayer: 0, lightScreenAi: 0,
      auroraVeilPlayer: 0, auroraVeilAi: 0,
      trickRoom: 0, tailwindPlayer: 0, tailwindAi: 0,
      terrain: null, terrainTurns: 0
    },
    _pivotPending: false, _pivotAiMove: null,
    multiMode: true
  };
  
  turnNumber = 1;
  
  hideAllScreens();
  document.getElementById('teamSelectScreen').style.display = 'none';
  document.getElementById('multiScreen').classList.remove('active');
  const bs = document.getElementById('battleScreen');
  bs.classList.add('active');
  window.scrollTo(0,0);
  
  // Update labels
  document.querySelector('#playerCard .battle-card-label').textContent = '🧢 ' + gameSettings.nickname;
  document.querySelector('#aiCard .battle-card-label').textContent = '⚔ ' + oppNick;
  
  playBgm('battle');
  
  // Reset start button for next time
  const btn = document.getElementById('startBattleBtn');
  btn.textContent = '▶ 배틀 시작!';
  btn.onclick = startBattle;
  
  // Entry ability effects
  setTimeout(() => {
    applyEntryAbility(getActive('ai'), getActive('player'));
    applyEntryAbility(getActive('player'), getActive('ai'));
    renderBattle();
    renderActions();
    addLog('⚔️ ' + gameSettings.nickname + ' VS ' + oppNick + ' — 배틀 시작!', 'highlight');
  }, 200);
}

// Multi: player picks action → send to server instead of executing
function multiPlayerMove(moveIdx) {
  if (battleState.phase !== 'action' || multiState.waitingForOpponent) return;
  battleState.phase = 'busy';
  multiState.waitingForOpponent = true;
  
  multiWs.send(JSON.stringify({
    type: 'battle_action',
    action: 'move',
    index: moveIdx
  }));
  
  addLog('행동을 선택했습니다. 상대를 기다리는 중...', 'system');
  renderBattle();
}

function multiPlayerSwitch(idx) {
  if (idx === battleState.player.active) return;
  const poke = battleState.player.party[idx];
  if (!poke || poke.currentHp <= 0) return;
  
  // Forced switch (fainted) - execute locally and notify server, no turn cost
  if (battleState.phase === 'switch') {
    const prev = getActive('player');
    battleState.player.active = idx;
    battleState.player.revealed[idx] = true;
    const newPoke = getActive('player');
    newPoke._movesSinceEntry = 0;
    addLog(prev.name + '을(를) 교체! ' + newPoke.name + ' 등장!', 'highlight');
    applyEntryAbility(newPoke, getActive('ai'));
    applyEntryHazards(newPoke, 'player');
    
    // Notify server (info only, doesn't affect turn)
    if (multiWs && multiWs.readyState === 1) {
      multiWs.send(JSON.stringify({
        type: 'battle_action',
        action: 'forced_switch',
        index: idx,
        pokemon_name: newPoke.name
      }));
    }
    
    switchBattleTab('fight');
    battleState.phase = 'action';
    renderBattle();
    renderActions();
    return;
  }
  
  // Normal switch (voluntary) - costs a turn
  if (battleState.phase !== 'action' || multiState.waitingForOpponent) return;
  battleState.phase = 'busy';
  multiState.waitingForOpponent = true;
  
  multiWs.send(JSON.stringify({
    type: 'battle_action',
    action: 'switch',
    index: idx
  }));
  
  addLog('교체를 선택했습니다. 상대를 기다리는 중...', 'system');
  renderBattle();
}

// Both actions received → execute turn
async function executeMultiTurn(actions, seed) {
  if (!battleState) return;
  battleState.phase = 'busy';
  
  // Seeded random for deterministic results
  let _seed = seed;
  const seededRandom = () => { _seed = (_seed * 9301 + 49297) % 233280; return _seed / 233280; };
  
  const myAction = actions[multiState.role];
  const oppRole = multiState.role === 'player1' ? 'player2' : 'player1';
  const oppAction = actions[oppRole];
  
  const player = getActive('player');
  const ai = getActive('ai');
  
  // Handle switches first
  if (myAction.action === 'switch') {
    const prev = player;
    battleState.player.active = myAction.index;
    battleState.player.revealed[myAction.index] = true;
    const newPoke = getActive('player');
    newPoke._movesSinceEntry = 0;
    addLog(prev.name + '을(를) 교체! ' + newPoke.name + ' 등장!', 'highlight');
    applyEntryAbility(newPoke, getActive('ai'));
    applyEntryHazards(newPoke, 'player');
  }
  if (oppAction.action === 'switch') {
    const prev = getActive('ai');
    battleState.ai.active = oppAction.index;
    battleState.ai.revealed[oppAction.index] = true;
    const newPoke = getActive('ai');
    newPoke._movesSinceEntry = 0;
    addLog('상대가 ' + prev.name + '을(를) 교체! ' + newPoke.name + ' 등장!', 'highlight');
    applyEntryAbility(newPoke, getActive('player'));
    applyEntryHazards(newPoke, 'ai');
  }
  
  renderBattle();
  await sleep(300);
  
  // If both switched, go to end of turn
  if (myAction.action === 'switch' && oppAction.action === 'switch') {
    if (!checkBattleEnd()) await endOfTurn();
    return;
  }
  
  // Moves
  const playerObj = getActive('player');
  const aiObj = getActive('ai');
  
  let playerMoveObj = myAction.action === 'move' ? playerObj.moves[myAction.index] : null;
  let aiMoveObj = oppAction.action === 'move' ? aiObj.moves[oppAction.index] : null;
  
  // Only one moved (other switched)
  if (playerMoveObj && !aiMoveObj) {
    await execMove(playerObj, getActive('ai'), playerMoveObj, 'player');
    if (!checkBattleEnd()) await endOfTurn();
    return;
  }
  if (!playerMoveObj && aiMoveObj) {
    await execMove(aiObj, getActive('player'), aiMoveObj, 'ai');
    if (!checkBattleEnd()) await endOfTurn();
    return;
  }
  
  // Both used moves → priority/speed check
  if (playerMoveObj && aiMoveObj) {
    let playerPrio = playerMoveObj.priority || 0;
    let aiPrio = aiMoveObj.priority || 0;
    
    const pAbilKo = ABILITY_EN_KO[playerObj.ability] || playerObj.ability;
    const aAbilKo = ABILITY_EN_KO[aiObj.ability] || aiObj.ability;
    if ((playerObj.ability === 'prankster' || pAbilKo === '짓궂은마음') && playerMoveObj.power <= 0) playerPrio += 1;
    if ((aiObj.ability === 'prankster' || aAbilKo === '짓궂은마음') && aiMoveObj.power <= 0) aiPrio += 1;
    
    let playerSpd = playerObj.spd * getRankMult(playerObj.rank_spd);
    let aiSpd = aiObj.spd * getRankMult(aiObj.rank_spd);
    if (battleState.field.tailwindPlayer > 0) playerSpd *= 2;
    if (battleState.field.tailwindAi > 0) aiSpd *= 2;
    
    let playerFirst;
    if (playerPrio !== aiPrio) {
      playerFirst = playerPrio > aiPrio;
    } else if (battleState.field.trickRoom > 0) {
      playerFirst = playerSpd <= aiSpd;
    } else {
      playerFirst = playerSpd > aiSpd || (playerSpd === aiSpd && seededRandom() < 0.5);
    }
    
    if (playerFirst) {
      const r1 = await execMove(playerObj, aiObj, playerMoveObj, 'player');
      if (r1 === 'game_over') return;
      if (aiObj.currentHp > 0 && !aiObj.flinched) {
        if (!checkBattleEnd()) {
          const r2 = await execMove(aiObj, getActive('player'), aiMoveObj, 'ai');
          if (r2 === 'ko_switch' || r2 === 'game_over') return;
        }
      } else if (aiObj.flinched) {
        addLog(aiObj.name + '는 풀이 죽어서 움직이지 못했다!', 'status');
        aiObj.flinched = false;
      }
    } else {
      const r1 = await execMove(aiObj, playerObj, aiMoveObj, 'ai');
      if (r1 === 'ko_switch' || r1 === 'game_over') return;
      if (playerObj.currentHp > 0 && !playerObj.flinched) {
        if (!checkBattleEnd()) {
          const r2 = await execMove(playerObj, getActive('ai'), playerMoveObj, 'player');
          if (r2 === 'game_over') return;
        }
      } else if (playerObj.flinched) {
        addLog(playerObj.name + '는 풀이 죽어서 움직이지 못했다!', 'status');
        playerObj.flinched = false;
      }
    }
    
    if (!checkBattleEnd()) await endOfTurn();
  }
}

function applyEntryAbility(poke, opp) {
  const ab = poke.ability;
  const abKo = ABILITY_EN_KO[ab] || ab;
  if (ab === 'intimidate' || abKo === '위협') {
    opp.rank_atk = Math.max(-6, opp.rank_atk - 1);
    addLog(poke.name + '의 위협으로 ' + opp.name + '의 공격이 내려갔다!', 'status');
  } else if (abKo === '위압감') {
    opp.rank_spatk = Math.max(-6, opp.rank_spatk - 1);
    addLog(poke.name + '의 위압감으로 ' + opp.name + '의 특공이 내려갔다!', 'status');
  } else if (ab === 'grassy-surge' || abKo === '그래스메이커') {
    const dur = poke.item === '필드확장기' ? 8 : 5;
    battleState.field.terrain = 'grassy'; battleState.field.terrainTurns = dur;
    addLog(poke.name + '가 그래스필드를 만들었다! (' + dur + '턴)', 'highlight');
  } else if (ab === 'electric-surge' || abKo === '일렉트릭메이커') {
    const dur = poke.item === '필드확장기' ? 8 : 5;
    battleState.field.terrain = 'electric'; battleState.field.terrainTurns = dur;
    addLog(poke.name + '가 일렉트릭필드를 만들었다! (' + dur + '턴)', 'highlight');
  } else if (ab === 'psychic-surge' || abKo === '사이코메이커') {
    const dur = poke.item === '필드확장기' ? 8 : 5;
    battleState.field.terrain = 'psychic'; battleState.field.terrainTurns = dur;
    addLog(poke.name + '가 사이코필드를 만들었다! (' + dur + '턴)', 'highlight');
  } else if (ab === 'misty-surge' || abKo === '미스트메이커') {
    const dur = poke.item === '필드확장기' ? 8 : 5;
    battleState.field.terrain = 'misty'; battleState.field.terrainTurns = dur;
    addLog(poke.name + '가 미스트필드를 만들었다! (' + dur + '턴)', 'highlight');
  } else if (ab === 'drought' || abKo === '가뭄') {
    const dur = _weatherDurationForAbility(poke, 'sun');
    battleState.weather = 'sun'; battleState.weatherTurns = dur;
    addLog(poke.name + '의 가뭄으로 쾌청해졌다! (' + dur + '턴)', 'highlight');
  } else if (ab === 'drizzle' || abKo === '잔비') {
    const dur = _weatherDurationForAbility(poke, 'rain');
    battleState.weather = 'rain'; battleState.weatherTurns = dur;
    addLog(poke.name + '의 잔비로 비가 내리기 시작했다! (' + dur + '턴)', 'highlight');
  } else if (ab === 'sand-stream' || abKo === '모래날리기') {
    const dur = _weatherDurationForAbility(poke, 'sand');
    battleState.weather = 'sand'; battleState.weatherTurns = dur;
    addLog(poke.name + '의 모래날리기로 모래바람이 불기 시작했다! (' + dur + '턴)', 'highlight');
  } else if (ab === 'snow-warning' || abKo === '눈퍼붓기') {
    const dur = _weatherDurationForAbility(poke, 'hail');
    battleState.weather = 'hail'; battleState.weatherTurns = dur;
    addLog(poke.name + '의 눈퍼붓기로 싸라기눈이 내리기 시작했다! (' + dur + '턴)', 'highlight');
  } else if (ab === 'intrepid-sword' || abKo === '불굴의검') {
    poke.rank_atk = Math.min(6, poke.rank_atk + 1);
    addLog(poke.name + '의 불굴의검으로 공격이 올라갔다!', 'highlight');
  } else if (ab === 'dauntless-shield' || abKo === '무적의방패') {
    poke.rank_def = Math.min(6, poke.rank_def + 1);
    addLog(poke.name + '의 무적의방패로 방어가 올라갔다!', 'highlight');
  } else if (ab === 'download' || abKo === '다운로드') {
    // 상대 방어/특방 비교 → 낮은 쪽 공략 능력 상승
    if (opp.def <= opp.spdef) { poke.rank_atk = Math.min(6, poke.rank_atk + 1); addLog(poke.name + '의 다운로드로 공격이 올라갔다!', 'highlight'); }
    else { poke.rank_spatk = Math.min(6, poke.rank_spatk + 1); addLog(poke.name + '의 다운로드로 특공이 올라갔다!', 'highlight'); }
  } else if (ab === 'protosynthesis' || abKo === '고대활성') {
    if (battleState.weather === 'sun') addLog(poke.name + '의 고대활성이 발동했다!', 'highlight');
  } else if (abKo === '위험예지' || ab === 'anticipation') {
    addLog(poke.name + '는 위험을 감지했다!', 'system');
  }
}

// 턴 종료 시 발동하는 특성
function applyEndTurnAbility(poke, side) {
  if (!poke || poke.currentHp <= 0) return;
  const ab = ABILITY_EN_KO[poke.ability] || poke.ability;
  const w = battleState.weather;
  const item = poke.item || poke.selectedItem || '';
  
  // 먹다남은음식 (Leftovers): 매 턴 1/16 회복
  if (item === '먹다남은음식' && poke.currentHp < poke.maxHp) {
    const heal = Math.max(1, Math.floor(poke.maxHp / 16));
    poke.currentHp = Math.min(poke.maxHp, poke.currentHp + heal);
    addLog(poke.name + '는 먹다남은음식으로 ' + heal + 'HP 회복!', 'heal');
  }
  // 검은진흙 (Black Sludge): 독타입 회복, 그 외 데미지
  if (item === '검은진흙') {
    if ((poke.types||[]).includes('poison')) {
      const heal = Math.max(1, Math.floor(poke.maxHp / 16));
      poke.currentHp = Math.min(poke.maxHp, poke.currentHp + heal);
      addLog(poke.name + '는 검은진흙으로 ' + heal + 'HP 회복!', 'heal');
    } else {
      const dmg = Math.max(1, Math.floor(poke.maxHp / 8));
      poke.currentHp = Math.max(0, poke.currentHp - dmg);
      addLog(poke.name + '는 검은진흙으로 ' + dmg + ' 데미지!', 'damage');
    }
  }
  
  // 독힐 (Poison Heal): 독 상태일 때 데미지 대신 회복
  if (ab === '독힐' && (poke.status === 'psn' || poke.status === 'tox')) {
    const heal = Math.floor(poke.maxHp / 8);
    poke.currentHp = Math.min(poke.maxHp, poke.currentHp + heal);
    addLog(poke.name + '는 독힐로 ' + heal + 'HP 회복!', 'heal');
    poke._poisonHealBlock = true; // 독 데미지 무효 플래그
  }
  // 강우 (Rain Dish): 비올 때 회복
  if (ab === '강우' && w === 'rain') {
    const heal = Math.floor(poke.maxHp / 16);
    poke.currentHp = Math.min(poke.maxHp, poke.currentHp + heal);
    addLog(poke.name + '는 강우로 ' + heal + 'HP 회복!', 'heal');
  }
  // 아이스바디 (Ice Body): 싸라기눈에 회복
  if (ab === '아이스바디' && w === 'hail') {
    const heal = Math.floor(poke.maxHp / 16);
    poke.currentHp = Math.min(poke.maxHp, poke.currentHp + heal);
    addLog(poke.name + '는 아이스바디로 ' + heal + 'HP 회복!', 'heal');
  }
  // 건조피부 (Dry Skin): 비 회복 / 맑음 데미지
  if (ab === '건조피부') {
    if (w === 'rain') { const h = Math.floor(poke.maxHp / 8); poke.currentHp = Math.min(poke.maxHp, poke.currentHp + h); addLog(poke.name + '는 건조피부로 ' + h + 'HP 회복!', 'heal'); }
    if (w === 'sun') { const d = Math.floor(poke.maxHp / 8); poke.currentHp = Math.max(0, poke.currentHp - d); addLog(poke.name + '는 건조피부로 ' + d + ' 데미지!', 'damage'); }
  }
  // 탈피 (Shed Skin): 33% 상태이상 회복
  if (ab === '탈피' && poke.status && Math.random() < 0.33) {
    addLog(poke.name + '는 탈피로 상태이상이 나았다!', 'heal');
    poke.status = null;
  }
  // 포자 등은 접촉 시 처리 (생략)
}

// ===== FIELD HELPERS =====
function _screenDuration(poke) {
  return poke.item === '빛의점토' ? 8 : 5;
}

function _weatherDurationForAbility(poke, weather) {
  const itemMap = {rain:'축축한바위',sun:'뜨거운바위',sand:'미끈한바위',hail:'차가운바위'};
  return poke.item === itemMap[weather] ? 8 : 5;
}

function applyEntryHazards(poke, side) {
  if (!battleState) return;
  const f = battleState.field;
  const s = side === 'player' ? 'Player' : 'Ai';
  
  // 스텔스록: 바위 타입 상성 기반 데미지 (최대 HP의 1/8 ~ 1/2)
  if (f['stealthRock' + s]) {
    let mult = 1;
    (poke.types||[]).forEach(t => {
      const chart = TYPE_CHART['rock']||{};
      mult *= chart[t] !== undefined ? chart[t] : 1;
    });
    const dmg = Math.max(1, Math.floor(poke.maxHp * mult / 8));
    poke.currentHp = Math.max(0, poke.currentHp - dmg);
    addLog(poke.name + '은(는) 스텔스록에 ' + dmg + ' 데미지를 받았다!', 'damage');
  }
  
  // 압정뿌리기: 레이어별 데미지 (비행타입/부유 면역)
  const spikes = f['spikes' + s];
  if (spikes > 0 && !(poke.types||[]).includes('flying') && poke.ability !== 'levitate') {
    const pct = [0, 1/8, 1/6, 1/4][spikes] || 0;
    const dmg = Math.max(1, Math.floor(poke.maxHp * pct));
    poke.currentHp = Math.max(0, poke.currentHp - dmg);
    addLog(poke.name + '은(는) 압정에 ' + dmg + ' 데미지를 받았다!', 'damage');
  }
  
  // 독압정: 1레이어=독, 2레이어=맹독 (독타입 교체 시 독압정 제거, 비행/강철/부유 면역)
  const tSpikes = f['toxicSpikes' + s];
  if (tSpikes > 0 && !(poke.types||[]).includes('flying') && poke.ability !== 'levitate') {
    if ((poke.types||[]).includes('poison')) {
      f['toxicSpikes' + s] = 0; // 독타입이 나오면 독압정 흡수
      addLog(poke.name + '이(가) 독압정을 흡수했다!', 'highlight');
    } else if (!(poke.types||[]).includes('steel') && !poke.status) {
      if (tSpikes >= 2) { applyStatus(poke, 'tox', '독압정'); }
      else { applyStatus(poke, 'psn', '독압정'); }
    }
  }
  
  // 끈적끈적네트: 스피드 1단계 하락 (비행/부유 면역)
  if (f['stickyWeb' + s] && !(poke.types||[]).includes('flying') && poke.ability !== 'levitate') {
    poke.rank_spd = Math.max(-6, poke.rank_spd - 1);
    addLog(poke.name + '은(는) 끈적끈적네트에 걸려 스피드가 떨어졌다!', 'status');
  }
}

// ===== RENDER BATTLE =====
function renderBattle() {
  const player = getActive('player');
  const ai = getActive('ai');
  
  // Player
  document.getElementById('playerName').textContent = player.name;
  document.getElementById('playerLevel').textContent = 'Lv.50';
  setHp('player', player.currentHp, player.maxHp);
  document.getElementById('playerSprite').src = `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${player.id||''}.png`;
  document.getElementById('playerStatus').innerHTML = renderStatus(player);
  document.getElementById('playerStatChange').innerHTML = renderStatChanges(player);
  renderBattleTypes('playerTypes', player.types);
  const pAbility = player.ability ? (ABILITY_EN_KO[player.ability] || player.ability) : '';
  document.getElementById('playerAbilityTag').textContent = pAbility ? '특성: ' + pAbility : '';
  // Player item (visible)
  const pItem = player.item && player.item !== '없음' ? player.item : '';
  document.getElementById('playerItemTag').textContent = pItem ? '🎒 ' + pItem : '';
  renderPartyMini('playerPartyMini', battleState.player, false);
  
  // AI
  document.getElementById('aiName').textContent = ai.name;
  document.getElementById('aiLevel').textContent = 'Lv.50';
  setHp('ai', ai.currentHp, ai.maxHp);
  document.getElementById('aiSprite').src = `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${ai.id||''}.png`;
  document.getElementById('aiStatus').innerHTML = renderStatus(ai);
  document.getElementById('aiStatChange').innerHTML = renderStatChanges(ai);
  renderBattleTypes('aiTypes', ai.types);
  const aAbility = ai.ability ? (ABILITY_EN_KO[ai.ability] || ai.ability) : '';
  document.getElementById('aiAbilityTag').textContent = aAbility ? '특성: ' + aAbility : '';
  // AI item is hidden (no display)
  renderPartyMini('aiPartyMini', battleState.ai, true);
  
  document.getElementById('turnBadge').textContent = 'TURN ' + battleState.turn;
  
  // Field status
  renderFieldStatus();
}

function renderBattleTypes(elId, types) {
  const el = document.getElementById(elId);
  if (!el) return;
  el.innerHTML = (types||[]).map(t => `<span class="battle-type-badge btype-${t}">${(TYPE_KO[t]||t).toUpperCase()}</span>`).join('');
}

function switchBattleTab(tab) {
  if (tab === 'fight') {
    document.getElementById('moveSection').style.display = 'block';
    document.getElementById('switchSection').style.display = 'none';
    document.getElementById('tabFight').classList.add('active');
    document.getElementById('tabSwitch').classList.remove('active');
  } else {
    document.getElementById('moveSection').style.display = 'none';
    document.getElementById('switchSection').style.display = 'block';
    document.getElementById('tabFight').classList.remove('active');
    document.getElementById('tabSwitch').classList.add('active');
  }
}

function setHp(side, cur, max) {
  const pct = Math.max(0, Math.min(100, (cur / max) * 100));
  const fill = document.getElementById(side + 'HpFill');
  const num = document.getElementById(side + 'HpNum');
  fill.style.width = pct + '%';
  fill.className = 'hp-fill ' + (pct > 50 ? 'high' : pct > 20 ? 'mid' : 'low');
  num.textContent = Math.max(0, Math.floor(cur)) + '/' + Math.floor(max);
}

function renderStatus(poke) {
  if (!poke.status) return '';
  const map = {burn:'화상',para:'마비',slp:'잠듦',frz:'얼음',psn:'독',tox:'맹독'};
  const cls = {burn:'brn',para:'par',slp:'slp',frz:'frz',psn:'psn',tox:'tox'};
  const s = poke.status;
  return `<span class="status-tag status-${cls[s]||'par'}">${map[s]||s}</span>`;
}

function renderStatChanges(poke) {
  const stats = [
    {key:'rank_atk',name:'공'},
    {key:'rank_def',name:'방'},
    {key:'rank_spatk',name:'특공'},
    {key:'rank_spdef',name:'특방'},
    {key:'rank_spd',name:'스핏'},
    {key:'rank_acc',name:'명중'}
  ];
  let html = '';
  stats.forEach(s => {
    const v = poke[s.key] || 0;
    if (v !== 0) {
      const cls = v > 0 ? 'stat-up' : 'stat-down';
      const arrow = v > 0 ? '↑' : '↓';
      html += `<span class="${cls}">${s.name}${v>0?'+':''}${v}${arrow}</span>`;
    }
  });
  return html;
}

function renderFieldStatus() {
  const el = document.getElementById('fieldStatus');
  if (!el || !battleState) { if(el) el.innerHTML=''; return; }
  let chips = [];
  const f = battleState.field;
  
  // Weather
  if (battleState.weather === 'rain') chips.push('<span class="field-chip weather">🌧️ 비 (' + battleState.weatherTurns + '턴)</span>');
  else if (battleState.weather === 'sun') chips.push('<span class="field-chip sun">☀️ 쾌청 (' + battleState.weatherTurns + '턴)</span>');
  else if (battleState.weather === 'sand') chips.push('<span class="field-chip sand">🌪️ 모래바람 (' + battleState.weatherTurns + '턴)</span>');
  else if (battleState.weather === 'hail') chips.push('<span class="field-chip hail">🌨️ 싸라기눈 (' + battleState.weatherTurns + '턴)</span>');
  
  // Trick Room
  if (f.trickRoom > 0) chips.push('<span class="field-chip trick">🌀 트릭룸 (' + f.trickRoom + '턴)</span>');
  
  // Tailwind
  if (f.tailwindPlayer > 0) chips.push('<span class="field-chip wind">💨 아군 순풍 (' + f.tailwindPlayer + '턴)</span>');
  if (f.tailwindAi > 0) chips.push('<span class="field-chip wind">💨 적 순풍 (' + f.tailwindAi + '턴)</span>');
  
  // Hazards (permanent until removed)
  if (f.stealthRockPlayer) chips.push('<span class="field-chip trap">⛏ 아군 스텔스록</span>');
  if (f.stealthRockAi) chips.push('<span class="field-chip trap">⛏ 적 스텔스록</span>');
  if (f.spikesPlayer > 0) chips.push('<span class="field-chip trap">📌 아군 압정 ×' + f.spikesPlayer + '</span>');
  if (f.spikesAi > 0) chips.push('<span class="field-chip trap">📌 적 압정 ×' + f.spikesAi + '</span>');
  if (f.toxicSpikesPlayer > 0) chips.push('<span class="field-chip trap">☠️ 아군 독압정 ×' + f.toxicSpikesPlayer + '</span>');
  if (f.toxicSpikesAi > 0) chips.push('<span class="field-chip trap">☠️ 적 독압정 ×' + f.toxicSpikesAi + '</span>');
  if (f.stickyWebPlayer) chips.push('<span class="field-chip trap">🕸️ 아군 끈적끈적네트</span>');
  if (f.stickyWebAi) chips.push('<span class="field-chip trap">🕸️ 적 끈적끈적네트</span>');
  
  // Screens
  if (f.reflectPlayer > 0) chips.push('<span class="field-chip screen">🛡 아군 리플렉터 (' + f.reflectPlayer + '턴)</span>');
  if (f.reflectAi > 0) chips.push('<span class="field-chip screen">🛡 적 리플렉터 (' + f.reflectAi + '턴)</span>');
  if (f.lightScreenPlayer > 0) chips.push('<span class="field-chip screen">🛡 아군 빛의장막 (' + f.lightScreenPlayer + '턴)</span>');
  if (f.lightScreenAi > 0) chips.push('<span class="field-chip screen">🛡 적 빛의장막 (' + f.lightScreenAi + '턴)</span>');
  if (f.auroraVeilPlayer > 0) chips.push('<span class="field-chip screen">✨ 아군 오로라베일 (' + f.auroraVeilPlayer + '턴)</span>');
  if (f.auroraVeilAi > 0) chips.push('<span class="field-chip screen">✨ 적 오로라베일 (' + f.auroraVeilAi + '턴)</span>');
  
  // Terrain
  if (f.terrain === 'grassy') chips.push('<span class="field-chip wind">🌿 그래스필드 (' + f.terrainTurns + '턴)</span>');
  else if (f.terrain === 'electric') chips.push('<span class="field-chip weather">⚡ 일렉트릭필드 (' + f.terrainTurns + '턴)</span>');
  else if (f.terrain === 'psychic') chips.push('<span class="field-chip trick">🔮 사이코필드 (' + f.terrainTurns + '턴)</span>');
  else if (f.terrain === 'misty') chips.push('<span class="field-chip screen">✨ 미스트필드 (' + f.terrainTurns + '턴)</span>');
  
  el.innerHTML = chips.join('');
}

function renderPartyMini(elId, side, isAi) {
  const el = document.getElementById(elId);
  el.innerHTML = '';
  side.party.forEach((p, i) => {
    const div = document.createElement('div');
    div.className = 'mini-poke' + (i === side.active ? ' active' : '') + (p.currentHp <= 0 ? ' fainted' : '');
    const revealed = isAi ? side.revealed[i] : true;
    if (!revealed) {
      div.innerHTML = '<span style="font-size:.7rem;color:var(--muted)">?</span>';
    } else {
      const pct = Math.max(0, (p.currentHp / p.maxHp) * 100);
      const col = pct > 50 ? 'var(--hp-high)' : pct > 20 ? 'var(--hp-mid)' : 'var(--hp-low)';
      div.innerHTML = `
        <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${p.id||''}.png" onerror="this.src=''">
        <div class="mini-hp"><div class="mini-hp-fill" style="width:${pct}%;background:${col}"></div></div>
      `;
    }
    el.appendChild(div);
  });
}

// ===== ACTIONS =====
function renderActions() {
  const player = getActive('player');
  const moveGrid = document.getElementById('moveGrid');
  moveGrid.innerHTML = '';
  
  // Outrage forced
  if (player.outrageTurns > 0 && player.outrageMove) {
    const mv = player.moves.find(m => m.name === player.outrageMove) || {name: player.outrageMove, type:'dragon',power:120,accuracy:100,category:'physical'};
    renderMoveBtn(mv, 0, player, true);
    for (let i=1;i<4;i++) {
      const btn = document.createElement('button');
      btn.className = 'move-btn'; btn.disabled = true;
      btn.innerHTML = '<div class="mb-name">-</div>';
      moveGrid.appendChild(btn);
    }
  } else {
    player.moves.forEach((mv, i) => renderMoveBtn(mv, i, player, false));
  }
  
  // Switch buttons
  const switchGrid = document.getElementById('switchGrid');
  switchGrid.innerHTML = '';
  battleState.player.party.forEach((p, i) => {
    if (i === battleState.player.active) return;
    const btn = document.createElement('button');
    btn.className = 'switch-btn';
    btn.disabled = p.currentHp <= 0;
    const pct = Math.max(0, (p.currentHp/p.maxHp)*100);
    const barCol = pct > 50 ? '#22c55e' : pct > 20 ? '#eab308' : '#ef4444';
    btn.innerHTML = `
      <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${p.id||''}.png" onerror="this.style.display='none'">
      <div class="switch-info">
        <div class="switch-name">${p.name}${p.currentHp<=0?' (쓰러짐)':''}</div>
        <div class="switch-hp-track"><div class="switch-hp-fill" style="width:${pct}%;background:${barCol}"></div></div>
      </div>
      <span class="switch-hp-text">HP ${Math.floor(p.currentHp)}/${p.maxHp}</span>`;
    btn.onclick = () => playerSwitch(i);
    switchGrid.appendChild(btn);
  });
  
  document.getElementById('moveSection').style.display = 'block';
  document.getElementById('switchSection').style.display = 'none';
  document.getElementById('tabFight').classList.add('active');
  document.getElementById('tabSwitch').classList.remove('active');
}

function renderMoveBtn(mv, idx, player, forced) {
  const moveGrid = document.getElementById('moveGrid');
  const btn = document.createElement('button');
  btn.className = 'move-btn';
  const effInfo = MOVE_DB_EFFECTS[mv.name] || {};
  const effLabel = getTypeEffLabel(mv.type, getActive('ai').types);
  const typeKo = TYPE_KO[mv.type] || mv.type;
  const typeCol = TYPE_COLORS[mv.type] || '#666';
  const acc = mv.accuracy ? mv.accuracy+'%' : '반드시맞음';
  
  let effText = '';
  if (effInfo.eff === 'burn') effText = `<div class="mb-effect">🔥 ${effInfo.effChance}% 화상</div>`;
  else if (effInfo.eff === 'para') effText = `<div class="mb-effect">⚡ ${effInfo.effChance}% 마비</div>`;
  else if (effInfo.eff === 'frz') effText = `<div class="mb-effect">❄️ ${effInfo.effChance}% 얼음</div>`;
  else if (effInfo.eff === 'psn') effText = `<div class="mb-effect">☠️ ${effInfo.effChance}% 독</div>`;
  else if (effInfo.eff === 'flinch') effText = `<div class="mb-effect">😨 ${effInfo.effChance}% 풀죽음</div>`;
  else if (effInfo.eff === 'slp') effText = `<div class="mb-effect">💤 ${effInfo.effChance}% 잠듦</div>`;
  else if (effInfo.selfRank) {
    const parts = Object.entries(effInfo.selfRank).map(([k,v])=>`${k} ${v>0?'+':''}${v}`).join(' ');
    effText = `<div class="mb-effect">✦ 자신 ${parts}</div>`;
  } else if (effInfo.pivot) effText = `<div class="mb-effect">↩️ 공격 후 교체</div>`;
  else if (effInfo.special === 'protect') effText = `<div class="mb-effect">🛡️ 방어</div>`;
  else if (effInfo.special === 'roost' || effInfo.special === 'sleep_heal') effText = `<div class="mb-effect">💚 HP 회복</div>`;
  else if (effInfo.special === 'yawn') effText = `<div class="mb-effect">😴 2턴 후 잠듦</div>`;
  else if (effInfo.special === 'outrage') effText = `<div class="mb-effect">🌀 2~3턴 후 혼란</div>`;
  else if (effInfo.special === 'taunt') effText = `<div class="mb-effect">🚫 변화기 봉인</div>`;
  else if (effInfo.special === 'stealth_rock') effText = `<div class="mb-effect">⛏️ 스텔스록</div>`;
  
  // Priority display
  let prioText = '';
  const prio = mv.priority || 0;
  if (prio > 0) prioText = `<span style="color:#22c55e;font-size:7px;font-family:'Press Start 2P',monospace">⚡+${prio}</span>`;
  else if (prio < 0) prioText = `<span style="color:#f97316;font-size:7px;font-family:'Press Start 2P',monospace">🐢${prio}</span>`;
  
  if (player.taunted && mv.power <= 0) btn.disabled = true;
  if (mv.pp <= 0) btn.disabled = true;
  
  btn.innerHTML = `
    <div class="mb-name">${mv.name} ${effLabel ? '<span style="color:#fde68a;font-size:.55rem">'+effLabel+'</span>' : ''} ${prioText}</div>
    <div class="mb-type"><span style="background:${typeCol}22;color:${typeCol};padding:1px 5px;border-radius:3px;font-size:.58rem;border:1px solid ${typeCol}44">${typeKo}</span></div>
    <div class="mb-power">${mv.power > 0 ? '위력:'+mv.power : '변화기'} | 명중:${acc}</div>
    ${effText}
    <div class="mb-pp">PP ${mv.pp}/${mv.maxPp}</div>
  `;
  if (!btn.disabled) btn.onclick = forced ? ()=>playerMove(0) : ()=>playerMove(idx);
  moveGrid.appendChild(btn);
}

// ===== EXECUTE TURN =====
async function playerMove(moveIdx) {
  // Multi mode: send action to server instead
  if (battleState && battleState.multiMode) { multiPlayerMove(moveIdx); return; }
  if (battleState.phase !== 'action') return;
  battleState.phase = 'busy';
  
  const player = getActive('player');
  const ai = getActive('ai');
  
  // Flinch check
  if (player.flinched) {
    addLog(player.name + '는 풀이 죽어서 움직이지 못했다!', 'status');
    player.flinched = false;
    await endOfTurn();
    return;
  }
  
  // Determine moves
  let playerMoveObj;
  if (player.outrageTurns > 0 && player.outrageMove) {
    playerMoveObj = player.moves.find(m => m.name === player.outrageMove) || {name:player.outrageMove,type:'dragon',power:120,accuracy:100,category:'physical',pp:10,maxPp:10};
  } else {
    playerMoveObj = player.moves[moveIdx];
  }
  if (!playerMoveObj) { battleState.phase = 'action'; return; }
  
  // AI pick
  let aiMoveObj = aiPickMove(ai, player);
  if (!aiMoveObj) aiMoveObj = ai.moves[0];
  
  // 기습(Sucker Punch) 조건 체크용: 양쪽 선택 기술 저장
  battleState._playerSelectedMove = playerMoveObj;
  battleState._aiSelectedMove = aiMoveObj;
  
  // Priority check - 우선도가 다르면 스피드와 무관하게 높은 쪽 먼저
  let playerPrio = playerMoveObj.priority || 0;
  let aiPrio = aiMoveObj.priority || 0;
  
  // 짓궂은마음 (Prankster): 변화기에 +1 우선도
  const pAbilKo = ABILITY_EN_KO[player.ability] || player.ability;
  const aAbilKo = ABILITY_EN_KO[ai.ability] || ai.ability;
  if ((player.ability === 'prankster' || pAbilKo === '짓궂은마음') && playerMoveObj.power <= 0) {
    playerPrio += 1;
  }
  if ((ai.ability === 'prankster' || aAbilKo === '짓궂은마음') && aiMoveObj.power <= 0) {
    aiPrio += 1;
  }
  
  // Speed comparison (only matters when priority is equal)
  let playerSpd = player.spd * getRankMult(player.rank_spd);
  let aiSpd = ai.spd * getRankMult(ai.rank_spd);
  
  // 구애스카프: 스피드 1.5배
  if ((player.item || player.selectedItem) === '구애스카프') playerSpd *= 1.5;
  if ((ai.item || ai.selectedItem) === '구애스카프') aiSpd *= 1.5;
  // 마비: 스피드 50%
  if (player.status === 'par') playerSpd *= 0.5;
  if (ai.status === 'par') aiSpd *= 0.5;
  
  // 순풍 (Tailwind): 스피드 2배
  if (battleState.field.tailwindPlayer > 0) playerSpd *= 2;
  if (battleState.field.tailwindAi > 0) aiSpd *= 2;
  
  let playerFirst;
  if (playerPrio !== aiPrio) {
    playerFirst = playerPrio > aiPrio; // 우선도가 다르면 높은 쪽 선공
  } else {
    // 트릭룸: 우선도가 같을 때 (주로 0일 때) 스피드 느린 쪽이 선공
    if (battleState.field.trickRoom > 0) {
      playerFirst = playerSpd <= aiSpd;
    } else {
      playerFirst = playerSpd >= aiSpd;
    }
  }
  
  // Log priority moves
  if (playerPrio !== 0) addLog(playerMoveObj.name + ' (우선도 ' + (playerPrio > 0 ? '+' : '') + playerPrio + ')', 'system');
  if (aiPrio !== 0) addLog(aiMoveObj.name + ' (우선도 ' + (aiPrio > 0 ? '+' : '') + aiPrio + ')', 'system');
  if (battleState.field.trickRoom > 0 && playerPrio === aiPrio) addLog('🌀 트릭룸 발동 중! 느린 쪽이 선공!', 'system');
  
  if (playerFirst) {
    const result = await execMove(player, ai, playerMoveObj, 'player');
    if (result === 'pivot') {
      battleState._pivotAiMove = aiMoveObj;
      return;
    }
    if (result === 'game_over') return;
    if (ai.currentHp > 0 && !ai.flinched) {
      if (!checkBattleEnd()) {
        const r2 = await execMove(ai, player, aiMoveObj, 'ai');
        if (r2 === 'ko_switch' || r2 === 'game_over') return; // player must switch or game ended
      }
    } else if (ai.flinched) {
      addLog(ai.name + '는 풀이 죽어서 움직이지 못했다!', 'status');
      ai.flinched = false;
    }
  } else {
    const r1 = await execMove(ai, player, aiMoveObj, 'ai');
    if (r1 === 'ko_switch' || r1 === 'game_over') return; // player fainted, must switch
    if (player.currentHp > 0 && !player.flinched) {
      if (!checkBattleEnd()) {
        const result = await execMove(player, ai, playerMoveObj, 'player');
        if (result === 'pivot') {
          battleState._pivotAiMove = null;
          return;
        }
        if (result === 'ko_switch' || result === 'game_over') return;
      }
    } else if (player.flinched) {
      addLog(player.name + '는 풀이 죽어서 움직이지 못했다!', 'status');
      player.flinched = false;
    }
  }
  
  if (!checkBattleEnd()) await endOfTurn();
}

async function execMove(attacker, defender, move, side) {
  if (attacker.currentHp <= 0) return;
  
  // Taunt check
  const effInfo = MOVE_DB_EFFECTS[move.name] || {};
  if (attacker.taunted && move.power <= 0 && !effInfo.pivot) {
    addLog(attacker.name + '는 도발로 인해 ' + move.name + '을(를) 쓸 수 없다!', 'status');
    return;
  }
  
  // Protect check
  if (defender.protecting) {
    addLog(attacker.name + '의 ' + move.name + '은(는) 방어에 막혔다!', 'system');
    return;
  }
  
  // ===== 상태이상 행동 제약 체크 =====
  // 잠듦 (Sleep): 깨어날 때까지 행동 불가
  if (attacker.status === 'slp') {
    attacker.statusTurns = (attacker.statusTurns || 1) - 1;
    if (attacker.statusTurns <= 0) {
      attacker.status = null;
      addLog(attacker.name + '는 잠에서 깨어났다!', 'heal');
    } else {
      // 잠꼬대 등 예외 제외하고 행동 불가
      if (move.name !== '잠꼬대' && move.name !== '코골기') {
        addLog(attacker.name + '는 쿨쿨 잠들어 있다.', 'status');
        renderBattle();
        return;
      }
    }
  }
  
  // 얼음 (Freeze): 20% 확률로 풀림, 아니면 행동 불가
  if (attacker.status === 'frz') {
    // 불꽃 기술 사용 시 자동 해동
    if (move.type === 'fire' && move.power > 0) {
      attacker.status = null;
      addLog(attacker.name + '의 얼음이 녹았다!', 'heal');
    } else if (Math.random() < 0.2) {
      attacker.status = null;
      addLog(attacker.name + '의 얼음이 녹았다!', 'heal');
    } else {
      addLog(attacker.name + '는 얼어붙어서 움직일 수 없다!', 'status');
      renderBattle();
      return;
    }
  }
  
  // 마비 (Paralysis): 25% 확률로 행동 불가
  if (attacker.status === 'par') {
    if (Math.random() < 0.25) {
      addLog(attacker.name + '는 몸이 저려서 움직일 수 없다!', 'status');
      renderBattle();
      return;
    }
  }
  
  // 혼란 (Confusion): 자기 자신을 공격할 수 있음
  if (attacker.confused) {
    attacker.confusedTurns = (attacker.confusedTurns || 1) - 1;
    if (attacker.confusedTurns <= 0) {
      attacker.confused = false;
      addLog(attacker.name + '의 혼란이 풀렸다!', 'heal');
    } else {
      addLog(attacker.name + '는 혼란에 빠져 있다!', 'status');
      if (Math.random() < 1/3) {
        // 자기 공격 (위력 40 물리, 타입 없음, 급소/상성 무시)
        const level = 50;
        const selfBase = Math.floor(Math.floor(Math.floor((2*level)/5+2) * 40 * attacker.atk / attacker.def) / 50) + 2;
        const selfDmg = Math.max(1, Math.floor(selfBase * ((85+Math.floor(Math.random()*16))/100)));
        attacker.currentHp = Math.max(0, attacker.currentHp - selfDmg);
        addLog(attacker.name + '는 혼란해서 자신을 공격했다! ' + selfDmg + ' 데미지!', 'damage');
        renderBattle();
        if (attacker.currentHp <= 0) {
          addLog(attacker.name + '는 쓰러졌다!', 'highlight');
          handleKO(side === 'player' ? 'player' : 'ai');
        }
        return;
      }
    }
  }
  
  // PP reduce
  move.pp = Math.max(0, move.pp - 1);
  
  addLog(attacker.name + '의 ' + move.name + '!', 'highlight');
  await sleep(400);
  
  // Handle special moves
  if (effInfo.special === 'protect') {
    attacker.protecting = true;
    addLog(attacker.name + '은(는) 방어 태세를 취했다!', 'system');
    renderBattle();
    return;
  }
  
  if (effInfo.special === 'roost') {
    const heal = Math.floor(attacker.maxHp / 2);
    attacker.currentHp = Math.min(attacker.maxHp, attacker.currentHp + heal);
    addLog(attacker.name + '의 HP가 ' + heal + ' 회복됐다!', 'heal');
    renderBattle();
    return;
  }
  
  if (effInfo.special === 'sleep_heal') {
    attacker.status = 'slp';
    attacker.statusTurns = 2 + Math.floor(Math.random() * 2);
    addLog(attacker.name + '는 잠들었다!', 'status');
    renderBattle();
    return;
  }
  
  if (effInfo.special === 'reflect') {
    const dur = _screenDuration(attacker);
    const fk = side === 'player' ? 'reflectPlayer' : 'reflectAi';
    battleState.field[fk] = dur;
    addLog(attacker.name + '은(는) 리플렉터를 쳤다! (' + dur + '턴)', 'system');
    renderBattle(); return;
  }
  if (effInfo.special === 'light_screen') {
    const dur = _screenDuration(attacker);
    const fk = side === 'player' ? 'lightScreenPlayer' : 'lightScreenAi';
    battleState.field[fk] = dur;
    addLog(attacker.name + '은(는) 빛의장막을 쳤다! (' + dur + '턴)', 'system');
    renderBattle(); return;
  }
  if (effInfo.special === 'aurora_veil') {
    const dur = _screenDuration(attacker);
    const fk = side === 'player' ? 'auroraVeilPlayer' : 'auroraVeilAi';
    battleState.field[fk] = dur;
    addLog(attacker.name + '은(는) 오로라베일을 쳤다! (' + dur + '턴)', 'system');
    renderBattle(); return;
  }
  
  // 날씨 기술
  if (effInfo.special === 'weather_rain') {
    const dur = attacker.item === '축축한바위' ? 8 : 5;
    battleState.weather = 'rain'; battleState.weatherTurns = dur;
    addLog('🌧️ 비가 내리기 시작했다! (' + dur + '턴)', 'highlight');
    renderBattle(); return;
  }
  if (effInfo.special === 'weather_sun') {
    const dur = attacker.item === '뜨거운바위' ? 8 : 5;
    battleState.weather = 'sun'; battleState.weatherTurns = dur;
    addLog('☀️ 쾌청해졌다! (' + dur + '턴)', 'highlight');
    renderBattle(); return;
  }
  if (effInfo.special === 'weather_sand') {
    const dur = attacker.item === '미끈한바위' ? 8 : 5;
    battleState.weather = 'sand'; battleState.weatherTurns = dur;
    addLog('🌪️ 모래바람이 불기 시작했다! (' + dur + '턴)', 'highlight');
    renderBattle(); return;
  }
  if (effInfo.special === 'weather_hail') {
    const dur = attacker.item === '차가운바위' ? 8 : 5;
    battleState.weather = 'hail'; battleState.weatherTurns = dur;
    addLog('🌨️ 싸라기눈이 내리기 시작했다! (' + dur + '턴)', 'highlight');
    renderBattle(); return;
  }
  
  // 트랩 기술 (영구, 제거 기술로만 해제)
  if (effInfo.special === 'stealth_rock') {
    const fk = side === 'player' ? 'stealthRockAi' : 'stealthRockPlayer';
    if (battleState.field[fk]) { addLog('이미 스텔스록이 깔려있다!', 'system'); }
    else { battleState.field[fk] = true; addLog(attacker.name + '은(는) 스텔스록을 깔았다!', 'system'); }
    renderBattle(); return;
  }
  if (effInfo.special === 'spikes') {
    const fk = side === 'player' ? 'spikesAi' : 'spikesPlayer';
    if (battleState.field[fk] >= 3) { addLog('압정뿌리기는 더 이상 깔 수 없다!', 'system'); }
    else { battleState.field[fk]++; addLog(attacker.name + '은(는) 압정을 깔았다! (레이어 ' + battleState.field[fk] + ')', 'system'); }
    renderBattle(); return;
  }
  if (effInfo.special === 'toxic_spikes') {
    const fk = side === 'player' ? 'toxicSpikesAi' : 'toxicSpikesPlayer';
    if (battleState.field[fk] >= 2) { addLog('독압정은 더 이상 깔 수 없다!', 'system'); }
    else { battleState.field[fk]++; addLog(attacker.name + '은(는) 독압정을 깔았다! (레이어 ' + battleState.field[fk] + ')', 'system'); }
    renderBattle(); return;
  }
  if (effInfo.special === 'sticky_web') {
    const fk = side === 'player' ? 'stickyWebAi' : 'stickyWebPlayer';
    if (battleState.field[fk]) { addLog('이미 끈적끈적네트가 깔려있다!', 'system'); }
    else { battleState.field[fk] = true; addLog(attacker.name + '은(는) 끈적끈적네트를 깔았다!', 'system'); }
    renderBattle(); return;
  }
  
  // 트랩/스크린 제거
  if (effInfo.special === 'rapid_spin') {
    // 고속스핀: 자기 쪽 트랩 전부 제거 + 위력 50 공격 + 스피드 +1
    const dmg = calcDamage(attacker, defender, move);
    if (dmg > 0) { defender.currentHp = Math.max(0, defender.currentHp - dmg); addLog(defender.name + '에게 ' + dmg + ' 데미지!', 'damage'); }
    const mySide = side === 'player' ? 'Player' : 'Ai';
    let removed = [];
    if (battleState.field['stealthRock' + mySide]) { battleState.field['stealthRock' + mySide] = false; removed.push('스텔스록'); }
    if (battleState.field['spikes' + mySide] > 0) { battleState.field['spikes' + mySide] = 0; removed.push('압정'); }
    if (battleState.field['toxicSpikes' + mySide] > 0) { battleState.field['toxicSpikes' + mySide] = 0; removed.push('독압정'); }
    if (battleState.field['stickyWeb' + mySide]) { battleState.field['stickyWeb' + mySide] = false; removed.push('끈적끈적네트'); }
    if (removed.length > 0) addLog('고속스핀으로 ' + removed.join(', ') + '을(를) 제거했다!', 'highlight');
    applyRankChange(attacker, attacker, {spd:1}, true);
    renderBattle(); return;
  }
  if (effInfo.special === 'defog') {
    // 안개제거: 양쪽 트랩 + 스크린 전부 제거
    let removed = [];
    ['Player','Ai'].forEach(s => {
      if (battleState.field['stealthRock'+s]) { battleState.field['stealthRock'+s] = false; removed.push('스텔스록'); }
      if (battleState.field['spikes'+s] > 0) { battleState.field['spikes'+s] = 0; removed.push('압정'); }
      if (battleState.field['toxicSpikes'+s] > 0) { battleState.field['toxicSpikes'+s] = 0; removed.push('독압정'); }
      if (battleState.field['stickyWeb'+s]) { battleState.field['stickyWeb'+s] = false; removed.push('끈적끈적네트'); }
      if (battleState.field['reflect'+s] > 0) { battleState.field['reflect'+s] = 0; removed.push('리플렉터'); }
      if (battleState.field['lightScreen'+s] > 0) { battleState.field['lightScreen'+s] = 0; removed.push('빛의장막'); }
      if (battleState.field['auroraVeil'+s] > 0) { battleState.field['auroraVeil'+s] = 0; removed.push('오로라베일'); }
    });
    if (removed.length > 0) addLog('안개제거로 ' + [...new Set(removed)].join(', ') + '이(가) 제거됐다!', 'highlight');
    else addLog(attacker.name + '은(는) 안개제거를 사용했다!', 'system');
    renderBattle(); return;
  }
  
  // 지형 기술
  if (effInfo.special && effInfo.special.startsWith('terrain_')) {
    const terrainType = effInfo.special.replace('terrain_', '');
    const dur = attacker.item === '필드확장기' ? 8 : 5;
    battleState.field.terrain = terrainType;
    battleState.field.terrainTurns = dur;
    const tNames = {grassy:'🌿 그래스필드',electric:'⚡ 일렉트릭필드',psychic:'🔮 사이코필드',misty:'✨ 미스트필드'};
    addLog((tNames[terrainType]||terrainType) + '가 펼쳐졌다! (' + dur + '턴)', 'highlight');
    renderBattle(); return;
  }
  
  if (effInfo.special === 'trick_room') {
    if (battleState.field.trickRoom > 0) {
      battleState.field.trickRoom = 0;
      addLog('🌀 트릭룸이 해제됐다! 공간이 원래대로 돌아왔다!', 'highlight');
    } else {
      battleState.field.trickRoom = 5;
      addLog('🌀 트릭룸! 공간이 뒤틀렸다! 느린 포켓몬이 먼저 움직인다!', 'highlight');
    }
    renderBattle(); return;
  }
  
  if (effInfo.special === 'tailwind') {
    if (side === 'player') {
      battleState.field.tailwindPlayer = 4;
      addLog('💨 순풍이 불기 시작했다! 아군의 스피드가 올라갔다!', 'highlight');
    } else {
      battleState.field.tailwindAi = 4;
      addLog('💨 상대 팀에 순풍이 불기 시작했다!', 'highlight');
    }
    renderBattle(); return;
  }
  
  if (effInfo.special === 'endure') {
    attacker.enduring = true;
    addLog(attacker.name + '은(는) 버티기 태세를 취했다!', 'system');
    renderBattle();
    return;
  }
  
  if (effInfo.special === 'taunt') {
    defender.taunted = true;
    defender.tauntTurns = 3;
    addLog(defender.name + '는 도발 상태가 됐다!', 'status');
    renderBattle();
    return;
  }
  
  if (effInfo.special === 'yawn') {
    if (!defender.status) {
      defender.yawnCounter = 2;
      addLog(defender.name + '에게 하품을 해서 잠들게 만들었다!', 'status');
    }
    renderBattle();
    return;
  }
  
  // Status-only moves (no power)
  if (move.power <= 0) {
    // Handle selfRank
    if (effInfo.selfRank) {
      applyRankChange(attacker, attacker, effInfo.selfRank, true);
    }
    // Handle target rank
    if (effInfo.rank) {
      applyRankChange(attacker, defender, effInfo.rank, false);
    }
    // Status inflict
    if (effInfo.eff) {
      const chance = effInfo.effChance || 100;
      if (Math.random() * 100 < chance) {
        applyStatus(defender, effInfo.eff, attacker.name);
      }
    }
    // Confusion
    if (effInfo.eff === 'conf') {
      defender.confused = true;
      defender.confusedTurns = 2 + Math.floor(Math.random() * 3);
      addLog(defender.name + '는 혼란에 빠졌다!', 'status');
    }
    renderBattle();
    return;
  }
  
  // Accuracy check
  const acc = move.accuracy || 100;
  const accRankMult = getRankMult(attacker.rank_acc || 0);
  const hitRoll = Math.random() * 100;
  if (acc > 0 && hitRoll >= acc * accRankMult) {
    addLog(move.name + '은(는) 빗나갔다!', 'system');
    renderBattle();
    return;
  }
  
  // Outrage tracking
  if (effInfo.special === 'outrage') {
    if (attacker.outrageTurns === 0) {
      attacker.outrageMove = move.name;
      attacker.outrageTurns = 2 + Math.floor(Math.random() * 2);
    }
    attacker.outrageTurns--;
  }
  
  // ===== TYPE IMMUNITY CHECK (공격 기술만) =====
  if (move.power > 0) {
    let typeEff = 1;
    (defender.types || ['normal']).forEach(dt => {
      const chart = TYPE_CHART[move.type] || {};
      typeEff *= chart[dt] !== undefined ? chart[dt] : 1;
    });
    if (typeEff === 0) {
      addLog(defender.name + '에게는 효과가 없다...', 'system');
      renderBattle();
      return;
    }
    
    // ===== 특성 기반 면역/흡수 =====
    const defAb = ABILITY_EN_KO[defender.ability] || defender.ability;
    // 부유 (Levitate): 땅 면역
    if ((defAb === '부유' || defender.ability === 'levitate') && move.type === 'ground') {
      addLog(defender.name + '는 부유로 땅 기술을 받지 않는다!', 'system'); renderBattle(); return;
    }
    // 타오르는불꽃 (Flash Fire): 불꽃 면역 + 불꽃기 강화
    if ((defAb === '타오르는불꽃' || defender.ability === 'flash-fire') && move.type === 'fire') {
      defender._flashFire = true;
      addLog(defender.name + '는 타오르는불꽃으로 불꽃을 흡수했다!', 'status'); renderBattle(); return;
    }
    // 저수 (Water Absorb) / 마중물 (Storm Drain): 물 면역 + 회복/특공↑
    if ((defAb === '저수' || defender.ability === 'water-absorb' || defAb === '건조피부') && move.type === 'water') {
      const heal = Math.floor(defender.maxHp / 4);
      defender.currentHp = Math.min(defender.maxHp, defender.currentHp + heal);
      addLog(defender.name + '는 물을 흡수해 ' + heal + 'HP 회복!', 'heal'); renderBattle(); return;
    }
    if ((defAb === '마중물' || defender.ability === 'storm-drain') && move.type === 'water') {
      defender.rank_spatk = Math.min(6, defender.rank_spatk + 1);
      addLog(defender.name + '는 마중물로 특공이 올라갔다!', 'status'); renderBattle(); return;
    }
    // 축전 (Volt Absorb) / 피뢰침 (Lightning Rod): 전기 면역
    if ((defAb === '축전' || defender.ability === 'volt-absorb') && move.type === 'electric') {
      const heal = Math.floor(defender.maxHp / 4);
      defender.currentHp = Math.min(defender.maxHp, defender.currentHp + heal);
      addLog(defender.name + '는 전기를 흡수해 ' + heal + 'HP 회복!', 'heal'); renderBattle(); return;
    }
    if ((defAb === '피뢰침' || defender.ability === 'lightning-rod') && move.type === 'electric') {
      defender.rank_spatk = Math.min(6, defender.rank_spatk + 1);
      addLog(defender.name + '는 피뢰침으로 특공이 올라갔다!', 'status'); renderBattle(); return;
    }
    // 초식 (Sap Sipper): 풀 면역 + 공격↑
    if ((defAb === '초식' || defender.ability === 'sap-sipper') && move.type === 'grass') {
      defender.rank_atk = Math.min(6, defender.rank_atk + 1);
      addLog(defender.name + '는 초식으로 공격이 올라갔다!', 'status'); renderBattle(); return;
    }
    // 방음 (Soundproof): 소리 기술 면역
    if ((defAb === '방음' || defender.ability === 'soundproof') && effInfo.sound) {
      addLog(defender.name + '는 방음으로 소리 기술을 받지 않는다!', 'system'); renderBattle(); return;
    }
  }
  
  // ===== CONDITIONAL MOVE CHECK (조건부 기술) =====
  const moveNameEn = move.nameEn || '';
  const moveNameKo = move.name || '';
  
  // 속이다 / 속이기 / 만나자마자 (Fake Out / First Impression)
  // → 포켓몬이 나온 뒤 첫 기술일 때만 성공 (교체 후 첫 행동 포함)
  const isFakeOut = (moveNameEn === 'fake-out' || moveNameEn === 'first-impression' ||
      moveNameKo === '속이다' || moveNameKo === '만나자마자' || moveNameKo === '선제기습');
  if (isFakeOut) {
    if ((attacker._movesSinceEntry || 0) > 0) {
      addLog(attacker.name + '의 ' + moveNameKo + '은(는) 통하지 않았다! (등장 후 첫 턴만 성공)', 'system');
      attacker._movesSinceEntry = (attacker._movesSinceEntry || 0) + 1;
      renderBattle();
      return;
    }
  }
  
  // 이 기술 사용으로 "등장 후 기술 사용 횟수" 증가 (변화기 포함)
  attacker._movesSinceEntry = (attacker._movesSinceEntry || 0) + 1;
  
  // 기습 (Sucker Punch) → 상대가 공격 기술을 선택했을 때만 성공
  if (moveNameEn === 'sucker-punch' || moveNameKo === '기습' || moveNameKo === '기습공격') {
    // 상대의 이번 턴 행동이 변화기(status)이면 실패
    const oppMove = side === 'player' ? battleState._aiSelectedMove : battleState._playerSelectedMove;
    if (oppMove && oppMove.power <= 0) {
      addLog(attacker.name + '의 기습은 실패했다!', 'system');
      renderBattle();
      return;
    }
    // 상대가 교체한 경우에도 실패
    if (oppMove === null || oppMove === undefined) {
      addLog(attacker.name + '의 기습은 실패했다!', 'system');
      renderBattle();
      return;
    }
  }
  
  // Determine hit count (multi-hit moves)
  let hitCount = 1;
  let perHitAccCheck = false; // 찍찍베기: 매 타격마다 명중판정
  if (effInfo.multiHit) {
    const [minH, maxH] = effInfo.multiHit;
    if (effInfo.popBomb) {
      // 찍찍베기 (population-bomb): 1~10회, 각 타격마다 90% 명중판정
      hitCount = maxH; // 최대 10회 시도
      perHitAccCheck = true;
    } else if (minH === maxH) {
      hitCount = minH; // 고정 횟수 (더블윙 2회, 트리플악셀 3회)
    } else {
      // 2~5회: 35% 2회, 35% 3회, 15% 4회, 15% 5회
      const r = Math.random();
      if (r < 0.35) hitCount = 2;
      else if (r < 0.70) hitCount = 3;
      else if (r < 0.85) hitCount = 4;
      else hitCount = 5;
    }
  }
  
  // Damage loop
  const defSide = side === 'player' ? 'ai' : 'player';
  const atkSide = side;
  let totalDmg = 0;
  let actualHits = 0;
  
  for (let hit = 0; hit < hitCount; hit++) {
    if (defender.currentHp <= 0) break; // 상대 쓰러지면 중단
    
    // 찍찍베기: 매 타격마다 명중판정, 빗나가면 중단
    if (perHitAccCheck && hit > 0) {
      const hitAcc = move.accuracy || 90;
      if (Math.random() * 100 >= hitAcc) {
        break; // 빗나가면 연속공격 중단
      }
    }
    
    // 트리플악셀/트리플킥: 위력이 hit마다 증가 (20→40→60)
    let effectivePower = move.power;
    if (effInfo.tripleAxel) {
      effectivePower = move.power * (hit + 1);
    }
    
    const modMove = effectivePower !== move.power ? {...move, power: effectivePower} : move;
    const critReport = {};
    let dmg = calcDamage(attacker, defender, modMove, {report: critReport});
    
    // 기합의띠/옹골참: 풀 HP에서 치명타 한 방 버티기 (1 HP 남김)
    const defItem = defender.item || defender.selectedItem || '';
    const defAb = ABILITY_EN_KO[defender.ability] || defender.ability;
    if (defender.currentHp === defender.maxHp && dmg >= defender.currentHp &&
        (defItem === '기합의띠' || defAb === '옹골참')) {
      dmg = defender.currentHp - 1;
      defender.currentHp = 1;
      totalDmg += (defender.maxHp - 1);
      actualHits++;
      if (defItem === '기합의띠') { addLog(defender.name + '는 기합의띠로 버텼다!', 'highlight'); defender.item = ''; }
      else addLog(defender.name + '는 옹골참으로 버텼다!', 'highlight');
    } else {
      defender.currentHp = Math.max(0, defender.currentHp - dmg);
      totalDmg += dmg;
      actualHits++;
    }
    if (critReport.crit) addLog('급소에 맞았다!', 'highlight');
    
    // Animate each hit
    document.getElementById(atkSide + 'Card')?.classList.add('attacking');
    document.getElementById(defSide + 'Card')?.classList.add('hit');
    
    if (hitCount > 1) {
      addLog((hit+1) + '번째 공격! ' + dmg + ' 데미지!', 'damage');
      renderBattle();
      await sleep(200);
    }
    
    setTimeout(() => {
      document.getElementById(atkSide + 'Card')?.classList.remove('attacking');
      document.getElementById(defSide + 'Card')?.classList.remove('hit');
    }, 200);
  }
  
  const eff = getTypeEffLabel(move.type, defender.types);
  const effMsg = eff ? ` ${eff}` : '';
  if (hitCount > 1) {
    addLog(actualHits + '번 맞았다! 총 ' + totalDmg + ' 데미지!' + effMsg, 'damage');
  } else {
    addLog(defender.name + '에게 ' + totalDmg + ' 데미지!' + effMsg, 'damage');
  }
  
  // Recoil (total damage based)
  if (effInfo.recoil) {
    const recoilDmg = Math.max(1, Math.floor(totalDmg * effInfo.recoil));
    attacker.currentHp = Math.max(0, attacker.currentHp - recoilDmg);
    addLog(attacker.name + '는 반동으로 ' + recoilDmg + ' 데미지를 받았다!', 'damage');
  }
  
  // 생명의구슬 반동 (공격 성공 시 최대 HP의 1/10)
  const atkItemLO = attacker.item || attacker.selectedItem || '';
  const atkAbLO = ABILITY_EN_KO[attacker.ability] || attacker.ability;
  if (atkItemLO === '생명의구슬' && totalDmg > 0 && atkAbLO !== '매직가드') {
    const loDmg = Math.max(1, Math.floor(attacker.maxHp / 10));
    attacker.currentHp = Math.max(0, attacker.currentHp - loDmg);
    addLog(attacker.name + '는 생명의구슬 반동으로 ' + loDmg + ' 데미지!', 'damage');
  }
  
  // Drain
  if (effInfo.drain) {
    const drainHp = Math.max(1, Math.floor(totalDmg * effInfo.drain));
    attacker.currentHp = Math.min(attacker.maxHp, attacker.currentHp + drainHp);
    addLog(attacker.name + '는 ' + drainHp + 'HP를 흡수했다!', 'heal');
  }
  
  renderBattle();
  await sleep(300);
  
  // Self stat changes after damage (e.g. 인파이트)
  if (effInfo.selfRank && move.power > 0) {
    applyRankChange(attacker, attacker, effInfo.selfRank, true);
  }
  
  // Secondary effects
  if (defender.currentHp > 0) {
    const atkAbSec = ABILITY_EN_KO[attacker.ability] || attacker.ability;
    // 하늘의은총: 부가효과 확률 2배 / 의욕(찍기) 등은 별도
    let chanceMult = (atkAbSec === '하늘의은총') ? 2 : 1;
    // 멍청이/노가드 무관. 색안경은 데미지쪽.
    if (effInfo.eff && effInfo.effChance) {
      const eff = effInfo.eff === 'para' ? 'par' : effInfo.eff;
      if (Math.random() * 100 < effInfo.effChance * chanceMult) {
        if (eff === 'flinch') {
          // 위협적인얼굴/우격다짐 등 무관, 방음 무관
          defender.flinched = true;
          addLog(defender.name + '는 풀이 죽었다!', 'status');
        } else if (eff === 'conf') {
          if (!defender.confused && (ABILITY_EN_KO[defender.ability]||defender.ability) !== '마이페이스') {
            defender.confused = true;
            defender.confusedTurns = 2 + Math.floor(Math.random() * 3);
            addLog(defender.name + '는 혼란에 빠졌다!', 'status');
          }
        } else {
          applyStatus(defender, eff, attacker.name);
        }
      }
    }
    if (effInfo.rank && effInfo.rankChance) {
      if (Math.random() * 100 < effInfo.rankChance * chanceMult) {
        applyRankChange(attacker, defender, effInfo.rank, false);
      }
    }
  }
  
  // Pivot (u-turn)
  if (effInfo.pivot && side === 'player' && defender.currentHp > 0) {
    const avail = battleState.player.party.filter((p,i) => i !== battleState.player.active && p.currentHp > 0);
    if (avail.length > 0) {
      battleState._pivotPending = true;
      battleState._pivotAiMove = null;
      showSwitchPrompt('유턴! 교체할 포켓몬을 선택하세요');
      return 'pivot';
    }
  }
  
  // KO check
  if (defender.currentHp <= 0) {
    addLog(defender.name + '는 쓰러졌다!', 'highlight');
    await sleep(500);
    if (checkBattleEnd()) return 'game_over';
    if (handleKO(defSide)) {
      if (defSide === 'player') return 'ko_switch'; // player must switch
    }
  }
}

function applyRankChange(attacker, target, ranks, isSelf) {
  let msg = (isSelf ? attacker.name + '의 ' : target.name + '의 ');
  const parts = [];
  for (const [stat, delta] of Object.entries(ranks)) {
    const key = 'rank_' + stat;
    if (key in target) {
      const prev = target[key];
      target[key] = Math.max(-6, Math.min(6, prev + delta));
      if (target[key] !== prev) {
        const statKo = {atk:'공격',def:'방어',spatk:'특공',spdef:'특방',spd:'스피드',acc:'명중률'}[stat] || stat;
        parts.push(statKo + ' ' + (delta>0?'↑':'↓'));
      }
    }
  }
  if (parts.length) addLog(msg + parts.join(', ') + '!', 'status');
  renderBattle();
}

function applyStatus(poke, status, atkName) {
  // 상태 코드 표준화 (para → par)
  if (status === 'para') status = 'par';
  if (poke.status) return;
  
  // 타입 면역
  if (status === 'burn' && poke.types.includes('fire')) return;
  if (status === 'par' && poke.types.includes('electric')) return; // Gen6+ 전기 마비 면역
  if ((status === 'psn' || status === 'tox') && (poke.types.includes('poison') || poke.types.includes('steel'))) return;
  if (status === 'frz' && poke.types.includes('ice')) return;
  
  // 특성 면역
  const ab = ABILITY_EN_KO[poke.ability] || poke.ability;
  if (ab === '의기양양' && (status === 'burn')) return; // 화상 면역류
  if (ab === '마이페이스' && status === 'conf') return;
  if ((ab === '불면' || ab === '의욕') && status === 'slp' && ab === '불면') return;
  if (ab === '면역' && (status === 'psn' || status === 'tox')) return;
  if (ab === '자기과신' && false) {}
  if (ab === '수의베일' && status === 'slp') return;
  if (ab === '매직베리어' && false) {}
  if (ab === '리프가드' && battleState && battleState.weather === 'sun') return;
  
  // 미스트필드: 지면 포켓몬 상태이상 면역
  if (battleState && battleState.field.terrain === 'misty' &&
      !(poke.types||[]).includes('flying') && ab !== '부유') return;
  // 일렉트릭필드: 지면 포켓몬 잠듦 면역
  if (battleState && battleState.field.terrain === 'electric' && status === 'slp' &&
      !(poke.types||[]).includes('flying') && ab !== '부유') return;
  
  poke.status = status;
  poke.statusTurns = status === 'slp' ? (2 + Math.floor(Math.random()*3)) : 0;
  const map = {burn:'화상',par:'마비',slp:'잠듦',frz:'얼음',psn:'독',tox:'맹독'};
  addLog(poke.name + '는 ' + (map[status]||status) + ' 상태가 됐다!', 'status');
}

// ===== AI PICK MOVE =====
// PPO 관측값 생성 (84차원 — 학습 환경과 동일한 형식)
function buildPpoObs(ai, player) {
  const obs = new Array(84).fill(0);
  // ai (opponent in env) stats [0-13]
  obs[0] = ai.currentHp / ai.maxHp;
  obs[1] = ai.atk / 200; obs[2] = ai.def / 200;
  obs[3] = ai.spatk / 200; obs[4] = ai.spdef / 200; obs[5] = ai.spd / 200;
  obs[6] = (ai.rank_atk || 0) / 6; obs[7] = (ai.rank_def || 0) / 6;
  obs[8] = (ai.rank_spatk || 0) / 6; obs[9] = (ai.rank_spdef || 0) / 6;
  obs[10] = (ai.rank_spd || 0) / 6;
  obs[11] = ai.status === 'burn' ? 1 : ai.status === 'par' ? 0.5 : ai.status === 'psn' ? 0.3 : ai.status === 'tox' ? 0.4 : ai.status === 'slp' ? 0.8 : ai.status === 'frz' ? 0.9 : 0;
  // ai moves [12-27]
  ai.moves.forEach((mv, i) => {
    if (i >= 4) return;
    obs[12 + i*4] = (mv.power || 0) / 150;
    obs[13 + i*4] = (mv.accuracy || 100) / 100;
    obs[14 + i*4] = mv.pp / (mv.maxPp || 1);
    let eff = 1;
    (player.types||[]).forEach(t => { const c = TYPE_CHART[mv.type]||{}; eff *= c[t] !== undefined ? c[t] : 1; });
    obs[15 + i*4] = eff / 4;
  });
  // player stats [28-41]
  obs[28] = player.currentHp / player.maxHp;
  obs[29] = player.atk / 200; obs[30] = player.def / 200;
  obs[31] = player.spatk / 200; obs[32] = player.spdef / 200; obs[33] = player.spd / 200;
  obs[34] = (player.rank_atk || 0) / 6; obs[35] = (player.rank_def || 0) / 6;
  obs[36] = (player.rank_spatk || 0) / 6; obs[37] = (player.rank_spdef || 0) / 6;
  obs[38] = (player.rank_spd || 0) / 6;
  obs[39] = player.status ? 1 : 0;
  // field [40-49]
  if (battleState) {
    obs[40] = battleState.weather === 'rain' ? 1 : battleState.weather === 'sun' ? 0.5 : battleState.weather === 'sand' ? 0.3 : battleState.weather === 'hail' ? 0.7 : 0;
    obs[41] = battleState.field.trickRoom > 0 ? 1 : 0;
    obs[42] = battleState.field.stealthRockPlayer ? 1 : 0;
    obs[43] = battleState.field.stealthRockAi ? 1 : 0;
    obs[44] = battleState.field.reflectAi > 0 ? 1 : 0;
    obs[45] = battleState.field.lightScreenAi > 0 ? 1 : 0;
    obs[46] = battleState.field.tailwindAi > 0 ? 1 : 0;
    obs[47] = battleState.turn / 100;
  }
  // team HP [48-53]
  if (battleState) {
    battleState.ai.party.forEach((p, i) => { if (i < 3) obs[48+i] = p.currentHp / p.maxHp; });
    battleState.player.party.forEach((p, i) => { if (i < 3) obs[51+i] = p.currentHp / p.maxHp; });
  }
  return obs;
}

function aiPickMove(ai, player) {
  if (ai.outrageTurns > 0 && ai.outrageMove) {
    return ai.moves.find(m => m.name === ai.outrageMove) || ai.moves[0];
  }
  
  // ===== PPO 신경망 AI (학습 모델이 탑재된 경우) =====
  if (typeof PPO_AI_AVAILABLE !== 'undefined' && PPO_AI_AVAILABLE && typeof ppoForward === 'function') {
    try {
      // 관측값 생성 (84차원)
      const obs = buildPpoObs(ai, player);
      // 행동 마스크 (PP 없는 기술, 교체 불가 등)
      const mask = new Array(6).fill(false);
      ai.moves.forEach((mv, i) => { if (i < 4 && mv.pp <= 0) mask[i] = true; });
      if (ai.taunted) ai.moves.forEach((mv, i) => { if (i < 4 && mv.power <= 0) mask[i] = true; });
      mask[4] = true; mask[5] = true; // 교체는 별도 처리
      
      const result = ppoForward(obs, mask);
      if (result.action >= 0 && result.action < 4 && ai.moves[result.action]?.pp > 0) {
        return ai.moves[result.action];
      }
    } catch(e) {
      console.warn('[PPO AI] Forward failed, fallback to heuristic:', e);
    }
  }
  
  // ===== ENHANCED AI (규칙 기반 강화 AI) =====
  const aiHpPct = ai.currentHp / ai.maxHp;
  const playerHpPct = player.currentHp / player.maxHp;
  const usableMoves = ai.moves.filter(m => m.pp > 0 && !(ai.taunted && m.power <= 0));
  if (usableMoves.length === 0) return ai.moves[0];
  
  // 데미지 계산 헬퍼
  function calcMoveScore(mv, attacker, defender) {
    if (mv.power <= 0) return 0;
    let eff = 1;
    (defender.types||[]).forEach(t => {
      const chart = TYPE_CHART[mv.type]||{};
      eff *= chart[t] !== undefined ? chart[t] : 1;
    });
    if (eff === 0) return -100; // 무효 기술은 사용하지 않음
    const dmg = calcDamage(attacker, defender, mv);
    let score = dmg * eff;
    // STAB 보너스
    if ((attacker.types||[]).includes(mv.type)) score *= 1.05;
    return score;
  }
  
  // 각 기술 점수 계산
  const scored = usableMoves.map(mv => {
    const effInfo = MOVE_DB_EFFECTS[mv.name] || {};
    let score = 0;
    
    // === 공격 기술 ===
    if (mv.power > 0) {
      score = calcMoveScore(mv, ai, player);
      
      // 연속기 보정
      if (effInfo.multiHit) {
        const [minH, maxH] = effInfo.multiHit;
        const avgHits = (minH === maxH) ? minH : 3.167; // 2~5의 기대값
        score *= avgHits * 0.85; // 단타 데미지 * 평균 횟수
      }
      
      // KO 가능하면 최우선
      const estDmg = calcDamage(ai, player, mv);
      if (estDmg >= player.currentHp) score += 500;
      
      // 상대 HP 낮으면 공격 우선
      if (playerHpPct < 0.3) score *= 1.4;
      
      // 선제기: 상대가 약할 때 마무리용
      if ((mv.priority || 0) > 0 && playerHpPct < 0.25) score *= 2.0;
      if ((mv.priority || 0) > 0 && playerHpPct > 0.5) score *= 0.7; // 상대 건강하면 선제기 비효율
      
      // 효과 없음/별로 → 페널티
      let eff = 1;
      (player.types||[]).forEach(t => {
        const chart = TYPE_CHART[mv.type]||{};
        eff *= chart[t] !== undefined ? chart[t] : 1;
      });
      if (eff < 1) score *= 0.6;
      
      // 반동기: HP 적으면 기피
      if (effInfo.recoil && effInfo.recoil > 0 && aiHpPct < 0.3) score *= 0.5;
      
      // 흡수기: HP 적을 때 보너스
      if (effInfo.drain && aiHpPct < 0.5) score *= 1.4;
      
      // 풀죽음(flinch) 기술: 선공일 때만 유효
      if (effInfo.eff === 'flinch') {
        const aiSpd = ai.spd * getRankMult(ai.rank_spd);
        const pSpd = player.spd * getRankMult(player.rank_spd);
        if (aiSpd > pSpd) score *= 1.2; // 선공이면 보너스
        else score *= 0.9; // 후공이면 풀죽음 의미없음
      }
      
    // === 변화기 ===
    } else {
      // 적극적 설정기 (칼춤, 드래곤댄스 등)
      if (effInfo.selfRank) {
        const totalBoost = Object.values(effInfo.selfRank).reduce((a,b)=>a+b, 0);
        if (totalBoost > 0) {
          score = 60 + totalBoost * 20;
          // 이미 능력이 많이 올라갔으면 공격 전환
          const currentBoosts = (ai.rank_atk||0) + (ai.rank_spatk||0) + (ai.rank_spd||0);
          if (currentBoosts >= 4) score *= 0.2;
          // HP 여유있을 때만 적극 설정
          if (aiHpPct > 0.7) score *= 1.5;
          if (aiHpPct < 0.4) score *= 0.3;
          // 상대가 약하면 그냥 공격이 나음
          if (playerHpPct < 0.3) score *= 0.2;
        } else {
          score = 20; // 자해 능력변화 (인파이트 등은 공격기라 여기 안 옴)
        }
      }
      
      // 상태기 (전자파, 도깨비불, 독 등)
      if (effInfo.eff && !player.status) {
        if (effInfo.eff === 'para') score = 70; // 마비는 강력
        else if (effInfo.eff === 'burn') score = 65;
        else if (effInfo.eff === 'tox') score = 60;
        else if (effInfo.eff === 'psn') score = 50;
        else if (effInfo.eff === 'slp') score = 75; // 잠듦은 최강
        if (player.status) score = 5; // 이미 상태이상이면 의미없음
      }
      
      // 방어: HP 적을 때만, 연속 사용 방지
      if (effInfo.special === 'protect') {
        score = aiHpPct < 0.3 ? 40 : 15;
        if (ai._lastProtect) score = 5; // 연속 방어는 실패 확률 높음
      }
      
      // 회복기
      if (effInfo.special === 'roost' || effInfo.special === 'sleep_heal') {
        if (aiHpPct < 0.4) score = 90;
        else if (aiHpPct < 0.6) score = 60;
        else score = 10;
      }
      
      // 스텔스록/압정: 안 깔렸으면 초반에 유용
      if (effInfo.special === 'stealth_rock') {
        score = battleState.field.stealthRockPlayer ? 5 : 70;
      }
      if (effInfo.special === 'spikes') {
        score = battleState.field.spikesPlayer >= 3 ? 5 : 55;
      }
      
      // 도발
      if (effInfo.special === 'taunt') {
        score = 50;
        if (player.taunted) score = 5;
      }
      
      // 트릭룸: AI가 느리면 유용
      if (effInfo.special === 'trick_room') {
        const aiSpd = ai.spd * getRankMult(ai.rank_spd);
        const pSpd = player.spd * getRankMult(player.rank_spd);
        if (battleState.field.trickRoom > 0) score = 5; // 이미 발동중이면 해제됨
        else score = aiSpd < pSpd ? 85 : 15; // 느리면 트릭룸 유리
      }
      
      // 순풍
      if (effInfo.special === 'tailwind') {
        score = battleState.field.tailwindAi > 0 ? 5 : 60;
      }
      
      // 리플렉터/빛의장막
      if (effInfo.special === 'reflect' || effInfo.special === 'light_screen') {
        const key = effInfo.special === 'reflect' ? 'reflectAi' : 'lightScreenAi';
        score = battleState.field[key] > 0 ? 5 : 55;
      }
      
      // 상대 랭크 하락
      if (effInfo.rank) {
        const totalDrop = Object.values(effInfo.rank).reduce((a,b)=>a+b, 0);
        score = 40 + Math.abs(totalDrop) * 15;
        if (playerHpPct < 0.3) score *= 0.3; // 약한 상대에게 디버프 비효율
      }
    }
    
    // 약간의 랜덤성 (같은 기술만 쓰는 거 방지)
    score += (Math.random() - 0.5) * 10;
    
    return { mv, score };
  });
  
  // 최고 점수 기술 선택
  scored.sort((a,b) => b.score - a.score);
  
  // 교체 판단: 상성이 심각하게 불리하면 교체 고려
  // (교체는 playerMove에서 처리하므로 여기서는 기술만 반환)
  
  return scored[0]?.mv || ai.moves[0];
}

// ===== PLAYER SWITCH =====
function playerSwitch(idx) {
  // Multi mode: send action to server instead
  if (battleState && battleState.multiMode) { multiPlayerSwitch(idx); return; }
  if (idx === battleState.player.active) return;
  const poke = battleState.player.party[idx];
  if (!poke || poke.currentHp <= 0) return;
  
  const prev = getActive('player');
  prev.flinched = false;
  prev.protecting = false;
  
  battleState.player.active = idx;
  battleState.player.revealed[idx] = true;
  
  const newPoke = getActive('player');
  newPoke._movesSinceEntry = 0; // 교체 후 첫 턴 리셋
  addLog(prev.name + '을(를) 교체! ' + newPoke.name + ' 등장!', 'highlight');
  
  applyEntryAbility(newPoke, getActive('ai'));
  applyEntryHazards(newPoke, 'player');
  
  // Hide switch panel
  switchBattleTab('fight');
  
  // Pivot (U-turn) switch: execute remaining AI move then end turn
  if (battleState._pivotPending) {
    battleState._pivotPending = false;
    const pendingAiMove = battleState._pivotAiMove;
    battleState._pivotAiMove = null;
    battleState.phase = 'busy';
    renderBattle();
    setTimeout(async () => {
      if (pendingAiMove) {
        const ai = getActive('ai');
        if (ai.currentHp > 0 && !checkBattleEnd()) {
          await execMove(ai, getActive('player'), pendingAiMove, 'ai');
        }
      }
      if (!checkBattleEnd()) await endOfTurn();
    }, 500);
    return;
  }
  
  // Forced switch (fainted) ends turn
  if (battleState.phase === 'switch') {
    battleState.phase = 'action';
    renderBattle();
    renderActions();
    return;
  }
  
  // Normal switch: AI gets a free move
  battleState.phase = 'busy';
  setTimeout(async () => {
    const ai = getActive('ai');
    const mv = aiPickMove(ai, getActive('player'));
    if (mv) await execMove(ai, getActive('player'), mv, 'ai');
    if (!checkBattleEnd()) await endOfTurn();
  }, 500);
}

function showSwitchPrompt(reason) {
  document.getElementById('switchReason').textContent = reason || '교체할 포켓몬을 선택하세요';
  switchBattleTab('switch');
  battleState.phase = 'switch';
  
  const switchGrid = document.getElementById('switchGrid');
  switchGrid.innerHTML = '';
  battleState.player.party.forEach((p, i) => {
    if (i === battleState.player.active) return;
    const btn = document.createElement('button');
    btn.className = 'switch-btn';
    btn.disabled = p.currentHp <= 0;
    const pct = Math.max(0, (p.currentHp/p.maxHp)*100);
    const barCol = pct > 50 ? '#22c55e' : pct > 20 ? '#eab308' : '#ef4444';
    btn.innerHTML = `
      <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${p.id||''}.png" onerror="this.style.display='none'">
      <div class="switch-info">
        <div class="switch-name">${p.name}${p.currentHp<=0?' (쓰러짐)':''}</div>
        <div class="switch-hp-track"><div class="switch-hp-fill" style="width:${pct}%;background:${barCol}"></div></div>
      </div>
      <span class="switch-hp-text">HP ${Math.floor(p.currentHp)}/${p.maxHp}</span>`;
    btn.onclick = () => playerSwitch(i);
    switchGrid.appendChild(btn);
  });
}

// ===== END OF TURN =====
async function endOfTurn() {
  const player = getActive('player');
  const ai = getActive('ai');
  
  // 턴 종료 특성 (독힐, 강우, 아이스바디, 포자 등)
  applyEndTurnAbility(player, 'player');
  applyEndTurnAbility(ai, 'ai');
  
  // Status damage
  applyStatusEndTurn(player, 'player');
  if (battleState.phase === 'switch') { renderBattle(); return; } // player KO'd by status
  applyStatusEndTurn(ai, 'ai');
  if (checkBattleEnd()) return;
  
  // Yawn
  if (player.yawnCounter > 0) {
    player.yawnCounter--;
    if (player.yawnCounter === 0 && !player.status) applyStatus(player, 'slp', '');
  }
  if (ai.yawnCounter > 0) {
    ai.yawnCounter--;
    if (ai.yawnCounter === 0 && !ai.status) applyStatus(ai, 'slp', '');
  }
  
  // Taunt countdown
  if (player.tauntTurns > 0) { player.tauntTurns--; if (!player.tauntTurns) { player.taunted = false; addLog(player.name + '의 도발이 풀렸다!', 'system'); } }
  if (ai.tauntTurns > 0) { ai.tauntTurns--; if (!ai.tauntTurns) { ai.taunted = false; addLog(ai.name + '의 도발이 풀렸다!', 'system'); } }
  
  // Screen countdowns (now on field, not on pokemon)
  const f = battleState.field;
  ['Player','Ai'].forEach(s => {
    if (f['reflect'+s] > 0) { f['reflect'+s]--; if (f['reflect'+s] === 0) addLog((s==='Player'?'아군':'상대') + '의 리플렉터가 해제됐다!', 'system'); }
    if (f['lightScreen'+s] > 0) { f['lightScreen'+s]--; if (f['lightScreen'+s] === 0) addLog((s==='Player'?'아군':'상대') + '의 빛의장막이 해제됐다!', 'system'); }
    if (f['auroraVeil'+s] > 0) { f['auroraVeil'+s]--; if (f['auroraVeil'+s] === 0) addLog((s==='Player'?'아군':'상대') + '의 오로라베일이 해제됐다!', 'system'); }
  });
  
  // Speed Boost
  const pAbSB = ABILITY_EN_KO[player.ability] || player.ability;
  const aAbSB = ABILITY_EN_KO[ai.ability] || ai.ability;
  if (player.ability === 'speed-boost' || pAbSB === '스피드부스트') { player.rank_spd = Math.min(6, player.rank_spd + 1); addLog(player.name + '의 스피드가 올라갔다!', 'status'); }
  if (ai.ability === 'speed-boost' || aAbSB === '스피드부스트') { ai.rank_spd = Math.min(6, ai.rank_spd + 1); }
  
  // Reset protecting / enduring
  player.protecting = false;
  ai.protecting = false;
  player.enduring = false;
  ai.enduring = false;
  // Reset flinch
  player.flinched = false;
  ai.flinched = false;
  
  // Field effect countdowns
  if (f.trickRoom > 0) {
    f.trickRoom--;
    if (f.trickRoom === 0) addLog('🌀 트릭룸이 해제됐다!', 'system');
  }
  if (f.tailwindPlayer > 0) {
    f.tailwindPlayer--;
    if (f.tailwindPlayer === 0) addLog('💨 아군의 순풍이 멈췄다!', 'system');
  }
  if (f.tailwindAi > 0) {
    f.tailwindAi--;
    if (f.tailwindAi === 0) addLog('💨 상대의 순풍이 멈췄다!', 'system');
  }
  
  // Weather countdown + damage
  if (battleState.weather && battleState.weatherTurns > 0) {
    battleState.weatherTurns--;
    if (battleState.weatherTurns === 0) {
      const wNames = {rain:'비',sun:'쾌청',sand:'모래바람',hail:'싸라기눈'};
      addLog((wNames[battleState.weather]||'날씨') + '가 멈췄다!', 'system');
      battleState.weather = null;
    } else {
      // 모래바람 데미지 (바위/강철/땅 타입 면역, 방진/모래숨기 등 면역)
      if (battleState.weather === 'sand') {
        [player, ai].forEach(p => {
          if (p.currentHp <= 0) return;
          const immune = (p.types||[]).some(t => ['rock','ground','steel'].includes(t));
          const abImmune = ['sand-veil','sand-rush','sand-force','overcoat','magic-guard'].includes(p.ability);
          if (!immune && !abImmune) {
            const dmg = Math.max(1, Math.floor(p.maxHp / 16));
            p.currentHp = Math.max(0, p.currentHp - dmg);
            addLog(p.name + '은(는) 모래바람으로 ' + dmg + ' 데미지!', 'damage');
          }
        });
      }
      // 싸라기눈 데미지 (얼음 타입 면역, 방진/아이스바디 등 면역)
      if (battleState.weather === 'hail') {
        [player, ai].forEach(p => {
          if (p.currentHp <= 0) return;
          const immune = (p.types||[]).includes('ice');
          const abImmune = ['ice-body','snow-cloak','overcoat','magic-guard','slush-rush'].includes(p.ability);
          if (!immune && !abImmune) {
            const dmg = Math.max(1, Math.floor(p.maxHp / 16));
            p.currentHp = Math.max(0, p.currentHp - dmg);
            addLog(p.name + '은(는) 싸라기눈으로 ' + dmg + ' 데미지!', 'damage');
          }
        });
      }
    }
  }
  
  // Terrain countdown
  if (f.terrain && f.terrainTurns > 0) {
    f.terrainTurns--;
    if (f.terrainTurns === 0) {
      const tNames = {grassy:'그래스필드',electric:'일렉트릭필드',psychic:'사이코필드',misty:'미스트필드'};
      addLog((tNames[f.terrain]||f.terrain) + '가 사라졌다!', 'system');
      f.terrain = null;
    } else if (f.terrain === 'grassy') {
      // 그래스필드: 매 턴 지면 포켓몬 HP 1/16 회복
      [player, ai].forEach(p => {
        if (p.currentHp <= 0 || p.currentHp >= p.maxHp) return;
        if (!(p.types||[]).includes('flying') && p.ability !== 'levitate') {
          const heal = Math.max(1, Math.floor(p.maxHp / 16));
          p.currentHp = Math.min(p.maxHp, p.currentHp + heal);
          addLog(p.name + '은(는) 그래스필드로 ' + heal + 'HP 회복!', 'heal');
        }
      });
    }
  }
  
  battleState.turn++;
  
  renderBattle();
  
  if (!checkBattleEnd()) {
    battleState.phase = 'action';
    renderActions();
  }
}

function applyStatusEndTurn(poke, side) {
  if (!poke.status) return;
  if (poke.currentHp <= 0) return;
  
  const ab = ABILITY_EN_KO[poke.ability] || poke.ability;
  // 매직가드: 모든 간접 데미지 무효 (잠듦/얼음은 execMove에서 처리)
  if (ab === '매직가드') {
    if (poke._poisonHealBlock) poke._poisonHealBlock = false;
    return;
  }
  // 독힐이 독 데미지를 막음
  if (poke._poisonHealBlock && (poke.status === 'psn' || poke.status === 'tox')) {
    poke._poisonHealBlock = false;
    if (poke.status === 'tox') poke.statusTurns = (poke.statusTurns || 0) + 1; // 맹독 카운트는 증가
    return;
  }
  
  if (poke.status === 'burn') {
    const dmg = Math.max(1, Math.floor(poke.maxHp / 16));
    poke.currentHp = Math.max(0, poke.currentHp - dmg);
    addLog(poke.name + '는 화상으로 ' + dmg + ' 데미지를 받았다!', 'damage');
    if (poke.currentHp <= 0) {
      addLog(poke.name + '는 쓰러졌다!', 'highlight');
      handleKO(side);
    }
  } else if (poke.status === 'tox') {
    poke.statusTurns = (poke.statusTurns || 0) + 1;
    const dmg = Math.max(1, Math.floor(poke.maxHp * poke.statusTurns / 16));
    poke.currentHp = Math.max(0, poke.currentHp - dmg);
    addLog(poke.name + '는 맹독으로 ' + dmg + ' 데미지를 받았다!', 'damage');
    if (poke.currentHp <= 0) {
      addLog(poke.name + '는 쓰러졌다!', 'highlight');
      handleKO(side);
    }
  } else if (poke.status === 'psn') {
    const dmg = Math.max(1, Math.floor(poke.maxHp / 8));
    poke.currentHp = Math.max(0, poke.currentHp - dmg);
    addLog(poke.name + '는 독으로 ' + dmg + ' 데미지를 받았다!', 'damage');
    if (poke.currentHp <= 0) {
      addLog(poke.name + '는 쓰러졌다!', 'highlight');
      handleKO(side);
    }
  }
  // 잠듦/얼음 해제는 execMove(행동 시도 시점)에서 처리
}

// ===== KO HANDLING =====
function handleKO(side) {
  const st = battleState[side];
  const next = st.party.findIndex((p, i) => i !== st.active && p.currentHp > 0);
  if (next === -1) return false;
  
  if (side === 'ai') {
    st.active = next;
    st.revealed[next] = true;
    const newPoke = getActive('ai');
    addLog('상대가 ' + newPoke.name + '를 내보냈다!', 'highlight');
    applyEntryAbility(newPoke, getActive('player'));
    applyEntryHazards(newPoke, 'ai');
    renderBattle();
    return true;
  } else {
    // Force player to switch
    showSwitchPrompt('포켓몬이 쓰러졌다! 교체할 포켓몬을 선택하세요');
    renderBattle();
    return true;
  }
}

// ===== CHECK BATTLE END =====
function checkBattleEnd() {
  const playerAlive = battleState.player.party.filter(p => p.currentHp > 0).length;
  const aiAlive = battleState.ai.party.filter(p => p.currentHp > 0).length;
  
  if (playerAlive === 0 || aiAlive === 0) {
    setTimeout(() => showResult(playerAlive > 0), 600);
    return true;
  }
  return false;
}

function showResult(playerWon) {
  const overlay = document.getElementById('resultOverlay');
  document.getElementById('resultIcon').textContent = playerWon ? '🏆' : '💀';
  document.getElementById('resultTitle').textContent = playerWon ? 'VICTORY!' : 'DEFEATED...';
  document.getElementById('resultTitle').className = 'result-title ' + (playerWon ? 'win' : 'lose');
  const msg = multiState.active 
    ? (playerWon ? multiState.oppNickname + '에게 승리!' : multiState.oppNickname + '에게 패배...')
    : (playerWon ? '배틀에서 이겼습니다!' : '다음에는 이길 수 있을 거에요!');
  document.getElementById('resultMsg').textContent = msg;
  overlay.classList.add('show');
  playBgm(playerWon ? 'win' : 'lose');
  
  // Multi: notify server
  if (multiState.active && multiWs && multiWs.readyState === 1) {
    multiWs.send(JSON.stringify({
      type: 'battle_end',
      winner: playerWon ? gameSettings.nickname : multiState.oppNickname,
      message: msg
    }));
  }
  battleState = null;
}

function goTeamSelect() {
  document.getElementById('resultOverlay').classList.remove('show');
  document.getElementById('battleScreen').classList.remove('active');
  
  // Reset multi state
  if (multiState.active) {
    multiState.active = false;
    multiState.role = null;
    multiState.waitingForOpponent = false;
    // Restore labels
    const pLabel = document.querySelector('#playerCard .battle-card-label');
    const aLabel = document.querySelector('#aiCard .battle-card-label');
    if (pLabel) pLabel.textContent = '🧢 PLAYER';
    if (aLabel) aLabel.textContent = '⚔ AI TRAINER';
    // Restore start button
    const btn = document.getElementById('startBattleBtn');
    if (btn) { btn.textContent = '▶ 배틀 시작!'; btn.onclick = startBattle; }
    // Go to title instead of team select
    hideAllScreens();
    document.getElementById('titleScreen').style.display = 'flex';
    playBgm('main');
    battleState = null;
    return;
  }
  
  document.getElementById('teamSelectScreen').style.display = '';
  window.scrollTo(0,0);
  playBgm('main');
  battleState = null;
}

// ===== LOG =====
function addLog(msg, cls) {
  const log = document.getElementById('battleLog');
  const div = document.createElement('div');
  div.className = 'log-entry ' + (cls || '');
  div.textContent = msg;
  log.appendChild(div);
  log.scrollTop = log.scrollHeight;
}

function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

// ===== QUIT DIALOG =====
function showQuitDialog() {
  document.getElementById('customDialog').classList.add('show');
}
function closeDialog() {
  document.getElementById('customDialog').classList.remove('show');
}
function confirmQuit() {
  // pywebview
  if (window.pywebview) { try { window.pywebview.api.quit(); } catch(e){} }
  // 일반 브라우저/PyQt6
  window.close();
  // 브라우저에서 window.close가 안 되면 빈 화면 표시
  setTimeout(() => {
    document.body.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100vh;background:#0a0a0f;color:#64748b;font-family:sans-serif;font-size:1.2rem">게임이 종료되었습니다. 탭을 닫아주세요.</div>';
  }, 300);
}

// ===== ESC KEY =====
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    if (document.getElementById('modalOverlay').classList.contains('open')) {
      document.getElementById('modalOverlay').classList.remove('open');
      closeCdd();
    } else {
      closeCdd();
    }
  }
});

// ===== INIT =====
window.onload = function() {
  renderGrid();
  updatePresetDropdown();
  initRecommendedDropdown();
};
</script>
</body>
</html>
