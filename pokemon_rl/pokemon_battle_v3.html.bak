<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>포켓몬 배틀 AI</title>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Noto+Sans+KR:wght@300;400;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0a0e1a;--card:#111827;--border:#1f2d45;--accent:#3b82f6;
  --hp-high:#22c55e;--hp-mid:#eab308;--hp-low:#ef4444;
  --text:#e2e8f0;--muted:#64748b;--status-burn:#ef4444;
  --status-para:#eab308;--status-sleep:#8b5cf6;--status-freeze:#38bdf8;
  --status-poison:#a855f7;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:'Segoe UI',sans-serif;min-height:100vh}
/* ===== SCANLINE OVERLAY ===== */
body::before{
  content:'';position:fixed;inset:0;
  background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,.05) 2px,rgba(0,0,0,.05) 4px);
  pointer-events:none;z-index:9999
}
/* ===== TEAM SELECT SCREEN ===== */
#teamSelectScreen{padding:16px;max-width:1100px;margin:0 auto}
.ts-header{text-align:center;margin-bottom:12px;position:relative}
.ts-header h1{font-size:1.6rem;color:var(--accent);text-shadow:0 0 12px rgba(59,130,246,.5)}
.ts-header p{color:var(--muted);font-size:.85rem;margin-top:4px}
/* Status bar (badge + volume) - outside party */
.status-bar{
  display:flex;align-items:center;justify-content:flex-end;gap:10px;
  margin-bottom:8px;padding:0 4px
}
/* Preset bar */
.preset-bar{
  background:var(--card);border:1px solid var(--border);border-radius:10px;
  padding:10px 14px;margin-bottom:10px;
  display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:center
}
.preset-bar label{color:var(--muted);font-size:.8rem;white-space:nowrap}
.preset-bar input{
  background:#1e2d40;border:1px solid var(--border);border-radius:6px;
  color:var(--text);padding:5px 8px;font-size:.8rem;width:160px
}
.preset-btn{
  background:#1e3a5f;border:1px solid var(--accent);border-radius:6px;
  color:var(--accent);padding:5px 10px;font-size:.78rem;cursor:pointer;
  transition:all .2s;white-space:nowrap
}
.preset-btn:hover{background:var(--accent);color:#fff}
.preset-btn.danger{border-color:#ef4444;color:#ef4444}
.preset-btn.danger:hover{background:#ef4444;color:#fff}
.cdd-wrap{position:relative;display:inline-block}
.cdd-btn{
  background:#1e2d40;border:1px solid var(--border);border-radius:6px;
  color:var(--text);padding:5px 28px 5px 10px;font-size:.8rem;cursor:pointer;
  min-width:150px;text-align:left;position:relative;white-space:nowrap;overflow:hidden;text-overflow:ellipsis
}
.cdd-btn::after{content:'▾';position:absolute;right:8px;top:50%;transform:translateY(-50%);color:var(--muted)}
.cdd-list{
  position:fixed;background:#1a2535;border:1px solid var(--accent);border-radius:8px;
  min-width:180px;max-height:220px;overflow-y:auto;z-index:5000;display:none;
  box-shadow:0 8px 24px rgba(0,0,0,.6)
}
.cdd-list.open{display:block}
.cdd-item{padding:7px 12px;font-size:.8rem;cursor:pointer;transition:background .15s;color:var(--text)}
.cdd-item:hover{background:#2a3f5a}
.cdd-item.selected{color:var(--accent);font-weight:600}
.cdd-item.disabled{color:var(--muted);text-decoration:line-through;cursor:not-allowed}
.cdd-item.disabled:hover{background:transparent}
/* Gen filter - see search-gen-row section */
.gen-btn{
  background:var(--card);border:1px solid var(--border);border-radius:6px;
  color:var(--muted);padding:4px 8px;font-size:.72rem;cursor:pointer;transition:all .2s;white-space:nowrap
}
.gen-btn.active{background:var(--accent);border-color:var(--accent);color:#fff}
/* Party slots */
.party-bar{
  background:var(--card);border:1px solid var(--border);border-radius:10px;
  padding:10px 14px;margin-bottom:10px;
  display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:center
}
.slot-card{
  width:90px;height:90px;background:#1a2535;border:2px dashed var(--border);
  border-radius:10px;display:flex;flex-direction:column;align-items:center;
  justify-content:center;cursor:pointer;transition:all .2s;position:relative;
  font-size:.7rem;color:var(--muted);text-align:center;overflow:hidden
}
.slot-card.filled{border-color:var(--accent);border-style:solid}
.slot-card img{width:60px;height:60px;image-rendering:pixelated}
.slot-card .slot-name{font-size:.65rem;color:var(--text);margin-top:2px}
.slot-card .slot-remove{
  position:absolute;top:2px;right:4px;color:#ef4444;font-size:.9rem;
  cursor:pointer;font-weight:700;line-height:1;z-index:2
}
.start-btn{
  background:linear-gradient(135deg,#1d4ed8,#3b82f6);
  border:none;border-radius:10px;color:#fff;padding:10px 24px;
  font-size:1rem;font-weight:700;cursor:pointer;transition:all .2s;
  box-shadow:0 0 16px rgba(59,130,246,.4)
}
.start-btn:disabled{background:#1e2d40;color:var(--muted);box-shadow:none;cursor:not-allowed}
.start-btn:not(:disabled):hover{transform:translateY(-2px);box-shadow:0 0 24px rgba(59,130,246,.6)}
/* Search + Gen row */
.search-gen-row{
  display:flex;gap:10px;align-items:center;margin-bottom:10px
}
.search-wrap{flex:1;min-width:120px}
.search-wrap input{
  width:100%;background:var(--card);border:1px solid var(--border);
  border-radius:8px;color:var(--text);padding:7px 12px;font-size:.85rem
}
.gen-filter{display:flex;gap:5px;flex-wrap:wrap;align-items:center;flex-shrink:0;margin-left:auto}
/* Pokemon grid */
.poke-grid{
  display:grid;grid-template-columns:repeat(auto-fill,minmax(88px,1fr));gap:8px;
  max-height:calc(100vh - 360px);overflow-y:auto;padding:4px
}
.poke-card{
  background:var(--card);border:1px solid var(--border);border-radius:10px;
  padding:8px;text-align:center;cursor:pointer;transition:all .2s;
  position:relative
}
.poke-card:hover{border-color:var(--accent);transform:translateY(-2px);box-shadow:0 4px 12px rgba(59,130,246,.3)}
.poke-card.in-party{border-color:#22c55e;background:#0d1f14}
.poke-card img{width:56px;height:56px;image-rendering:pixelated}
.poke-card .poke-name{font-size:.68rem;color:var(--text);margin-top:2px}
.poke-card .poke-types{display:flex;gap:3px;justify-content:center;margin-top:3px;flex-wrap:wrap}
.type-badge{font-size:.55rem;padding:1px 5px;border-radius:4px;font-weight:600}
/* ===== BUILD MODAL ===== */
.modal-overlay{
  position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:1000;
  display:none;align-items:center;justify-content:center;padding:16px
}
.modal-overlay.open{display:flex}
.move-modal{
  background:#111827;border:1px solid var(--accent);border-radius:14px;
  padding:18px;width:100%;max-width:560px;max-height:90vh;overflow-y:auto
}
.modal-title{font-size:1.1rem;font-weight:700;color:var(--accent);margin-bottom:14px;text-align:center}
.modal-row{display:flex;align-items:center;gap:8px;margin-bottom:10px;flex-wrap:wrap}
.modal-row label{color:var(--muted);font-size:.8rem;min-width:56px}
.ability-desc{font-size:.72rem;color:#7dd3fc;margin-top:4px;margin-bottom:6px;padding:4px 8px;background:#0f1e30;border-radius:6px;line-height:1.4}
.ev-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:10px}
.ev-item label{font-size:.72rem;color:var(--muted);display:block;margin-bottom:3px}
.ev-item input{
  width:100%;background:#1e2d40;border:1px solid var(--border);
  border-radius:6px;color:var(--text);padding:5px 8px;font-size:.82rem;text-align:center
}
.ev-total{font-size:.75rem;margin-bottom:10px}
.ev-total.ok{color:#22c55e}
.ev-total.over{color:#ef4444}
.move-pool{display:grid;grid-template-columns:1fr 1fr;gap:6px;max-height:260px;overflow-y:auto;margin-bottom:10px}
.move-chip{
  background:#1a2535;border:1px solid var(--border);border-radius:7px;
  padding:6px 10px;font-size:.75rem;cursor:pointer;transition:all .2s;
  display:flex;flex-direction:column;gap:2px
}
.move-chip:hover{border-color:var(--accent)}
.move-chip.selected{border-color:#22c55e;background:#0d1f14}
.move-chip .mc-name{font-weight:600;color:var(--text)}
.move-chip .mc-info{color:var(--muted);font-size:.65rem}
.move-chip .mc-effect{color:#86efac;font-size:.62rem}
.selected-moves{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px;min-height:28px}
.sel-move-tag{
  background:#1d3461;border:1px solid var(--accent);border-radius:6px;
  padding:3px 8px;font-size:.72rem;color:var(--accent);cursor:pointer;
  display:flex;align-items:center;gap:4px
}
.sel-move-tag:hover{background:#ef4444;border-color:#ef4444;color:#fff}
.modal-confirm{
  width:100%;background:var(--accent);border:none;border-radius:8px;
  color:#fff;padding:10px;font-size:.9rem;font-weight:700;cursor:pointer;transition:all .2s
}
.modal-confirm:hover{background:#2563eb}
.modal-confirm:disabled{background:#1e2d40;color:var(--muted);cursor:not-allowed}
/* ===== BATTLE SCREEN ===== */
#battleScreen{
  position:fixed;inset:0;background:#0a0a0f;z-index:100;
  overflow-y:auto;display:none;flex-direction:column;
  font-family:'Noto Sans KR',sans-serif
}
#battleScreen::before{content:'';position:fixed;inset:0;
  background-image:linear-gradient(rgba(0,229,255,0.03)1px,transparent 1px),linear-gradient(90deg,rgba(0,229,255,0.03)1px,transparent 1px);
  background-size:40px 40px;pointer-events:none;z-index:0}
#battleScreen::after{content:'';position:fixed;inset:0;
  background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,.06)2px,rgba(0,0,0,.06)4px);
  pointer-events:none;z-index:1}
#battleScreen.active{display:flex}
.battle-header{
  position:relative;z-index:10;
  padding:14px 20px 10px;background:linear-gradient(180deg,rgba(0,229,255,0.05)0%,transparent 100%);
  border-bottom:1px solid #2a2a40
}
.battle-header h2{font-family:'Press Start 2P',monospace;font-size:clamp(11px,2.5vw,16px);
  color:#00e5ff;text-shadow:0 0 20px rgba(0,229,255,0.5);letter-spacing:2px;text-align:center}
.battle-header-row{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:6px;position:relative}
.server-badge{
  display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:20px;
  font-family:'Press Start 2P',monospace;font-size:8px;border:1px solid
}
.server-badge .dot{width:6px;height:6px;border-radius:50%;background:currentColor;animation:pulse 1.5s infinite;display:inline-block}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.3}}
.server-badge.online{color:#22c55e;border-color:#22c55e;background:rgba(34,197,94,0.1)}
.server-badge.offline{color:#ef4444;border-color:#ef4444;background:rgba(239,68,68,0.1)}
.server-badge.checking{color:#fbbf24;border-color:#fbbf24;background:rgba(251,191,36,0.1)}
.turn-badge{
  font-family:'Press Start 2P',monospace;font-size:9px;color:#64748b;
  letter-spacing:2px;display:block;margin-top:6px;text-align:center
}
/* Battle volume control */
.battle-vol{display:flex;align-items:center;gap:4px;position:absolute;right:0;top:50%;transform:translateY(-50%)}
.battle-vol .vol-btn{background:none;border:none;color:var(--text);cursor:pointer;font-size:1rem}
.battle-vol input[type=range]{width:60px;accent-color:#00e5ff}
/* Battle field */
.battle-field{
  position:relative;z-index:5;display:grid;grid-template-columns:1fr 1fr;gap:12px;
  padding:14px;max-width:960px;margin:0 auto;width:100%
}
.pokemon-card-battle{
  background:#12121a;border:1px solid #2a2a40;border-radius:12px;
  padding:14px;position:relative;overflow:hidden;transition:all .3s
}
.pokemon-card-battle::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg,transparent,#00e5ff,transparent);opacity:0;transition:opacity .3s}
.pokemon-card-battle::before{opacity:1}
.pokemon-card-battle.opponent-card::before{background:linear-gradient(90deg,transparent,#ff6b35,transparent)}
.pokemon-card-battle.attacking{animation:atk-anim .3s ease-out}
.pokemon-card-battle.hit{animation:dmg-anim .4s ease-out}
@keyframes atk-anim{0%{transform:translateX(0)}25%{transform:translateX(8px)}75%{transform:translateX(-4px)}100%{transform:translateX(0)}}
@keyframes dmg-anim{0%,100%{opacity:1;filter:drop-shadow(0 0 8px #fff)}50%{opacity:.2;filter:drop-shadow(0 0 20px #ef4444)}}
.battle-card-label{font-family:'Press Start 2P',monospace;font-size:10px;letter-spacing:3px;
  text-transform:uppercase;color:#64748b;margin-bottom:8px}
.player-side .battle-card-label{color:#00e5ff}
.opponent-card .battle-card-label{color:#ff6b35}
.poke-battle-header{display:flex;align-items:flex-start;gap:10px;margin-bottom:8px}
.poke-sprite-wrap{flex-shrink:0}
.poke-sprite-wrap img{width:72px;height:72px;image-rendering:pixelated;
  filter:drop-shadow(0 4px 12px rgba(0,229,255,.3));transition:transform .3s}
.opponent-card .poke-sprite-wrap img{filter:drop-shadow(0 4px 12px rgba(255,107,53,.3))}
.poke-battle-info{flex:1;min-width:0}
.poke-battle-name{font-family:'Press Start 2P',monospace;font-size:clamp(9px,1.6vw,12px);
  color:var(--text);margin-bottom:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.poke-battle-level{font-family:'Press Start 2P',monospace;font-size:9px;color:#64748b;margin-left:4px}
.poke-battle-types{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:7px}
.battle-type-badge{font-family:'Press Start 2P',monospace;font-size:8px;padding:2px 6px;
  border-radius:3px;font-weight:700;text-transform:uppercase;letter-spacing:1px}
/* Battle type colors */
.btype-fire{background:rgba(255,107,53,.2);color:#ff6b35;border:1px solid rgba(255,107,53,.4)}
.btype-water{background:rgba(56,189,248,.2);color:#38bdf8;border:1px solid rgba(56,189,248,.4)}
.btype-grass{background:rgba(74,222,128,.2);color:#4ade80;border:1px solid rgba(74,222,128,.4)}
.btype-electric{background:rgba(251,191,36,.2);color:#fbbf24;border:1px solid rgba(251,191,36,.4)}
.btype-ice{background:rgba(165,243,252,.2);color:#a5f3fc;border:1px solid rgba(165,243,252,.4)}
.btype-fighting{background:rgba(249,115,22,.2);color:#f97316;border:1px solid rgba(249,115,22,.4)}
.btype-poison{background:rgba(168,85,247,.2);color:#c084fc;border:1px solid rgba(168,85,247,.4)}
.btype-ground{background:rgba(161,98,7,.2);color:#ca8a04;border:1px solid rgba(161,98,7,.4)}
.btype-flying{background:rgba(129,140,248,.2);color:#818cf8;border:1px solid rgba(129,140,248,.4)}
.btype-psychic{background:rgba(236,72,153,.2);color:#ec4899;border:1px solid rgba(236,72,153,.4)}
.btype-bug{background:rgba(132,204,22,.2);color:#84cc16;border:1px solid rgba(132,204,22,.4)}
.btype-rock{background:rgba(168,162,158,.2);color:#a8a29e;border:1px solid rgba(168,162,158,.4)}
.btype-ghost{background:rgba(109,40,217,.2);color:#a78bfa;border:1px solid rgba(109,40,217,.4)}
.btype-dragon{background:rgba(59,130,246,.2);color:#60a5fa;border:1px solid rgba(59,130,246,.4)}
.btype-dark{background:rgba(68,64,60,.3);color:#a8a29e;border:1px solid rgba(68,64,60,.6)}
.btype-steel{background:rgba(148,163,184,.2);color:#94a3b8;border:1px solid rgba(148,163,184,.4)}
.btype-fairy{background:rgba(249,168,212,.2);color:#f9a8d4;border:1px solid rgba(249,168,212,.4)}
.btype-normal{background:rgba(212,212,216,.15);color:#d4d4d8;border:1px solid rgba(212,212,216,.3)}
/* HP Bar upgrade */
.hp-bar-wrap{margin:4px 0}
.hp-bar-label{display:flex;justify-content:space-between;align-items:center;margin-bottom:3px}
.hp-bar-label span:first-child{color:#64748b;font-size:11px}
.hp-bar-label .hp-num{font-family:'Press Start 2P',monospace;font-size:9px}
.hp-bar{height:7px;background:rgba(255,255,255,.06);border-radius:4px;overflow:hidden;border:1px solid #2a2a40}
.hp-fill{height:100%;border-radius:4px;transition:width .6s cubic-bezier(.4,0,.2,1),background .6s;position:relative}
.hp-fill::after{content:'';position:absolute;inset:0;
  background:linear-gradient(90deg,transparent 0%,rgba(255,255,255,.3)50%,transparent 100%);animation:shimmer 2s infinite}
@keyframes shimmer{0%{transform:translateX(-100%)}100%{transform:translateX(200%)}}
.hp-fill.high{background:linear-gradient(90deg,#15803d,#22c55e)}
.hp-fill.mid{background:linear-gradient(90deg,#854d0e,#eab308)}
.hp-fill.low{background:linear-gradient(90deg,#991b1b,#ef4444)}
.status-tag{
  display:inline-block;padding:2px 6px;border-radius:3px;
  font-family:'Press Start 2P',monospace;font-size:8px;font-weight:700;
  margin-right:4px;margin-top:4px;animation:spulse 2s infinite
}
@keyframes spulse{0%,100%{opacity:1}50%{opacity:.6}}
.status-brn{background:rgba(255,107,53,.2);color:#ff6b35;border:1px solid #ff6b35}
.status-par{background:rgba(251,191,36,.2);color:#fbbf24;border:1px solid #fbbf24}
.status-slp{background:rgba(99,102,241,.2);color:#818cf8;border:1px solid #818cf8}
.status-frz{background:rgba(165,243,252,.2);color:#67e8f9;border:1px solid #67e8f9}
.status-psn{background:rgba(168,85,247,.2);color:#c084fc;border:1px solid #c084fc}
.status-tox{background:rgba(168,85,247,.2);color:#c084fc;border:1px solid #c084fc}
.stat-change{font-size:9px;color:#64748b;margin-top:4px}
.ability-tag{font-size:10px;color:#64748b;margin-top:2px}
.item-tag{font-size:9px;color:#fbbf24;margin-top:2px}
/* Field status banner */
.field-status-wrap{position:relative;z-index:5;padding:0 12px;max-width:960px;margin:0 auto 6px;width:100%}
.field-status{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;min-height:0}
.field-chip{
  font-family:'Press Start 2P',monospace;font-size:7px;padding:3px 8px;border-radius:4px;
  border:1px solid;display:inline-flex;align-items:center;gap:4px;white-space:nowrap
}
.field-chip.weather{color:#38bdf8;border-color:#38bdf8;background:rgba(56,189,248,.08)}
.field-chip.sun{color:#fbbf24;border-color:#fbbf24;background:rgba(251,191,36,.08)}
.field-chip.sand{color:#ca8a04;border-color:#ca8a04;background:rgba(161,98,7,.08)}
.field-chip.hail{color:#a5f3fc;border-color:#a5f3fc;background:rgba(165,243,252,.08)}
.field-chip.trick{color:#c084fc;border-color:#c084fc;background:rgba(192,132,252,.08)}
.field-chip.wind{color:#22c55e;border-color:#22c55e;background:rgba(34,197,94,.08)}
.field-chip.trap{color:#f97316;border-color:#f97316;background:rgba(249,115,22,.08)}
.field-chip.screen{color:#60a5fa;border-color:#60a5fa;background:rgba(96,165,250,.08)}
/* Stat change display */
.stat-change{font-size:8px;color:#64748b;margin-top:4px;display:flex;gap:4px;flex-wrap:wrap}
.stat-up{color:#22c55e;font-size:7px;padding:1px 4px;border-radius:3px;background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.3)}
.stat-down{color:#ef4444;font-size:7px;padding:1px 4px;border-radius:3px;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3)}
/* Party mini */
.party-mini{display:flex;gap:5px;flex-wrap:wrap;margin-top:8px}
.mini-poke{
  width:32px;height:32px;border-radius:50%;background:#1a1a28;border:2px solid #2a2a40;
  display:flex;align-items:center;justify-content:center;overflow:hidden;
  position:relative;transition:all .3s
}
.mini-poke img{width:26px;height:26px;image-rendering:pixelated}
.mini-poke.active{border-color:#00e5ff;box-shadow:0 0 8px rgba(0,229,255,.4)}
.opponent-card .mini-poke.active{border-color:#ff6b35;box-shadow:0 0 8px rgba(255,107,53,.4)}
.mini-poke.fainted{opacity:.2;filter:grayscale(1)}
.mini-poke .mini-hp{position:absolute;bottom:0;left:0;right:0;height:3px;background:#1a1a28}
.mini-poke .mini-hp-fill{height:100%;background:#22c55e}
/* Actions */
.battle-actions{position:relative;z-index:5;padding:12px;max-width:960px;margin:0 auto;width:100%}
.action-panel{background:#12121a;border:1px solid #2a2a40;border-radius:12px;padding:14px;position:relative}
.panel-label{font-family:'Press Start 2P',monospace;font-size:8px;color:#64748b;letter-spacing:2px;margin-bottom:10px}
.action-tabs{display:flex;gap:6px;margin-bottom:10px}
.tab-btn{font-family:'Press Start 2P',monospace;font-size:9px;padding:6px 14px;border-radius:6px;
  border:1px solid #2a2a40;background:transparent;color:#64748b;cursor:pointer;transition:all .2s;letter-spacing:1px}
.tab-btn.active{background:rgba(0,229,255,.1);border-color:#00e5ff;color:#00e5ff}
.tab-btn:hover:not(.active){border-color:rgba(0,229,255,.4);color:var(--text)}
.move-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:0}
.move-btn{
  background:#1a1a28;border:1px solid #2a2a40;border-radius:8px;
  color:var(--text);padding:10px 12px;cursor:pointer;text-align:left;
  transition:all .2s;min-height:76px;display:flex;flex-direction:column;gap:3px;
  position:relative;overflow:hidden
}
.move-btn:hover:not(:disabled){border-color:currentColor;transform:translateY(-1px);box-shadow:0 4px 12px rgba(0,0,0,.3)}
.move-btn:active{transform:scale(.98)}
.move-btn:disabled{opacity:.3;cursor:not-allowed}
.mb-name{font-family:'Press Start 2P',monospace;font-size:9px;font-weight:700;color:var(--text);display:block;margin-bottom:4px}
.mb-meta{display:flex;justify-content:space-between;align-items:center;gap:4px;flex-wrap:wrap}
.mb-type{font-family:'Press Start 2P',monospace;font-size:7px;padding:2px 5px;border-radius:2px}
.mb-power{font-size:9px;color:#64748b}
.mb-acc{font-size:9px;color:#93c5fd}
.mb-effect{font-size:7px;color:#86efac;font-family:'Press Start 2P',monospace}
.mb-pp{font-size:8px;color:#64748b}
.mb-priority{font-size:8px;color:#fb923c}
.mb-eff{font-size:7px;font-family:'Press Start 2P',monospace;margin-left:auto}
.mb-eff-super{color:#22c55e} .mb-eff-not{color:#f97316} .mb-eff-immune{color:#ef4444}
.switch-grid{display:flex;flex-direction:column;gap:5px}
.switch-btn{
  background:#1a1a28;border:1px solid #2a2a40;border-radius:8px;
  color:var(--text);padding:7px 10px;cursor:pointer;text-align:left;
  transition:all .2s;display:flex;align-items:center;gap:8px
}
.switch-btn:hover:not(:disabled){border-color:#00e5ff;background:rgba(0,229,255,.05)}
.switch-btn:disabled{opacity:.3;cursor:not-allowed}
.switch-btn img{width:34px;height:34px;image-rendering:pixelated;flex-shrink:0}
.switch-info{flex:1}
.switch-name{font-family:'Press Start 2P',monospace;font-size:9px;margin-bottom:3px}
.switch-hp-track{height:4px;background:rgba(255,255,255,.1);border-radius:2px;overflow:hidden}
.switch-hp-fill{height:100%;border-radius:2px;transition:width .3s}
.switch-hp-text{font-size:10px;color:#64748b;white-space:nowrap}
/* AI thinking */
.ai-thinking{display:none;font-family:'Press Start 2P',monospace;font-size:9px;color:#ff6b35;
  text-align:center;padding:6px;animation:blink 1s infinite}
.ai-thinking.show{display:block}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.2}}
/* Battle log */
.battle-log-wrap{position:relative;z-index:5;padding:0 12px;max-width:960px;margin:0 auto 8px;width:100%}
.battle-log{
  background:#12121a;border:1px solid #2a2a40;border-radius:12px;
  padding:14px;min-height:70px;max-height:130px;overflow-y:auto;
  font-family:'Press Start 2P',monospace;font-size:9px;line-height:2.2
}
.log-label{font-family:'Press Start 2P',monospace;font-size:8px;color:#64748b;letter-spacing:2px;margin-bottom:6px}
.log-entry{padding:1px 0}
.log-entry.highlight{color:#00e5ff;animation:logIn .3s ease-out}
.log-entry.damage{color:#fbbf24}
.log-entry.heal{color:#4ade80}
.log-entry.status{color:#c4b5fd}
.log-entry.system{color:#64748b}
@keyframes logIn{from{opacity:0;transform:translateX(-6px)}to{opacity:1;transform:translateX(0)}}
/* Result overlay */
.result-overlay{
  position:fixed;inset:0;background:rgba(0,0,0,.85);backdrop-filter:blur(8px);z-index:500;
  display:none;align-items:center;justify-content:center;flex-direction:column;gap:20px;
  opacity:0;transition:opacity .5s
}
.result-overlay.show{display:flex;opacity:1}
.result-card{background:#12121a;border:2px solid #2a2a40;border-radius:16px;padding:36px;
  text-align:center;max-width:340px;width:90%;transform:scale(.8);transition:transform .5s cubic-bezier(.34,1.56,.64,1)}
.result-overlay.show .result-card{transform:scale(1)}
.result-icon{font-size:56px;margin-bottom:14px}
.result-title{font-family:'Press Start 2P',monospace;font-size:14px;margin-bottom:8px}
.result-title.win{color:#22c55e;text-shadow:0 0 20px rgba(34,197,94,.5)}
.result-title.lose{color:#ef4444;text-shadow:0 0 20px rgba(239,68,68,.5)}
.result-sub{font-size:11px;color:#64748b;margin-bottom:20px}
.result-btn{
  font-family:'Press Start 2P',monospace;font-size:8px;padding:10px 20px;border-radius:8px;
  border:2px solid #00e5ff;background:rgba(0,229,255,.1);color:#00e5ff;cursor:pointer;
  transition:all .2s;letter-spacing:1px
}
.result-btn:hover{background:rgba(0,229,255,.2);transform:scale(1.05)}
/* Volume control */
.vol-ctrl{display:flex;align-items:center;gap:6px}
.vol-ctrl input[type=range]{width:80px;accent-color:var(--accent)}
.vol-btn{background:none;border:none;color:var(--text);cursor:pointer;font-size:1.1rem}
/* Server badge in team select */
.status-bar .server-badge{
  padding:4px 10px;border-radius:20px;font-size:.72rem;font-weight:600;
  display:flex;align-items:center;gap:5px
}
.status-bar .server-badge.online{background:#052e16;color:#22c55e;border:1px solid #22c55e}
.status-bar .server-badge.offline{background:#2d1111;color:#ef4444;border:1px solid #ef4444}
.status-bar .server-badge.checking{background:#1a2535;color:var(--muted);border:1px solid var(--border)}
/* Custom dialog */
.custom-dialog-overlay{
  position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:9000;
  display:none;align-items:center;justify-content:center
}
.custom-dialog-overlay.show{display:flex}
.custom-dialog{
  background:#1a2535;border:2px solid var(--accent);border-radius:14px;
  padding:24px 32px;text-align:center;min-width:280px
}
.custom-dialog p{font-size:1rem;margin-bottom:20px;line-height:1.5}
.custom-dialog-btns{display:flex;gap:12px;justify-content:center}
.custom-dialog-btns button{
  padding:8px 24px;border-radius:8px;border:none;font-size:.9rem;
  font-weight:600;cursor:pointer;transition:all .2s
}
.btn-cancel{background:#1e2d40;color:var(--text)}
.btn-cancel:hover{background:#2a3f5a}
.btn-confirm{background:#ef4444;color:#fff}
.btn-confirm:hover{background:#dc2626}
/* ===== TITLE SCREEN ===== */
#titleScreen{
  position:fixed;inset:0;background:#0a0a0f;z-index:50;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  font-family:'Noto Sans KR',sans-serif
}
#titleScreen::before{content:'';position:fixed;inset:0;
  background-image:linear-gradient(rgba(0,229,255,0.03)1px,transparent 1px),linear-gradient(90deg,rgba(0,229,255,0.03)1px,transparent 1px);
  background-size:40px 40px;pointer-events:none}
.title-logo{font-family:'Press Start 2P',monospace;font-size:clamp(16px,4vw,28px);color:#00e5ff;
  text-shadow:0 0 30px rgba(0,229,255,.5),0 0 60px rgba(0,229,255,.2);letter-spacing:3px;
  margin-bottom:8px;position:relative;z-index:1;text-align:center}
.title-sub{font-family:'Press Start 2P',monospace;font-size:clamp(7px,1.5vw,10px);color:#64748b;
  letter-spacing:4px;text-transform:uppercase;margin-bottom:40px;position:relative;z-index:1}
.title-menu{display:flex;flex-direction:column;gap:12px;width:280px;position:relative;z-index:1}
.title-btn{
  font-family:'Press Start 2P',monospace;font-size:10px;padding:14px 20px;
  border-radius:10px;border:1px solid #2a2a40;background:#12121a;color:#e2e8f0;
  cursor:pointer;transition:all .3s;text-align:center;letter-spacing:2px;
  position:relative;overflow:hidden
}
.title-btn:hover{border-color:#00e5ff;color:#00e5ff;transform:translateY(-2px);
  box-shadow:0 0 20px rgba(0,229,255,.15)}
.title-btn.primary{border-color:#00e5ff;color:#00e5ff;background:rgba(0,229,255,.05)}
.title-btn.primary:hover{background:rgba(0,229,255,.12);box-shadow:0 0 30px rgba(0,229,255,.25)}
.title-btn.danger{border-color:#ef4444;color:#ef4444}
.title-btn.danger:hover{background:rgba(239,68,68,.08);box-shadow:0 0 20px rgba(239,68,68,.15)}
.title-btn .btn-icon{margin-right:8px}
.title-version{font-size:8px;color:#2a2a40;margin-top:30px;position:relative;z-index:1}
.title-sprite-deco{position:absolute;opacity:.08;image-rendering:pixelated;pointer-events:none}

/* ===== SETTINGS SCREEN ===== */
#settingsScreen{
  position:fixed;inset:0;background:#0a0a0f;z-index:50;
  display:none;flex-direction:column;align-items:center;overflow-y:auto;
  font-family:'Noto Sans KR',sans-serif
}
#settingsScreen.active{display:flex}
.settings-container{max-width:600px;width:100%;padding:30px 20px}
.settings-title{font-family:'Press Start 2P',monospace;font-size:14px;color:#00e5ff;
  text-align:center;margin-bottom:24px;letter-spacing:2px}
.settings-group{background:#12121a;border:1px solid #2a2a40;border-radius:12px;
  padding:16px;margin-bottom:14px}
.settings-group-title{font-family:'Press Start 2P',monospace;font-size:9px;color:#64748b;
  letter-spacing:2px;margin-bottom:12px}
.settings-row{display:flex;align-items:center;justify-content:space-between;padding:8px 0;
  border-bottom:1px solid #1a1a28}
.settings-row:last-child{border-bottom:none}
.settings-label{font-size:13px;color:#e2e8f0}
.settings-value{display:flex;align-items:center;gap:8px}
.settings-range{width:120px;accent-color:#00e5ff}
.settings-select{background:#1a1a28;border:1px solid #2a2a40;border-radius:6px;color:#e2e8f0;
  padding:4px 8px;font-size:12px}
.settings-toggle{width:44px;height:24px;border-radius:12px;background:#2a2a40;cursor:pointer;
  position:relative;transition:background .3s;border:none}
.settings-toggle.on{background:#00e5ff}
.settings-toggle::after{content:'';position:absolute;top:2px;left:2px;width:20px;height:20px;
  border-radius:50%;background:#fff;transition:left .3s}
.settings-toggle.on::after{left:22px}
.settings-back{font-family:'Press Start 2P',monospace;font-size:9px;padding:10px 24px;
  border-radius:8px;border:1px solid #2a2a40;background:#12121a;color:#64748b;
  cursor:pointer;margin-top:10px;transition:all .2s}
.settings-back:hover{border-color:#00e5ff;color:#00e5ff}

/* ===== MULTIPLAYER SCREEN ===== */
#multiScreen{
  position:fixed;inset:0;background:#0a0a0f;z-index:50;
  display:none;flex-direction:column;align-items:center;overflow-y:auto;
  font-family:'Noto Sans KR',sans-serif
}
#multiScreen.active{display:flex}
.multi-container{max-width:700px;width:100%;padding:20px}
.multi-title{font-family:'Press Start 2P',monospace;font-size:14px;color:#ff6b35;
  text-align:center;margin-bottom:20px;letter-spacing:2px}
.multi-section{display:flex;gap:14px;margin-bottom:14px}
.multi-panel{flex:1;background:#12121a;border:1px solid #2a2a40;border-radius:12px;padding:16px}
.multi-panel-title{font-family:'Press Start 2P',monospace;font-size:9px;color:#ff6b35;
  letter-spacing:2px;margin-bottom:12px}
.multi-input{width:100%;background:#1a1a28;border:1px solid #2a2a40;border-radius:6px;
  color:#e2e8f0;padding:8px 12px;font-size:13px;margin-bottom:8px;box-sizing:border-box}
.multi-input:focus{border-color:#ff6b35;outline:none}
.multi-input::placeholder{color:#3a3a55}
.multi-btn{font-family:'Press Start 2P',monospace;font-size:8px;padding:10px 16px;
  border-radius:8px;border:1px solid #ff6b35;background:rgba(255,107,53,.08);color:#ff6b35;
  cursor:pointer;transition:all .2s;width:100%;letter-spacing:1px}
.multi-btn:hover{background:rgba(255,107,53,.15);transform:translateY(-1px)}
.multi-btn:disabled{opacity:.3;cursor:not-allowed}
.multi-btn.secondary{border-color:#2a2a40;color:#64748b;background:transparent}
.multi-btn.secondary:hover{border-color:#64748b;color:#e2e8f0}
.multi-room-list{max-height:300px;overflow-y:auto}
.multi-room-item{display:flex;align-items:center;justify-content:space-between;
  padding:10px 12px;border:1px solid #2a2a40;border-radius:8px;margin-bottom:6px;
  background:#1a1a28;cursor:pointer;transition:all .2s}
.multi-room-item:hover{border-color:#ff6b35;background:rgba(255,107,53,.03)}
.room-name{font-family:'Press Start 2P',monospace;font-size:8px;color:#e2e8f0}
.room-info{font-size:10px;color:#64748b}
.room-badge{font-family:'Press Start 2P',monospace;font-size:7px;padding:2px 6px;
  border-radius:4px;border:1px solid}
.room-badge.open{color:#22c55e;border-color:#22c55e;background:rgba(34,197,94,.08)}
.room-badge.locked{color:#fbbf24;border-color:#fbbf24;background:rgba(251,191,36,.08)}
.room-badge.full{color:#ef4444;border-color:#ef4444;background:rgba(239,68,68,.08)}
.multi-status{font-family:'Press Start 2P',monospace;font-size:8px;color:#64748b;
  text-align:center;padding:12px}
.multi-row{display:flex;gap:8px;align-items:center;margin-bottom:8px}
.multi-radio{display:flex;gap:6px}
.multi-radio label{font-size:11px;color:#e2e8f0;display:flex;align-items:center;gap:4px;cursor:pointer}
.multi-radio input{accent-color:#ff6b35}
.multi-back{font-family:'Press Start 2P',monospace;font-size:9px;padding:10px 24px;
  border-radius:8px;border:1px solid #2a2a40;background:#12121a;color:#64748b;
  cursor:pointer;margin-top:10px;transition:all .2s}
.multi-back:hover{border-color:#ff6b35;color:#ff6b35}

/* Scrollbar */
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-track{background:#1a2535}
::-webkit-scrollbar-thumb{background:#2a3f5a;border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:var(--accent)}
</style>
</head>
<body>

<!-- ===== CLICK TO START (browser audio unlock) ===== -->
<div id="clickToStart" style="position:fixed;inset:0;background:#0a0a0f;z-index:100;
  display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer"
  onclick="unlockAudioAndStart()">
  <div style="font-family:'Press Start 2P',monospace;font-size:clamp(16px,4vw,28px);color:#00e5ff;
    text-shadow:0 0 30px rgba(0,229,255,.5);letter-spacing:3px;margin-bottom:20px;text-align:center">
    ⚡ POKÉMON BATTLE ⚡
  </div>
  <div style="font-family:'Press Start 2P',monospace;font-size:clamp(8px,1.5vw,12px);color:#64748b;
    letter-spacing:3px;animation:blink 1.5s infinite;text-align:center">
    CLICK TO START
  </div>
</div>

<!-- ===== TITLE SCREEN ===== -->
<div id="titleScreen" style="display:none">
  <div class="title-logo">⚡ POKÉMON BATTLE ⚡</div>
  <div class="title-sub">PPO AI TRAINER</div>
  <div class="title-menu">
    <button class="title-btn primary" onclick="goSinglePlay()">
      <span class="btn-icon">🎮</span> SINGLE PLAY
    </button>
    <button class="title-btn" onclick="goMultiplayer()">
      <span class="btn-icon">🌐</span> MULTIPLAYER
    </button>
    <button class="title-btn" onclick="goSettings()">
      <span class="btn-icon">⚙️</span> SETTINGS
    </button>
    <button class="title-btn danger" onclick="goQuit()">
      <span class="btn-icon">🚪</span> EXIT
    </button>
  </div>
  <div class="title-version">v3.0 | PPO Reinforcement Learning</div>
</div>

<!-- ===== SETTINGS SCREEN ===== -->
<div id="settingsScreen">
  <div class="settings-container">
    <div class="settings-title">⚙️ SETTINGS</div>
    
    <div class="settings-group">
      <div class="settings-group-title">🔊 SOUND</div>
      <div class="settings-row">
        <span class="settings-label">BGM 볼륨</span>
        <div class="settings-value">
          <input type="range" class="settings-range" min="0" max="1" step="0.05" value="0.5" id="settingsBgmVol" oninput="setVolume(this.value);document.getElementById('bgmVolText').textContent=Math.round(this.value*100)+'%'">
          <span style="font-size:11px;color:#64748b;width:35px" id="bgmVolText">50%</span>
        </div>
      </div>
      <div class="settings-row">
        <span class="settings-label">BGM 음소거</span>
        <button class="settings-toggle" id="settingsMuteToggle" onclick="toggleSettingsMute()"></button>
      </div>
    </div>
    
    <div class="settings-group">
      <div class="settings-group-title">🎨 DISPLAY</div>
      <div class="settings-row">
        <span class="settings-label">배틀 애니메이션</span>
        <button class="settings-toggle on" id="settingsAnimToggle" onclick="toggleSettingsAnim()"></button>
      </div>
      <div class="settings-row">
        <span class="settings-label">배틀 속도</span>
        <div class="settings-value">
          <select class="settings-select" id="settingsBattleSpeed" onchange="gameSettings.battleSpeed=Number(this.value);saveSettings()">
            <option value="1">보통</option>
            <option value="0.5">빠르게</option>
            <option value="2">느리게</option>
          </select>
        </div>
      </div>
    </div>
    
    <div class="settings-group">
      <div class="settings-group-title">🎮 GAMEPLAY</div>
      <div class="settings-row">
        <span class="settings-label">타입 상성 힌트</span>
        <button class="settings-toggle on" id="settingsHintToggle" onclick="toggleSettingsHint()"></button>
      </div>
      <div class="settings-row">
        <span class="settings-label">닉네임</span>
        <input type="text" class="multi-input" style="width:160px;margin:0" id="settingsNickname" placeholder="트레이너" maxlength="12" value="트레이너">
      </div>
    </div>
    
    <div style="text-align:center">
      <button class="settings-back" onclick="goTitleFromSettings()">◀ BACK</button>
    </div>
  </div>
</div>

<!-- ===== MULTIPLAYER SCREEN ===== -->
<div id="multiScreen">
  <div class="multi-container">
    <div class="multi-title">🌐 MULTIPLAYER</div>
    
    <div class="multi-section">
      <!-- LEFT: 방 만들기 -->
      <div class="multi-panel">
        <div class="multi-panel-title">🏠 방 만들기</div>
        <input class="multi-input" id="multiRoomTitle" placeholder="방 제목" maxlength="20">
        <div class="multi-row">
          <span style="font-size:12px;color:#64748b">공개</span>
          <div class="multi-radio">
            <label><input type="radio" name="roomVisibility" value="public" checked> 공개</label>
            <label><input type="radio" name="roomVisibility" value="private"> 비공개</label>
          </div>
        </div>
        <input class="multi-input" id="multiRoomPw" placeholder="비밀번호 (비공개 시)" type="password" maxlength="10">
        <div class="multi-row">
          <span style="font-size:12px;color:#64748b">배틀 형식</span>
          <div class="multi-radio">
            <label><input type="radio" name="battleFormat" value="single" checked> 싱글</label>
            <label><input type="radio" name="battleFormat" value="double"> 더블</label>
          </div>
        </div>
        <button class="multi-btn" id="createRoomBtn" onclick="onCreateRoom()">🚀 방 만들기</button>
        <!-- URL 공유 박스 (방 생성 후 표시) -->
        <div id="ngrokUrlBox" style="display:none;margin-top:10px;padding:10px;background:#0d1f14;border:1px solid #22c55e;border-radius:8px">
          <div style="font-size:10px;color:#22c55e;margin-bottom:4px">✅ 친구에게 이 주소를 공유하세요:</div>
          <div style="display:flex;gap:6px;align-items:center">
            <input class="multi-input" id="ngrokUrl" readonly style="margin:0;font-size:11px;color:#22c55e;background:#0a1a10;border-color:#22c55e">
            <button class="multi-btn" onclick="copyNgrokUrl()" style="width:auto;padding:8px 10px;border-color:#22c55e;color:#22c55e;font-size:7px">📋</button>
          </div>
        </div>
      </div>
      
      <!-- RIGHT: 방 참가 -->
      <div class="multi-panel">
        <div class="multi-panel-title">🔍 방 참가</div>
        <div style="display:flex;gap:6px;margin-bottom:8px">
          <input class="multi-input" id="multiServerAddr" placeholder="친구에게 받은 주소 입력..." style="margin:0;flex:1;font-size:11px">
          <button class="multi-btn" style="width:auto;padding:8px 12px" onclick="guestConnect()">접속</button>
        </div>
        <div class="multi-status" id="guestConnStatus" style="min-height:20px"></div>
        <div style="display:flex;gap:6px;margin-bottom:6px">
          <input class="multi-input" id="multiSearchRoom" placeholder="방 검색..." oninput="filterRooms()" style="margin:0;flex:1">
          <button class="multi-btn secondary" onclick="refreshRooms()" style="width:auto;padding:8px 10px;font-size:7px">🔄</button>
        </div>
        <div class="multi-room-list" id="multiRoomList">
          <div class="multi-status">주소를 입력하고 접속하세요</div>
        </div>
      </div>
    </div>
    
    <!-- 상태 표시 -->
    <div class="multi-panel" style="margin-top:14px" id="multiStatusPanel">
      <div class="multi-panel-title">📊 상태</div>
      <div class="multi-status" id="multiMainStatus">방을 만들거나 친구 방에 참가하세요.</div>
    </div>
    
    <div style="text-align:center;margin-top:14px">
      <button class="multi-back" onclick="goTitleFromMulti()">◀ BACK</button>
    </div>
  </div>
</div>

<!-- ===== TEAM SELECT SCREEN ===== -->
<div id="teamSelectScreen" style="display:none">
  <div class="ts-header">
    <button onclick="goBackToTitle()" style="position:absolute;left:16px;top:16px;background:none;border:1px solid #2a2a40;
      color:#64748b;padding:6px 14px;border-radius:8px;cursor:pointer;font-family:'Press Start 2P',monospace;
      font-size:8px;transition:all .2s;z-index:10" 
      onmouseover="this.style.borderColor='#00e5ff';this.style.color='#00e5ff'"
      onmouseout="this.style.borderColor='#2a2a40';this.style.color='#64748b'">◀ BACK</button>
    <h1>⚔️ 포켓몬 배틀 AI</h1>
    <p>3마리를 선택하고 배틀 시작!</p>
  </div>

  <!-- Status bar (top right) -->
  <div class="status-bar">
    <div id="teamServerBadge" class="server-badge checking" style="font-size:.7rem">● 연결 확인 중...</div>
    <div class="vol-ctrl">
      <button class="vol-btn" onclick="toggleMute()" id="muteBtn">🔊</button>
      <input type="range" min="0" max="1" step="0.05" value="0.5" oninput="setVolume(this.value)">
    </div>
  </div>

  <!-- Party slots -->
  <div class="party-bar">
    <span style="font-size:.85rem;color:var(--muted);margin-right:4px">내 파티:</span>
    <div class="slot-card" id="slot0" onclick="slotClick(0)"><span>1번 슬롯</span></div>
    <div class="slot-card" id="slot1" onclick="slotClick(1)"><span>2번 슬롯</span></div>
    <div class="slot-card" id="slot2" onclick="slotClick(2)"><span>3번 슬롯</span></div>
    <button class="start-btn" id="startBattleBtn" disabled onclick="startBattle()">▶ 배틀 시작!</button>
  </div>

  <!-- Preset bar -->
  <div class="preset-bar">
    <label>💾 프리셋</label>
    <input type="text" id="presetNameInput" placeholder="프리셋 이름 입력..." maxlength="30">
    <button class="preset-btn" onclick="savePreset()">저장</button>
    <div class="cdd-wrap" id="presetCddWrap">
      <button class="cdd-btn" id="presetBtn" onclick="toggleCdd('presetList')">프리셋 선택</button>
      <div class="cdd-list" id="presetList"></div>
    </div>
    <button class="preset-btn danger" onclick="deletePreset()">삭제</button>
    <label style="margin-left:8px">🏆 추천</label>
    <div class="cdd-wrap" id="recoCddWrap">
      <button class="cdd-btn" id="recoBtn" onclick="toggleCdd('recoList')">추천 엔트리 선택</button>
      <div class="cdd-list" id="recoList"></div>
    </div>
    <button class="preset-btn" onclick="applyRecommended()">적용</button>
  </div>

  <!-- Search + Gen filter (one row) -->
  <div class="search-gen-row">
    <div class="search-wrap">
      <input type="text" id="searchInput" placeholder="포켓몬 이름 검색..." oninput="renderGrid()">
    </div>
    <div class="gen-filter" id="genFilter">
      <button class="gen-btn active" data-gen="all" onclick="filterGen('all',this)">전체</button>
      <button class="gen-btn" data-gen="1" onclick="filterGen('1',this)">1세대</button>
      <button class="gen-btn" data-gen="2" onclick="filterGen('2',this)">2세대</button>
      <button class="gen-btn" data-gen="3" onclick="filterGen('3',this)">3세대</button>
      <button class="gen-btn" data-gen="4" onclick="filterGen('4',this)">4세대</button>
      <button class="gen-btn" data-gen="5" onclick="filterGen('5',this)">5세대</button>
      <button class="gen-btn" data-gen="6" onclick="filterGen('6',this)">6세대</button>
      <button class="gen-btn" data-gen="7" onclick="filterGen('7',this)">7세대</button>
      <button class="gen-btn" data-gen="8" onclick="filterGen('8',this)">8세대</button>
      <button class="gen-btn" data-gen="9" onclick="filterGen('9',this)">9세대</button>
    </div>
  </div>

  <!-- Pokemon grid -->
  <div class="poke-grid" id="pokeGrid"></div>
</div>

<!-- ===== BATTLE SCREEN ===== -->
<div id="battleScreen">
  <div class="battle-header">
    <h2>⚡ POKÉMON BATTLE ⚡</h2>
    <div class="battle-header-row">
      <div id="serverBadge" class="server-badge checking"><span class="dot"></span> 연결 확인 중...</div>
      <div class="battle-vol">
        <button class="vol-btn" onclick="toggleMute()" id="battleMuteBtn">🔊</button>
        <input type="range" min="0" max="1" step="0.05" value="0.5" oninput="setVolume(this.value)">
      </div>
    </div>
    <div class="turn-badge" id="turnBadge">TURN 1</div>
  </div>

  <div class="battle-field" id="battleField">
    <!-- Player (left) -->
    <div class="pokemon-card-battle player-side" id="playerCard">
      <div class="battle-card-label">🧢 PLAYER</div>
      <div class="poke-battle-header">
        <div class="poke-sprite-wrap">
          <img id="playerSprite" src="" alt="">
        </div>
        <div class="poke-battle-info">
          <div><span class="poke-battle-name" id="playerName">-</span><span class="poke-battle-level" id="playerLevel">Lv.50</span></div>
          <div class="poke-battle-types" id="playerTypes"></div>
          <div class="hp-bar-wrap">
            <div class="hp-bar-label"><span>HP</span><span class="hp-num" id="playerHpNum">-/-</span></div>
            <div class="hp-bar"><div class="hp-fill high" id="playerHpFill"></div></div>
          </div>
          <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
            <span id="playerStatus"></span>
            <span class="ability-tag" id="playerAbilityTag"></span>
            <span class="item-tag" id="playerItemTag"></span>
          </div>
        </div>
      </div>
      <div id="playerStatChange" class="stat-change"></div>
      <div class="party-mini" id="playerPartyMini"></div>
    </div>
    <!-- AI (right) -->
    <div class="pokemon-card-battle opponent-card" id="aiCard">
      <div class="battle-card-label">⚔ AI TRAINER</div>
      <div class="poke-battle-header">
        <div class="poke-sprite-wrap">
          <img id="aiSprite" src="" alt="" style="transform:scaleX(-1)">
        </div>
        <div class="poke-battle-info">
          <div><span class="poke-battle-name" id="aiName">-</span><span class="poke-battle-level" id="aiLevel">Lv.50</span></div>
          <div class="poke-battle-types" id="aiTypes"></div>
          <div class="hp-bar-wrap">
            <div class="hp-bar-label"><span>HP</span><span class="hp-num" id="aiHpNum">-/-</span></div>
            <div class="hp-bar"><div class="hp-fill high" id="aiHpFill"></div></div>
          </div>
          <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
            <span id="aiStatus"></span>
            <span class="ability-tag" id="aiAbilityTag"></span>
          </div>
        </div>
      </div>
      <div id="aiStatChange" class="stat-change"></div>
      <div class="party-mini" id="aiPartyMini"></div>
    </div>
  </div>

  <!-- Field Status Banner -->
  <div class="field-status-wrap">
    <div class="field-status" id="fieldStatus"></div>
  </div>

  <!-- Battle log -->
  <div class="battle-log-wrap">
    <div class="battle-log" id="battleLog">
      <div class="log-label">▸ BATTLE LOG</div>
    </div>
  </div>
  <div class="ai-thinking" id="aiThinking">🤖 AI가 수읽는 중...</div>

  <!-- Actions -->
  <div class="battle-actions">
    <div class="action-panel">
      <div class="panel-label">▸ ACTION</div>
      <div class="action-tabs">
        <button class="tab-btn active" id="tabFight" onclick="switchBattleTab('fight')">FIGHT</button>
        <button class="tab-btn" id="tabSwitch" onclick="switchBattleTab('switch')">POKÉMON</button>
      </div>
      <div id="moveSection">
        <div class="move-grid" id="moveGrid"></div>
      </div>
      <div id="switchSection" style="display:none">
        <p style="font-family:'Press Start 2P',monospace;font-size:7px;color:#64748b;margin-bottom:8px" id="switchReason">교체할 포켓몬을 선택하세요</p>
        <div class="switch-grid" id="switchGrid"></div>
      </div>
    </div>
  </div>
</div>

<!-- ===== BUILD MODAL ===== -->
<div class="modal-overlay" id="modalOverlay">
  <div class="move-modal" id="moveModal">
    <div class="modal-title" id="modalTitle">포켓몬 설정</div>

    <!-- Ability -->
    <div class="modal-row">
      <label>특성</label>
      <div class="cdd-wrap" id="abilityCddWrap">
        <button class="cdd-btn" id="abilityBtn" onclick="toggleCdd('abilityList')">특성 선택</button>
        <div class="cdd-list" id="abilityList"></div>
      </div>
    </div>
    <div class="ability-desc" id="abilityDesc">특성을 선택하면 설명이 표시됩니다.</div>

    <!-- Nature -->
    <div class="modal-row">
      <label>성격</label>
      <div class="cdd-wrap" id="natureCddWrap">
        <button class="cdd-btn" id="natureBtn" onclick="toggleCdd('natureList')">성격 선택</button>
        <div class="cdd-list" id="natureList"></div>
      </div>
    </div>

    <!-- Item -->
    <div class="modal-row">
      <label>도구</label>
      <div class="cdd-wrap" id="itemCddWrap">
        <button class="cdd-btn" id="itemBtn" onclick="toggleCdd('itemList')">도구 선택</button>
        <div class="cdd-list" id="itemList"></div>
      </div>
    </div>

    <!-- EVs -->
    <p style="font-size:.75rem;color:var(--muted);margin-bottom:6px">노력치 (총합 508 이하, 각 252 이하)</p>
    <div class="ev-grid">
      <div class="ev-item"><label>HP</label><input type="number" id="evHp" min="0" max="252" value="0" oninput="clampEv(this,'hp')"></div>
      <div class="ev-item"><label>공격</label><input type="number" id="evAtk" min="0" max="252" value="0" oninput="clampEv(this,'atk')"></div>
      <div class="ev-item"><label>방어</label><input type="number" id="evDef" min="0" max="252" value="0" oninput="clampEv(this,'def')"></div>
      <div class="ev-item"><label>특공</label><input type="number" id="evSpAtk" min="0" max="252" value="0" oninput="clampEv(this,'spatk')"></div>
      <div class="ev-item"><label>특방</label><input type="number" id="evSpDef" min="0" max="252" value="0" oninput="clampEv(this,'spdef')"></div>
      <div class="ev-item"><label>스피드</label><input type="number" id="evSpd" min="0" max="252" value="0" oninput="clampEv(this,'spd')"></div>
    </div>
    <div class="ev-total" id="evTotal">노력치 총합: 0 / 508</div>

    <!-- Move pool -->
    <p style="font-size:.75rem;color:var(--muted);margin-bottom:6px">기술 선택 (1~4개)</p>
    <div id="selectedMovesDisplay" class="selected-moves"></div>
    <div class="move-pool" id="movePool"></div>

    <button class="modal-confirm" id="modalConfirmBtn" onclick="confirmModal()">확인</button>
  </div>
</div>

<!-- ===== RESULT OVERLAY ===== -->
<div class="result-overlay" id="resultOverlay">
  <div class="result-card">
    <div class="result-icon" id="resultIcon">🏆</div>
    <div class="result-title" id="resultTitle">VICTORY!</div>
    <p class="result-sub" id="resultMsg"></p>
    <button class="result-btn" onclick="goTeamSelect()">▶ BATTLE AGAIN</button>
  </div>
</div>

<!-- ===== CUSTOM DIALOG ===== -->
<div class="custom-dialog-overlay" id="customDialog">
  <div class="custom-dialog">
    <p id="dialogMsg">게임을 종료하시겠습니까?</p>
    <div class="custom-dialog-btns">
      <button class="btn-cancel" onclick="closeDialog()">계속 플레이</button>
      <button class="btn-confirm" onclick="confirmQuit()">종료</button>
    </div>
  </div>
</div>

<!-- ===== BGM ===== -->
<audio id="bgmMain" loop preload="auto" autoplay></audio>
<audio id="bgmBattle" loop preload="auto"></audio>
<audio id="bgmWin" preload="auto"></audio>
<audio id="bgmLose" preload="auto"></audio>

