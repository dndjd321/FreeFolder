   allMoves:[{name:"울음소리",type:"normal",cat:"status",power:0,acc:100,pp:40,maxPp:40,nameEn:"growl",effect:"atk_down1",effectChance:0,learnMethod:"level-up"},{name:"몸통박치기",type:"normal",cat:"physical",power:40,acc:100,pp:35,maxPp:35,nameEn:"tackle",learnMethod:"level-up"},{name:"덩굴채찍",type:"grass",cat:"physical",power:45,acc:100,pp:25,maxPp:25,nameEn:"vine-whip",learnMethod:"level-up"},{name:"성장",type:"normal",cat:"status",power:0,acc:0,pp:20,maxPp:20,nameEn:"growth",effect:"atk_up1",effectChance:0,learnMethod:"level-up"},{name:"씨뿌리기",type:"grass",cat:"status",power:0,acc:90,pp:10,maxPp:10,nameEn:"leech-seed",effect:"leech_seed",effectChance:0,learnMethod:"level-up"},{name:"잎날가르기",type:"grass",cat:"physical",power:55,acc:95,pp:25,maxPp:25,nameEn:"razor-leaf",learnMethod:"level-up"},{name:"독가루",type:"poison",cat:"status",power:0,acc:75,pp:35,maxPp:35,nameEn:"poison-powder",effect:"poison",effectChance:0,learnMethod:"level-up"},{name:"수면가루",type:"grass",cat:"status",power:0,acc:75,pp:15,maxPp:15,nameEn:"sleep-powder",effect:"sleep",effectChance:0,learnMethod:"level-up"},{name:"돌진",type:"normal",cat:"physical",power:90,acc:85,pp:20,maxPp:20,nameEn:"take-down",learnMethod:"level-up"},{name:"씨폭탄",type:"grass",cat:"physical",power:80,acc:100,pp:15,maxPp:15,nameEn:"seed-bomb",learnMethod:"level-up"},{name:"달콤한향기",type:"normal",cat:"status",power:0,acc:100,pp:20,maxPp:20,nameEn:"sweet-scent",effect:"eva_down2",effectChance:0,learnMethod:"level-up"},{name:"이판사판태클",type:"normal",cat:"physical",power:120,acc:100,pp:15,maxPp:15,nameEn:"double-edge",learnMethod:"level-up"},{name:"광합성",type:"grass",cat:"status",power:0,acc:0,pp:5,maxPp:5,nameEn:"synthesis",learnMethod:"level-up"},{name:"고민씨",type:"grass",cat:"status",power:0,acc:100,pp:10,maxPp:10,nameEn:"worry-seed",learnMethod:"level-up"},{name:"파워휩",type:"grass",cat:"physical",power:120,acc:85,pp:10,maxPp:10,nameEn:"power-whip",learnMethod:"egg"},{name:"솔라빔",type:"grass",cat:"special",power:120,acc:100,pp:10,maxPp:10,nameEn:"so